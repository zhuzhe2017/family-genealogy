# app title
VITE_APP_TITLE=家族谱系管理后台

# app description
VITE_APP_DESC=数字家谱管理系统

# backend service base url, prod environment
# 使用相对路径，由 Nginx 反代到后端服务
VITE_SERVICE_BASE_URL=/api

# other backend service base url, prod environment
VITE_OTHER_SERVICE_BASE_URL=`{"demo":"http://localhost:9529"}`

# backend service success code
VITE_SERVICE_SUCCESS_CODE=0000

# backend service logout codes (use "," to separate)
VITE_SERVICE_LOGOUT_CODES=11001

# backend service modal logout codes (use "," to separate)
VITE_SERVICE_MODAL_LOGOUT_CODES=11002

# backend service expired token codes (use "," to separate)
# 后端统一以 HTTP 401 + body.code='401' 返回登录态失效,据此触发 refreshToken 刷新
VITE_SERVICE_EXPIRED_TOKEN_CODES=401

# home route key (static route mode)
VITE_ROUTE_HOME=home

# default menu icon
VITE_MENU_ICON=mdi:menu

# icon prefix
VITE_ICON_PREFIX=icon

# local icon prefix
VITE_ICON_LOCAL_PREFIX=icon-local

# source map
VITE_SOURCE_MAP=N

# auth route mode
VITE_AUTH_ROUTE_MODE=static

# static super role
VITE_STATIC_SUPER_ROLE=super
