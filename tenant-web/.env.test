# app title
VITE_APP_TITLE=家族谱系管理后台

# app description
VITE_APP_DESC=数字家谱管理系统

# backend service success code
VITE_SERVICE_SUCCESS_CODE=0000

# backend service expired token codes (use "," to separate)
# 后端统一以 HTTP 401 + body.code='401' 返回登录态失效,据此触发 refreshToken 刷新
VITE_SERVICE_EXPIRED_TOKEN_CODES=401

# home route key (static route mode)
VITE_ROUTE_HOME=home

# default menu icon
VITE_MENU_ICON=mdi:menu

# vite port
VITE_PORT=9527

# vite open
VITE_OPEN=true

# base url
VITE_BASE_URL=/

# backend service base url, test environment
VITE_SERVICE_BASE_URL=http://localhost:3000/api

# other backend service base url, test environment
VITE_OTHER_SERVICE_BASE_URL=`{"demo":"http://localhost:9528"}`

# http proxy
VITE_HTTP_PROXY=Y

# proxy log
VITE_PROXY_LOG=N

# source map
VITE_SOURCE_MAP=N

# icon prefix
VITE_ICON_PREFIX=icon

# local icon prefix
VITE_ICON_LOCAL_PREFIX=icon-local

# auth route mode: static-静态路由 dynamic-动态路由
VITE_AUTH_ROUTE_MODE=static

# static super role
VITE_STATIC_SUPER_ROLE=super

# devtools launch editor
VITE_DEVTOOLS_LAUNCH_EDITOR=code
