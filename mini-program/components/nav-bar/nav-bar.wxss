/* 仅负责导航栏外观;position/sticky 由使用方(页面)通过宿主节点 class 控制 */
.nav-bar {
  display: flex;
  align-items: center;
  width: 100%;
  background: linear-gradient(135deg, #8B1A1A, #6B0F0F);
  box-sizing: border-box;
}

.nav-back {
  width: 88rpx;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-back-arrow {
  font-size: 48rpx;
  color: #FFFFFF;
  line-height: 1;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  white-space: nowrap;
}

.nav-placeholder {
  width: 88rpx;
  flex-shrink: 0;
}