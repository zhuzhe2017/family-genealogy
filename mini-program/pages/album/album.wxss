.page-container {
  padding-bottom: 140rpx;
  background: #F7F7F8;
  min-height: 100vh;
}

/* ---------------- 相册分类 ---------------- */
.album-categories {
  background: #FFFFFF;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.categories-wrapper {
  display: flex;
  gap: 20rpx;
  padding: 0 24rpx;
  white-space: nowrap;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  border-radius: 20rpx;
  min-width: 140rpx;
  background: #F8F8F8;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.category-item.active {
  background: rgba(139, 26, 26, 0.05);
  border-color: #8B1A1A;
}

.category-cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.category-cover text {
  font-size: 36rpx;
}

.category-name {
  font-size: 24rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.category-count {
  font-size: 20rpx;
  color: #999;
}

/* ---------------- 影像瀑布流 ---------------- */
.waterfall-section {
  padding: 24rpx 12px 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.section-count {
  font-size: 24rpx;
  color: #999;
}

/* 双列/多列瀑布流容器(列数由 JS 按屏幕宽度计算) */
.waterfall {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}

.wf-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

/* 单个影像:高度由真实比例计算(内联 style),宽度占满所在列 */
.wf-item {
  position: relative;
  width: 100%;
  border-radius: 12rpx;
  overflow: hidden;
  background: #F0F0F0;
  animation: wfItemIn 0.45s ease-out both;
}

/* 未加载完成时显示流光占位 */
.wf-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  background: linear-gradient(90deg, #f2f2f2 25%, #e7e7e7 50%, #f2f2f2 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s linear infinite;
}

.wf-item.is-loaded::before {
  display: none;
}

.wf-img {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0;
  transition: opacity 0.5s ease;
  will-change: opacity;
}

.wf-img.loaded {
  opacity: 1;
}

/* 底部标题/年份遮罩 */
.wf-meta {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  padding: 32rpx 16rpx 12rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.wf-item.is-loaded .wf-meta {
  opacity: 1;
}

.wf-title {
  font-size: 22rpx;
  color: #FFFFFF;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wf-year {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.92);
  flex-shrink: 0;
}

/* ---------------- 骨架屏 ---------------- */
.wf-skeleton {
  display: flex;
  gap: 8px;
}

.wf-skeleton-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.wf-skeleton-item {
  width: 100%;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f2f2f2 25%, #e7e7e7 50%, #f2f2f2 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s linear infinite;
}

/* ---------------- 空态 / 底部提示 ---------------- */
.wf-empty {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
}

.wf-empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.wf-empty-text {
  font-size: 26rpx;
}

.wf-footer {
  padding: 32rpx 0 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.wf-footer-loading {
  display: inline-block;
  animation: footerPulse 1.2s ease-in-out infinite;
}

/* ---------------- 动画 ---------------- */
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

@keyframes wfItemIn {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes footerPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* ---------------- 浮动按钮 ---------------- */
.fab-add {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 300;
  box-shadow: 0 8rpx 24rpx rgba(139, 26, 26, 0.3);
  z-index: 100;
}

.fab-add:active {
  transform: scale(0.92);
}
