/* pages/tools/tools.wxss — 识典古籍古典风格（v1.1） */

page { background: var(--paper); height: 100%; }

.tools-wrap {
  min-height: 100vh;
  padding: 24rpx 28rpx 80rpx;
}

/* 搜索 */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--paper-2);
  border: 1rpx solid var(--line);
  border-radius: 40rpx;
  padding: 20rpx 32rpx;
  gap: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(44, 24, 16, 0.05);
  margin-bottom: 32rpx;
}
.search-icon { font-size: 30rpx; color: var(--seal); }
.search-placeholder {
  color: var(--ink-soft);
  font-family: var(--font-song);
  font-size: 28rpx;
}

/* 网格 */
.grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tool-card {
  --card-color: var(--seal);
  background: var(--paper-2);
  border-radius: 16rpx;
  padding: 28rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(44, 24, 16, 0.05);
  border-left: 8rpx solid var(--card-color);
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
  border-right: 1rpx solid var(--line);
  position: relative;
  overflow: hidden;
}
/* 四角印章装饰 */
.tool-card::before {
  content: '';
  position: absolute;
  top: 12rpx; right: 12rpx;
  width: 24rpx; height: 24rpx;
  border-top: 2rpx solid var(--card-color);
  border-right: 2rpx solid var(--card-color);
  opacity: 0.4;
}
.tool-card:active { opacity: 0.85; }

.card-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: rgba(139, 26, 26, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 2rpx solid rgba(139, 26, 26, 0.2);
}
.icon-emoji { font-size: 52rpx; }

.card-body { flex: 1; }
.card-label {
  font-family: var(--font-kai);
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 2rpx;
}
.card-stat {
  font-family: var(--font-song);
  font-size: 24rpx;
  color: var(--card-color);
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}
.card-hint {
  font-family: var(--font-song);
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-top: 8rpx;
  opacity: 0.8;
}

.card-arrow {
  font-size: 48rpx;
  color: var(--ink-soft);
  font-weight: 300;
}

.footer-tip {
  text-align: center;
  font-family: var(--font-kai);
  font-size: 24rpx;
  color: var(--ink-soft);
  opacity: 0.6;
  margin-top: 60rpx;
  padding: 0 40rpx;
  letter-spacing: 4rpx;
}

/* ============ Level 2 AI 助手悬浮按钮（识典风格） ============ */
.ai-fab {
  position: fixed;
  right: 28rpx;
  bottom: 160rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 20rpx;
  background: var(--seal);
  box-shadow: 0 8rpx 28rpx rgba(139, 26, 26, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  border: 3rpx solid var(--gold);
}
.ai-fab:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 14rpx rgba(139, 26, 26, 0.35);
}
.ai-fab-seal {
  font-family: var(--font-kai);
  font-size: 52rpx;
  color: #fff;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1;
}
.ai-fab-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 10rpx;
  background: var(--gold);
  color: var(--ink);
  font-family: var(--font-kai);
  font-size: 18rpx;
  font-weight: 700;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--seal);
}
