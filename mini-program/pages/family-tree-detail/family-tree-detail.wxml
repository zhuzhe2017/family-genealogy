<wxs src="../../utils/filters.wxs" module="f" />
<view class="page-container">
  <!-- 自定义导航栏（左上角返回直接回首页） -->
  <view class="nav-bar" style="padding-top:{{statusBarHeight}}px;height:{{navBarTotal}}px;">
    <view class="nav-back" bindtap="goHome">
      <text class="nav-back-arrow">‹</text>
    </view>
    <text class="nav-title">家谱树</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 顶部工具栏 -->
  <view class="tree-toolbar">
    <view class="toolbar-left">
      <view class="generation-filter {{viewMode === 'vertical' ? 'disabled' : ''}}">
        <text class="filter-label">显示代数：</text>
        <view class="filter-options">
          <view class="filter-item {{selectedGen === 'default' ? 'active' : ''}}" bindtap="filterGen" data-gen="default">3代</view>
          <view class="filter-item {{selectedGen === '5' ? 'active' : ''}}" bindtap="filterGen" data-gen="5">5代</view>
          <view class="filter-item {{selectedGen === '7' ? 'active' : ''}}" bindtap="filterGen" data-gen="7">7代</view>
        </view>
      </view>
    </view>
    <view class="toolbar-right">
      <view class="tool-btn {{showSearchBar ? 'active' : ''}}" bindtap="onSearchToggle">
        <text>🔍</text>
      </view>
      <view class="tool-btn" bindtap="locateMe">
        <text>定位</text>
      </view>
      <view class="tool-btn" bindtap="resetView">
        <text>重置</text>
      </view>
      <view class="tool-btn" bindtap="toggleView">
        <text>{{viewMode === 'tree' ? '直系' : '树状'}}</text>
      </view>
    </view>
  </view>

  <!-- 搜索栏（手动触发：输入≥2字符后点击搜索按钮/键盘搜索键执行，输入过程不自动搜索） -->
  <view class="search-bar" wx:if="{{showSearchBar}}">
    <view class="search-row">
      <view class="search-input-wrap">
        <text class="search-icon">🔍</text>
        <input class="search-input" placeholder="搜索成员姓名（至少2个字符）" placeholder-class="placeholder" value="{{searchKeyword}}" bindinput="onSearchInput" bindconfirm="onSearchConfirm" confirm-type="search"/>
        <text class="search-clear" wx:if="{{searchKeyword}}" bindtap="clearSearch">×</text>
      </view>
      <view class="search-btn {{canSearch ? '' : 'disabled'}}" bindtap="doSearch">搜索</view>
    </view>
  </view>

  <!-- 空态 / 错误态 -->
  <view class="tree-status" wx:if="{{empty || loadError}}">
    <view class="status-box">
      <text class="status-text" wx:if="{{empty}}">该家族暂无成员\n点击下方「添加成员」开始录入</text>
      <text class="status-text" wx:elif="{{loadError}}">{{loadError}}</text>
      <view class="status-retry" wx:if="{{loadError}}" bindtap="retryLoad">重新加载</view>
    </view>
  </view>

  <!-- 树状视图（CSS/DOM 方案：舞台承载绝对定位节点与连接线，视口手势平移缩放） -->
  <view class="tree-view" style="height: calc(100vh - {{navBarTotal}}px - 220rpx);" wx:if="{{viewMode === 'tree'}}">
    <view class="family-viewport" id="treeViewport"
      bindtouchstart="onCanvasTouchStart"
      catchtouchmove="onCanvasTouchMove"
      bindtouchend="onCanvasTouchEnd">
      <view class="tree-stage tree-{{treeLod}}"
        style="width:{{treeStageW}}px;height:{{treeStageH}}px;transform:{{treeTransform}};">
        <!-- 连接线（kind v 竖线 / h 横线，坐标为世界 px） -->
        <view wx:for="{{treeLinks}}" wx:key="id"
          class="tree-link {{item.kind === 'v' ? 'tree-link-v' : 'tree-link-h'}}"
          style="left:{{item.x}}px;top:{{item.y}}px;{{item.kind === 'v' ? 'height:' + item.h + 'px' : 'width:' + item.w + 'px'}}"></view>
        <!-- 节点卡片（DOM 命中即元素本身，天然精确） -->
        <view wx:for="{{domNodes}}" wx:key="id"
          class="tree-node {{item.gender}} {{item.highlight ? 'highlight' : ''}}"
          style="left:{{item.x}}px;top:{{item.y}}px;width:{{item.w}}px;height:{{item.h}}px;"
          data-id="{{item.id}}" bindtap="onNodeTap">
          <view class="tree-node-avatar">
            <text>{{item.firstChar}}</text>
          </view>
          <view class="tree-node-main">
            <text class="tree-node-name">{{item.name}}</text>
            <view class="tree-node-tag" wx:if="{{item.generationName}}">{{item.generationName}}字辈</view>
          </view>
          <view class="tree-node-gen">{{item.generation}}代</view>
          <view wx:if="{{item.canCollapse}}" class="collapse-toggle {{item.collapsed ? 'collapsed' : ''}}"
            hover-class="collapse-press" hover-stop-propagation
            data-id="{{item.id}}" catchtap="onCollapseTap">
            <text wx:if="{{!item.collapsed}}">−</text>
            <text wx:else>+{{item.descendantCount}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="tree-hint">
      <text class="hint-text">共 {{memberCount}} 人 · 拖动平移 · 双指缩放 · 点击节点弹出操作</text>
    </view>
  </view>

  <!-- 直系图视图（CSS/DOM 方案） -->
  <view class="tree-view" style="height: calc(100vh - {{navBarTotal}}px - 220rpx);" wx:if="{{viewMode === 'vertical'}}">
    <view class="family-viewport" id="verticalViewport"
      bindtouchstart="onVerticalTouchStart"
      catchtouchmove="onVerticalTouchMove"
      bindtouchend="onVerticalTouchEnd">
      <view class="v-stage" style="width:{{vStageW}}px;height:{{vStageH}}px;transform:{{vTransform}};">
        <!-- 代际竖线（连接上一代红心到下一代，midX 恒一致 → 直线） -->
        <view wx:for="{{vLinks}}" wx:key="id" class="v-link"
          style="left:{{item.x}}px;top:{{item.y}}px;height:{{item.h}}px;"></view>
        <!-- 各代成员行：主头像 + 配偶 + 夫妇连线 + 红心家徽 -->
        <view wx:for="{{vDomNodes}}" wx:key="id" class="v-row"
          hover-class="v-row-press"
          style="left:{{item.x}}px;top:{{item.y}}px;width:{{item.w}}px;"
          data-id="{{item.id}}" bindtap="onNodeTap">
          <!-- 夫妇连线（中间断口由红心覆盖，与 Canvas 断线视觉一致） -->
          <view class="v-couple-line" style="left:78px;top:26.2px;width:{{item.coupleLineWidth}}px;"></view>
          <view class="v-heart" style="left:{{item.heartLeft}}px;top:15px;">
            <text>❤</text>
          </view>
          <!-- 主成员头像 + 名字 + 角色 -->
          <view class="v-avatar {{item.gender}} {{item.highlight ? 'highlight' : ''}}">
            <text>{{item.firstChar}}</text>
          </view>
          <view class="v-name">{{item.name}}</view>
          <view class="v-role">{{item.role}}</view>
          <!-- 配偶头像 + 名字 + 称谓（无配偶为"失记"占位） -->
          <view class="v-spouse-avatar {{item.hasSpouse ? '' : 'placeholder'}}"
            style="left:{{item.spouseLeft}}px;">
            <text>{{item.spouseFirstChar}}</text>
          </view>
          <view class="v-spouse-name" style="left:{{item.spouseLeft}}px;">{{item.hasSpouse ? item.spouseName : '失记'}}</view>
          <view class="v-spouse-role" style="left:{{item.spouseLeft}}px;">{{item.spouseRole}}</view>
        </view>
      </view>
    </view>
    <view class="tree-hint">
      <text class="hint-text">直系共 {{memberCount}} 人 · 拖动查看，双指缩放 · 点击成员弹出操作</text>
    </view>
  </view>

  <!-- 列表视图：当前已取消显示 -->
  <!-- <view class="list-view" wx:if="{{viewMode === 'list'}}">
    <view class="member-list-item" wx:for="{{memberList}}" wx:key="id" bindtap="showNodeDetail" data-id="{{item.id}}">
      <view class="list-avatar {{item.gender === 'female' ? 'female' : ''}}">
        <text>{{f.firstChar(item.name)}}</text>
      </view>
      <view class="list-info">
        <view class="list-name-row">
          <text class="list-name">{{item.name}}</text>
          <text class="list-relation" wx:if="{{item.generationName}}">{{item.generationName}}字辈</text>
          <text class="list-relation" wx:elif="{{item.relation}}">{{item.relation}}</text>
        </view>
        <text class="list-desc">{{item.generation}}代 | {{item.birthYear || '未知'}}年生</text>
      </view>
      <text class="list-arrow">›</text>
    </view>
    <view class="list-empty" wx:if="{{memberList.length === 0}}">
      <text>暂无成员，点击下方"添加成员"开始录入</text>
    </view>
    <view class="load-more" wx:if="{{listHasMore}}" bindtap="loadMoreList">
      <text>加载更多</text>
    </view>
  </view> -->

  <!-- 加载状态：改用 wx.showLoading 原生提示（真机更流畅，此处无自定义动画层） -->

  <!-- 底部操作栏 -->
  <view class="bottom-actions">
    <view class="action-btn" bindtap="addMember">
      <text class="btn-icon">+</text>
      <text>添加成员</text>
    </view>
    <view class="action-btn" bindtap="exportTree">
      <text class="btn-icon">↗</text>
      <text>导出</text>
    </view>
  </view>
</view>

<!-- 节点详情弹窗 -->
<view class="modal-mask" wx:if="{{showModal}}" bindtap="closeModal"></view>
<view class="modal-content" wx:if="{{showModal}}" animation="{{modalAnimation}}">
  <view class="modal-header">
    <view class="modal-avatar {{selectedNode.avatar ? 'with-image' : ''}}" bindtap="previewNodeAvatar">
      <image wx:if="{{selectedNode.avatar}}" class="modal-avatar-image" src="{{selectedNode.avatar}}" mode="aspectFill" binderror="onAvatarError" lazy-load/>
      <text wx:else>{{f.firstChar(selectedNode.name)}}</text>
    </view>
    <view class="modal-title">
      <text class="modal-name">{{selectedNode.name}}</text>
      <text class="modal-subtitle">{{selectedNode.generationName ? selectedNode.generationName + '字辈 | ' : ''}}{{selectedNode.generation}}代 | {{selectedNode.birthYear || '未知'}}年</text>
    </view>
    <view class="modal-close" bindtap="closeModal">×</view>
  </view>
  <view class="modal-body">
    <view class="modal-info-row" wx:if="{{selectedNode.generationName}}">
      <text class="info-label">字辈</text>
      <text class="info-value">{{selectedNode.generationName}}字辈</text>
    </view>
    <view class="modal-info-row">
      <text class="info-label">性别</text>
      <text class="info-value">{{selectedNode.gender === 'female' ? '女' : '男'}}</text>
    </view>
    <view class="modal-info-row" wx:if="{{selectedNode.spouseInfo && selectedNode.spouseInfo.name}}">
      <text class="info-label">配偶</text>
      <text class="info-value">{{selectedNode.spouseInfo.name}}</text>
    </view>
    <view class="modal-info-row">
      <text class="info-label">子女</text>
      <text class="info-value">{{selectedNode.childrenCount || 0}}人</text>
    </view>
    <view class="modal-info-row" wx:if="{{selectedNode.descendantCount > selectedNode.childrenCount}}">
      <text class="info-label">后代</text>
      <text class="info-value">{{selectedNode.descendantCount}}人</text>
    </view>
    <view class="modal-collapse" wx:if="{{selectedNode.childrenCount > 0}}" bindtap="toggleSelectedCollapse">
      <text>{{selectedCollapsed ? '展开该分支' : '折叠该分支'}}</text>
    </view>
  </view>
  <view class="modal-footer">
    <view class="modal-btn" bindtap="addChild">添加子女</view>
    <view class="modal-btn" bindtap="viewDetail">查看详情</view>
    <view class="modal-btn primary" bindtap="editNode">编辑</view>
    <view class="modal-btn" wx:if="{{viewMode === 'vertical'}}" bindtap="setAsVerticalRoot">以此为中心</view>
  </view>
</view>


