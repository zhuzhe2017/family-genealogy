<wxs src="../../utils/filters.wxs" module="f" />
<view class="page-container">
  <!-- 顶部工具栏 -->
  <view class="tree-toolbar">
    <view class="toolbar-left">
      <view class="generation-filter">
        <text class="filter-label">显示代数：</text>
        <view class="filter-options">
          <view class="filter-item {{selectedGen === 'all' ? 'active' : ''}}" bindtap="filterGen" data-gen="all">全部</view>
          <view class="filter-item {{selectedGen === '3' ? 'active' : ''}}" bindtap="filterGen" data-gen="3">3代</view>
          <view class="filter-item {{selectedGen === '5' ? 'active' : ''}}" bindtap="filterGen" data-gen="5">5代</view>
        </view>
      </view>
    </view>
    <view class="toolbar-right">
      <view class="tool-btn {{showSearchBar ? 'active' : ''}}" bindtap="onSearchToggle">
        <text>🔍</text>
      </view>
      <view class="tool-btn" bindtap="resetView">
        <text>重置</text>
      </view>
      <view class="tool-btn" bindtap="toggleView">
        <text>{{viewMode === 'tree' ? '列表' : '树状'}}</text>
      </view>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar" wx:if="{{showSearchBar}}">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索成员姓名" placeholder-class="placeholder" value="{{searchKeyword}}" bindinput="onSearchInput" confirm-type="search"/>
      <text class="search-clear" wx:if="{{searchKeyword}}" bindtap="clearSearch">×</text>
    </view>
  </view>

  <!-- 树状视图 -->
  <view class="tree-view" wx:if="{{viewMode === 'tree'}}">
    <canvas
      type="2d"
      id="familyTreeCanvas"
      class="family-tree-canvas"
      style="{{canvasStyle}}"
      bindtouchstart="onCanvasTouchStart"
      catchtouchmove="onCanvasTouchMove"
      bindtouchend="onCanvasTouchEnd"
      bindtap="onCanvasTap">
    </canvas>
    <view class="tree-hint">
      <text class="hint-text">拖动查看完整家谱</text>
    </view>
  </view>

  <!-- 列表视图 -->
  <view class="list-view" wx:if="{{viewMode === 'list'}}">
    <view class="member-list-item" wx:for="{{memberList}}" wx:key="id" bindtap="showNodeDetail" data-id="{{item.id}}">
      <view class="list-avatar {{item.gender === 'female' ? 'female' : ''}}">
        <text>{{f.firstChar(item.name)}}</text>
      </view>
      <view class="list-info">
        <view class="list-name-row">
          <text class="list-name">{{item.name}}</text>
          <text class="list-relation" wx:if="{{item.generationName}}">{{item.generationName}}字辈</text>
          <text class="list-relation" wx:elif="{{item.relation}}">{{item.relation}}</text>
        </view>
        <text class="list-desc">{{item.generation}}代 | {{item.birthYear || '未知'}}年生</text>
      </view>
      <text class="list-arrow">›</text>
    </view>
    <view class="list-empty" wx:if="{{memberList.length === 0}}">
      <text>暂无成员，点击下方"添加成员"开始录入</text>
    </view>
    <view class="load-more" wx:if="{{listHasMore}}" bindtap="loadMoreList">
      <text>加载更多</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-actions">
    <view class="action-btn" bindtap="addMember">
      <text class="btn-icon">+</text>
      <text>添加成员</text>
    </view>
    <view class="action-btn" bindtap="exportTree">
      <text class="btn-icon">↗</text>
      <text>导出</text>
    </view>
  </view>
</view>

<!-- 节点详情弹窗 -->
<view class="modal-mask" wx:if="{{showModal}}" bindtap="closeModal"></view>
<view class="modal-content" wx:if="{{showModal}}" animation="{{modalAnimation}}">
  <view class="modal-header">
    <view class="modal-avatar">
      <text>{{f.firstChar(selectedNode.name)}}</text>
    </view>
    <view class="modal-title">
      <text class="modal-name">{{selectedNode.name}}</text>
      <text class="modal-subtitle">{{selectedNode.generationName ? selectedNode.generationName + '字辈 | ' : ''}}{{selectedNode.generation}}代 | {{selectedNode.birthYear || '未知'}}年</text>
    </view>
    <view class="modal-close" bindtap="closeModal">×</view>
  </view>
  <view class="modal-body">
    <view class="modal-info-row" wx:if="{{selectedNode.generationName}}">
      <text class="info-label">字辈</text>
      <text class="info-value">{{selectedNode.generationName}}字辈</text>
    </view>
    <view class="modal-info-row">
      <text class="info-label">性别</text>
      <text class="info-value">{{selectedNode.gender === 'female' ? '女' : '男'}}</text>
    </view>
    <view class="modal-info-row" wx:if="{{selectedNode.spouseInfo && selectedNode.spouseInfo.name}}">
      <text class="info-label">配偶</text>
      <text class="info-value">{{selectedNode.spouseInfo.name}}</text>
    </view>
    <view class="modal-info-row">
      <text class="info-label">子女</text>
      <text class="info-value">{{selectedNode.childrenCount || 0}}人</text>
    </view>
    <view class="modal-info-row" wx:if="{{selectedNode.descendantCount > selectedNode.childrenCount}}">
      <text class="info-label">后代</text>
      <text class="info-value">{{selectedNode.descendantCount}}人</text>
    </view>
    <view class="modal-collapse" wx:if="{{selectedNode.childrenCount > 0}}" bindtap="toggleSelectedCollapse">
      <text>{{selectedCollapsed ? '展开该分支' : '折叠该分支'}}</text>
    </view>
  </view>
  <view class="modal-footer">
    <view class="modal-btn" bindtap="addChild">添加子女</view>
    <view class="modal-btn" bindtap="viewDetail">查看详情</view>
    <view class="modal-btn primary" bindtap="editNode">编辑</view>
  </view>
</view>
