.page-container {
  padding-bottom: 120rpx;
  background: #F8F6F3;
  min-height: 100vh;
}

/* 自定义导航栏 */
.nav-bar {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #8B1A1A, #6B0F0F);
  box-sizing: border-box;
  z-index: 100;
}

.nav-back {
  width: 88rpx;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-back-arrow {
  font-size: 48rpx;
  color: #FFFFFF;
  line-height: 1;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  white-space: nowrap;
}

.nav-placeholder {
  width: 88rpx;
  flex-shrink: 0;
}

/* 工具栏 */
.tree-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.generation-filter {
  display: flex;
  align-items: center;
}

.filter-label {
  font-size: 24rpx;
  color: #666;
  margin-right: 16rpx;
}

.filter-options {
  display: flex;
  gap: 12rpx;
}

.filter-item {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: #F5F5F5;
  color: #666;
}

.filter-item.active {
  background: #8B1A1A;
  color: #FFFFFF;
}

/* 直系图下显示代数不可用：灰显并阻断点击（仅树状图支持按代数裁剪） */
.generation-filter.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.toolbar-right {
  display: flex;
  gap: 16rpx;
}

.tool-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #666;
}

.tool-btn.active {
  background: #8B1A1A;
  color: #FFFFFF;
}

/* 搜索栏 */
.search-bar {
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 32rpx;
  padding: 0 24rpx;
  height: 64rpx;
  min-width: 0;
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  height: 64rpx;
  line-height: 64rpx;
}

.search-clear {
  font-size: 36rpx;
  color: #999;
  padding: 0 8rpx;
}

/* 搜索按钮:输入≥2字符前置灰 */
.search-btn {
  flex-shrink: 0;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: #8B1A1A;
  color: #FFFFFF;
  font-size: 26rpx;
  border-radius: 32rpx;
  text-align: center;
}

.search-btn.disabled {
  background: #D9CFC4;
}

/* 树状视图 */
.tree-view {
  position: relative;
  width: 100%;
  height: calc(100vh - 220rpx);
  background: #F0E9DD;
  overflow: hidden;
}

.family-viewport {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  touch-action: none;
}

/* 舞台：绝对定位承载世界坐标内容，transform 实现平移缩放（transform-origin 左上角） */
.tree-stage,
.v-stage {
  position: absolute;
  top: 0;
  left: 0;
  transform-origin: 0 0;
}

/* ==========================================================================
   树状图：连接线（折线几何：竖线段 + 横线段，Canvas 同色同宽）
   ========================================================================== */
.tree-link {
  position: absolute;
  background: #C08A55;
}

.tree-link-v {
  width: 1.5px;
}

.tree-link-h {
  height: 1.5px;
}

/* ==========================================================================
   树状图：节点卡片（世界坐标 px 由 JS 布局给定，视觉与 Canvas 卡片 1:1）
   ========================================================================== */
.tree-node {
  position: absolute;
  box-sizing: border-box;
  background: #FFFFFF;
  border: 1px solid #D9C5AC;
  border-radius: 10px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
}

.tree-node.female {
  background: #FFF0F3;
  border-color: #E695A5;
}

/* 定位高亮：外圈描红，任意 LOD 均可见（替代 Canvas 外圈描边） */
.tree-node.highlight {
  box-shadow: 0 0 0 3px #E07A5F, 0 2px 6px rgba(0, 0, 0, 0.1);
}

/* 按下反馈（整卡描边，替代 Canvas 悬停描边） */
.tree-node-press {
  box-shadow: 0 0 0 2px #8B1A1A, 0 2px 6px rgba(0, 0, 0, 0.1);
}

/* 首字头像（圆心 x+24,y+34，r16） */
.tree-node-avatar {
  position: absolute;
  left: 8px;
  top: 18px;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #8B1A1A;
  color: #FFFFFF;
  font-size: 12px;
  font-weight: bold;
  font-family: 'KaiTi', 'STKaiti', serif;
  text-align: center;
  line-height: 32px;
  overflow: hidden;
}

.tree-node.female .tree-node-avatar {
  background: #FF6B9D;
}

/* 名字（左上，可截断）+ 字辈标签 */
.tree-node-name {
  position: absolute;
  left: 44px;
  right: 6px;
  top: 14px;
  font-size: 12px;
  font-weight: bold;
  color: #333333;
  line-height: 16px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tree-node-tag {
  position: absolute;
  left: 44px;
  top: 44px;
  max-width: 70px;
  box-sizing: border-box;
  padding: 0 5px;
  height: 14px;
  line-height: 14px;
  font-size: 9px;
  color: #7A6A56;
  background: #EFE7DA;
  border: 1px solid #CFC2AE;
  border-radius: 3px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 代数徽标（右上角） */
.tree-node-gen {
  position: absolute;
  right: 4px;
  top: 3px;
  height: 14px;
  line-height: 14px;
  padding: 0 4px;
  font-size: 9px;
  color: #8B1A1A;
  background: rgba(139, 26, 26, 0.08);
  border-radius: 7px;
}

/* 折叠/展开指示器（右侧垂直居中；展开态圆形减号，折叠态 +N 药丸） */
.collapse-toggle {
  position: absolute;
  right: -10px;
  top: 50%;
  margin-top: -9px;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #F5EFE6;
  border: 1px solid #C08A55;
  color: #8B1A1A;
  font-size: 12px;
  font-weight: bold;
  line-height: 18px;
  text-align: center;
  box-sizing: border-box;
  z-index: 3;
}

.collapse-toggle.collapsed {
  width: auto;
  min-width: 18px;
  height: 14px;
  margin-top: -7px;
  padding: 0 5px;
  border-radius: 7px;
  background: rgba(139, 26, 26, 0.1);
  border: none;
  font-size: 9px;
  line-height: 14px;
}

/* ==========================================================================
   LOD 分级：按卡片屏幕宽度切换细节（CSS 显隐，视觉与 Canvas 分级一致）
   lod0 色块 / lod1 仅名字（垂直居中）/ lod2 完整细节
   ========================================================================== */
.tree-lod0 .tree-node-avatar,
.tree-lod0 .tree-node-main,
.tree-lod0 .tree-node-gen,
.tree-lod0 .collapse-toggle {
  display: none;
}

.tree-lod1 .tree-node-avatar,
.tree-lod1 .tree-node-gen,
.tree-lod1 .tree-node-tag,
.tree-lod1 .collapse-toggle {
  display: none;
}

.tree-lod1 .tree-node-main {
  position: absolute;
  left: 44px;
  right: 6px;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
}

.tree-lod1 .tree-node-name {
  position: static;
  flex: 1;
}

/* ==========================================================================
   直系图：代际竖线 / 成员行 / 夫妇连线与红心家徽（世界坐标 px）
   ========================================================================== */
.v-link {
  position: absolute;
  width: 2px;
  background: #E8B4A8;
}

.v-row {
  position: absolute;
  height: 110px;
}

/* 按下反馈 */
.v-row-press {
  background: rgba(224, 122, 95, 0.08);
  border-radius: 16px;
}

.v-avatar {
  position: absolute;
  left: 0;
  top: 0;
  width: 68px;
  height: 68px;
  border-radius: 50%;
  background: #6A8BAE;
  color: #FFFFFF;
  font-size: 20px;
  font-weight: bold;
  font-family: 'KaiTi', 'STKaiti', serif;
  text-align: center;
  line-height: 68px;
  overflow: hidden;
}

.v-avatar.female {
  background: #D98BA6;
}

.v-avatar.highlight {
  box-shadow: 0 0 0 3px #E07A5F;
}

.v-name {
  position: absolute;
  left: 0;
  top: 76px;
  width: 68px;
  text-align: center;
  font-size: 14px;
  font-weight: bold;
  color: #333333;
  line-height: 16px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.v-role {
  position: absolute;
  left: 0;
  top: 94px;
  width: 68px;
  text-align: center;
  font-size: 12px;
  color: #8B7D6B;
  line-height: 14px;
}

.v-spouse-avatar {
  position: absolute;
  top: 0;
  width: 54.4px;
  height: 54.4px;
  border-radius: 50%;
  background: #D98BA6;
  color: #FFFFFF;
  font-size: 16px;
  font-weight: bold;
  font-family: 'KaiTi', 'STKaiti', serif;
  text-align: center;
  line-height: 54.4px;
  overflow: hidden;
}

.v-spouse-avatar.placeholder {
  background: #BDB4A8;
}

.v-spouse-name {
  position: absolute;
  top: 62.4px;
  width: 54.4px;
  text-align: center;
  font-size: 14px;
  font-weight: bold;
  color: #333333;
  line-height: 16px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.v-spouse-role {
  position: absolute;
  top: 80.4px;
  width: 54.4px;
  text-align: center;
  font-size: 12px;
  color: #8B7D6B;
  line-height: 14px;
}

.v-couple-line {
  position: absolute;
  height: 2px;
  background: #E8B4A8;
}

.v-heart {
  position: absolute;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: #E07A5F;
  color: #FFFFFF;
  font-size: 14px;
  line-height: 24px;
  text-align: center;
  z-index: 2;
}

/* ==========================================================================
   响应式适配：小屏压缩工具栏间距、隐藏冗余文字（布局缩放由视图适配引擎处理）
   ========================================================================== */
@media (max-width: 360px) {
  .tree-toolbar {
    padding: 16rpx 12rpx;
  }

  .filter-label {
    display: none;
  }

  .tool-btn {
    width: 56rpx;
    height: 56rpx;
    font-size: 20rpx;
  }
}

.tree-hint {
  position: absolute;
  bottom: 24rpx;
  left: 0;
  right: 0;
  text-align: center;
  pointer-events: none;
}

.hint-text {
  font-size: 22rpx;
  color: #999;
  background: rgba(255, 255, 255, 0.8);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

/* 空态 / 错误态 */
.tree-status {
  position: fixed;
  left: 0;
  right: 0;
  top: 40%;
  transform: translateY(-50%);
  z-index: 50;
  display: flex;
  justify-content: center;
  padding: 0 60rpx;
}

.status-box {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
}

.status-text {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
  white-space: pre-line;
}

.status-retry {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  color: #FFFFFF;
  font-size: 28rpx;
}

/* 列表视图 */
.list-view {
  padding: 24rpx;
}

.member-list-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.list-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.list-avatar.female {
  background: linear-gradient(135deg, #FF6B9D, #FFB6C1);
}

.list-avatar text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: bold;
  font-family: 'KaiTi', serif;
}

.list-info {
  flex: 1;
  min-width: 0;
}

.list-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.list-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-right: 16rpx;
}

.list-relation {
  font-size: 22rpx;
  color: #8B1A1A;
  background: rgba(139, 26, 26, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.list-desc {
  font-size: 24rpx;
  color: #999;
}

.list-arrow {
  font-size: 36rpx;
  color: #CCC;
  margin-left: 16rpx;
}

/* 列表空态 */
.list-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

/* 加载更多 */
.load-more {
  padding: 24rpx 0 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8B1A1A;
}

/* 底部操作栏 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  gap: 24rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
  color: #333;
  font-size: 28rpx;
}

.action-btn:first-child {
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  color: #FFFFFF;
}

.btn-icon {
  margin-right: 8rpx;
  font-size: 32rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

.modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  z-index: 101;
  padding: 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.modal-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.modal-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.modal-avatar-image {
  width: 100%;
  height: 100%;
  display: block;
}

.modal-avatar text {
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: bold;
  font-family: 'KaiTi', serif;
}

.modal-title {
  flex: 1;
}

.modal-name {
  font-size: 36rpx;
  color: #333;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.modal-subtitle {
  font-size: 24rpx;
  color: #999;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #999;
}

.modal-body {
  margin-bottom: 32rpx;
}

.modal-info-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.modal-collapse {
  margin-top: 20rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8B1A1A;
  border: 1rpx solid #F0E0D0;
  border-radius: 12rpx;
  background: #FDF8F3;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.modal-btn {
  flex: 1;
  min-width: 140rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
  color: #333;
  font-size: 26rpx;
  font-weight: 500;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  color: #FFFFFF;
}


