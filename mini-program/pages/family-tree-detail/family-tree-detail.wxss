.page-container {
  padding-bottom: 120rpx;
  background: #F8F6F3;
  min-height: 100vh;
}

/* 自定义导航栏 */
.nav-bar {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #8B1A1A, #6B0F0F);
  box-sizing: border-box;
  z-index: 100;
}

.nav-back {
  width: 88rpx;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-back-arrow {
  font-size: 48rpx;
  color: #FFFFFF;
  line-height: 1;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  white-space: nowrap;
}

.nav-placeholder {
  width: 88rpx;
  flex-shrink: 0;
}

/* 工具栏 */
.tree-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.generation-filter {
  display: flex;
  align-items: center;
}

.filter-label {
  font-size: 24rpx;
  color: #666;
  margin-right: 16rpx;
}

.filter-options {
  display: flex;
  gap: 12rpx;
}

.filter-item {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: #F5F5F5;
  color: #666;
}

.filter-item.active {
  background: #8B1A1A;
  color: #FFFFFF;
}

.toolbar-right {
  display: flex;
  gap: 16rpx;
}

.tool-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #666;
}

.tool-btn.active {
  background: #8B1A1A;
  color: #FFFFFF;
}

/* 搜索栏 */
.search-bar {
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 32rpx;
  padding: 0 24rpx;
  height: 64rpx;
  min-width: 0;
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  height: 64rpx;
  line-height: 64rpx;
}

.search-clear {
  font-size: 36rpx;
  color: #999;
  padding: 0 8rpx;
}

/* 搜索按钮:输入≥2字符前置灰 */
.search-btn {
  flex-shrink: 0;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: #8B1A1A;
  color: #FFFFFF;
  font-size: 26rpx;
  border-radius: 32rpx;
  text-align: center;
}

.search-btn.disabled {
  background: #D9CFC4;
}

/* 树状视图 */
.tree-view {
  position: relative;
  width: 100%;
  height: calc(100vh - 220rpx);
  background: #F0E9DD;
  overflow: hidden;
}

.family-tree-canvas {
  width: 100%;
  height: 100%;
  display: block;
  background: #F0E9DD;
}

.tree-hint {
  position: absolute;
  bottom: 24rpx;
  left: 0;
  right: 0;
  text-align: center;
  pointer-events: none;
}

.hint-text {
  font-size: 22rpx;
  color: #999;
  background: rgba(255, 255, 255, 0.8);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

/* 空态 / 错误态 */
.tree-status {
  position: fixed;
  left: 0;
  right: 0;
  top: 40%;
  transform: translateY(-50%);
  z-index: 50;
  display: flex;
  justify-content: center;
  padding: 0 60rpx;
}

.status-box {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
}

.status-text {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
  white-space: pre-line;
}

.status-retry {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  color: #FFFFFF;
  font-size: 28rpx;
}

/* 列表视图 */
.list-view {
  padding: 24rpx;
}

.member-list-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.list-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.list-avatar.female {
  background: linear-gradient(135deg, #FF6B9D, #FFB6C1);
}

.list-avatar text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: bold;
  font-family: 'KaiTi', serif;
}

.list-info {
  flex: 1;
  min-width: 0;
}

.list-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.list-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-right: 16rpx;
}

.list-relation {
  font-size: 22rpx;
  color: #8B1A1A;
  background: rgba(139, 26, 26, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.list-desc {
  font-size: 24rpx;
  color: #999;
}

.list-arrow {
  font-size: 36rpx;
  color: #CCC;
  margin-left: 16rpx;
}

/* 列表空态 */
.list-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

/* 加载更多 */
.load-more {
  padding: 24rpx 0 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8B1A1A;
}

/* 底部操作栏 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  gap: 24rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
  color: #333;
  font-size: 28rpx;
}

.action-btn:first-child {
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  color: #FFFFFF;
}

.btn-icon {
  margin-right: 8rpx;
  font-size: 32rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

.modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  z-index: 101;
  padding: 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.modal-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.modal-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.modal-avatar-image {
  width: 100%;
  height: 100%;
  display: block;
}

.modal-avatar text {
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: bold;
  font-family: 'KaiTi', serif;
}

.modal-title {
  flex: 1;
}

.modal-name {
  font-size: 36rpx;
  color: #333;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.modal-subtitle {
  font-size: 24rpx;
  color: #999;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #999;
}

.modal-body {
  margin-bottom: 32rpx;
}

.modal-info-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.modal-collapse {
  margin-top: 20rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8B1A1A;
  border: 1rpx solid #F0E0D0;
  border-radius: 12rpx;
  background: #FDF8F3;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.modal-btn {
  flex: 1;
  min-width: 140rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
  color: #333;
  font-size: 26rpx;
  font-weight: 500;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  color: #FFFFFF;
}

/* ===== DOM 覆盖层气泡（混合方案：Canvas 绘制树体，气泡由视图层渲染） ===== */
.tooltip-layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 0;
  height: 0;
  z-index: 30;
}

.tooltip {
  position: absolute;
  width: 220px;
  background: #FFFFFF;
  border-radius: 10px;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
  padding: 12px 14px 10px;
  box-sizing: border-box;
  transform: translate(-50%, calc(-100% - 8px));
  animation: tooltip-pop 0.18s ease-out;
}

/* 上方空间不足时翻转到节点下方 */
.tooltip-below {
  transform: translate(-50%, 8px);
  animation: tooltip-pop-below 0.18s ease-out;
}

/* 指向节点的箭头 */
.tooltip-arrow {
  position: absolute;
  left: 50%;
  bottom: -6px;
  width: 12px;
  height: 12px;
  background: #FFFFFF;
  transform: translateX(-50%) rotate(45deg);
  border-right: 1px solid rgba(0, 0, 0, 0.06);
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  border-radius: 2px;
}

.tooltip-below .tooltip-arrow {
  bottom: auto;
  top: -6px;
  border-right: none;
  border-bottom: none;
  border-left: 1px solid rgba(0, 0, 0, 0.06);
  border-top: 1px solid rgba(0, 0, 0, 0.06);
}

/* 气泡头部：头像 + 姓名（姓名过长时 CSS 自动换行） */
.tooltip-head {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
}

.tooltip-avatar {
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #8B1A1A;
  color: #FFFFFF;
  font-size: 18px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10px;
}

.tooltip-avatar.female {
  background: #C25A6E;
}

.tooltip-name-wrap {
  flex: 1;
  min-width: 0;
}

.tooltip-name {
  font-size: 16px;
  font-weight: 600;
  color: #333;
  line-height: 1.35;
  word-break: break-all;
}

.tooltip-tags {
  margin-top: 4px;
  display: flex;
  gap: 6px;
}

.tooltip-tag {
  font-size: 11px;
  line-height: 1;
  padding: 3px 8px;
  border-radius: 999px;
}

.tag-gender {
  background: #EFE7DA;
  color: #7A6A56;
}

.tag-alive {
  background: rgba(90, 160, 90, 0.12);
  color: #3E7C3E;
}

.tag-dead {
  background: rgba(139, 26, 26, 0.12);
  color: #8B1A1A;
}

.tooltip-row {
  display: flex;
  font-size: 13px;
  line-height: 1.8;
}

.tooltip-label {
  width: 44px;
  flex-shrink: 0;
  color: #999;
}

.tooltip-value {
  flex: 1;
  min-width: 0;
  color: #444;
  word-break: break-all;
}

.tooltip-actions {
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px solid #F0F0F0;
  display: flex;
  justify-content: center;
}

.tooltip-btn {
  padding: 8px 20px;
  border-radius: 999px;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  color: #FFFFFF;
  font-size: 13px;
  font-weight: 500;
}

/* 气泡入场动画（CSS 声明式，Canvas 侧无需任何改动） */
@keyframes tooltip-pop {
  from {
    opacity: 0;
    transform: translate(-50%, calc(-100% + 2px)) scale(0.92);
  }
  to {
    opacity: 1;
    transform: translate(-50%, calc(-100% - 8px)) scale(1);
  }
}

@keyframes tooltip-pop-below {
  from {
    opacity: 0;
    transform: translate(-50%, -2px) scale(0.92);
  }
  to {
    opacity: 1;
    transform: translate(-50%, 8px) scale(1);
  }
}
