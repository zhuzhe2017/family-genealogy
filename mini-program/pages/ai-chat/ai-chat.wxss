/* pages/ai-chat/ai-chat.wxss */
page { background: #f4f1ec; height: 100%; }

.chat-wrap {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ============ 消息区 ============ */
.msg-scroll {
  flex: 1;
  height: 0;
  padding: 24rpx 24rpx 16rpx;
}

.msg-list {
  padding-bottom: 24rpx;
}

.msg-item {
  display: flex;
  margin-bottom: 28rpx;
  align-items: flex-start;
}
.msg-item.user { flex-direction: row-reverse; }

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.user-avatar { background: #8B1A1A; }
.ai-avatar   { background: #2d6a4f; }
.avatar-icon { font-size: 36rpx; }

.bubble-wrap {
  max-width: 70%;
  margin: 0 16rpx;
}

.bubble {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  line-height: 1.7;
  font-size: 28rpx;
  white-space: pre-wrap;
  word-break: break-word;
}
.user-bubble {
  background: #8B1A1A;
  color: #fff;
  border-bottom-right-radius: 6rpx;
}
.ai-bubble {
  background: #fff;
  color: #2c1810;
  border-bottom-left-radius: 6rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}
.bubble.loading {
  min-width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 32rpx;
}

/* typing 动画 */
.typing-dots {
  display: flex;
  gap: 8rpx;
}
.typing-dots .dot {
  width: 12rpx;
  height: 12rpx;
  background: #bbb;
  border-radius: 50%;
  animation: typing-bounce 1.2s infinite ease-in-out;
}
.typing-dots .dot:nth-child(2) { animation-delay: 0.15s; }
.typing-dots .dot:nth-child(3) { animation-delay: 0.3s; }
@keyframes typing-bounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
  30% { transform: translateY(-10rpx); opacity: 1; }
}

/* ============ 快捷短语 ============ */
.quick-prompts {
  padding: 12rpx 0 8rpx;
  border-top: 1rpx solid rgba(0,0,0,0.04);
}
.prompts-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
}
.prompt-chip {
  display: inline-flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  font-size: 26rpx;
  color: #2c1810;
}
.prompt-emoji { margin-right: 8rpx; }

/* ============ 输入框 ============ */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 28rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  gap: 16rpx;
}
.input-field {
  flex: 1;
  background: #f5f1ea;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  min-height: 72rpx;
}
.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #8B1A1A;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.send-btn.disabled { opacity: 0.4; }
.send-icon {
  color: #fff;
  font-size: 32rpx;
}

/* ============ 会话抽屉 ============ */
.drawer-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 99;
}
.session-drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 80%;
  max-width: 560rpx;
  background: #fff;
  z-index: 100;
  transform: translateX(100%);
  transition: transform 0.25s ease;
  display: flex;
  flex-direction: column;
}
.session-drawer.show {
  transform: translateX(0);
}
.drawer-header {
  padding: 32rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}
.drawer-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c1810;
}
.new-session-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #8B1A1A;
  color: #fff;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}
.plus-icon { font-size: 28rpx; }

.drawer-scroll {
  flex: 1;
  height: 0;
  padding: 16rpx;
}
.drawer-empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 26rpx;
}

.session-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  background: #faf8f4;
  position: relative;
}
.session-item.current {
  background: rgba(139, 26, 26, 0.06);
  border: 2rpx solid rgba(139, 26, 26, 0.2);
}
.session-info {
  flex: 1;
  overflow: hidden;
}
.session-title {
  font-size: 28rpx;
  color: #2c1810;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.session-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
}
.meta-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  color: #fff;
}
.meta-tag.type-general    { background: #888; }
.meta-tag.type-genealogy  { background: #8B1A1A; }
.meta-tag.type-ancient    { background: #2d6a4f; }
.meta-count {
  font-size: 22rpx;
  color: #aaa;
}
.session-delete {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ccc;
  font-size: 28rpx;
}
