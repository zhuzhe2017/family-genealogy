/* pages/ai-chat/ai-chat.wxss — 识典古籍古典风格（v1.1） */

page { background: var(--paper); height: 100%; }

.chat-wrap {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--paper);
}

/* ============ 消息区 ============ */
.msg-scroll {
  flex: 1;
  height: 0;
  padding: 24rpx 24rpx 16rpx;
}

.msg-list {
  padding-bottom: 24rpx;
}

.msg-item {
  display: flex;
  margin-bottom: 28rpx;
  align-items: flex-start;
}
.msg-item.user { flex-direction: row-reverse; }

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-family: var(--font-kai);
  border: 2rpx solid var(--seal);
}
.user-avatar { background: var(--seal); color: #fff; border-color: var(--seal); }
.ai-avatar   { background: var(--paper-3); color: var(--seal); border-color: var(--seal); }
.avatar-icon { font-size: 36rpx; }

.bubble-wrap {
  max-width: 70%;
  margin: 0 16rpx;
}

.bubble {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  line-height: 1.8;
  font-size: 28rpx;
  white-space: pre-wrap;
  word-break: break-word;
}
.user-bubble {
  background: var(--seal);
  color: #fff;
  border-bottom-right-radius: 6rpx;
}
.ai-bubble {
  background: var(--paper-2);
  color: var(--ink);
  border: 1rpx solid var(--line);
  border-bottom-left-radius: 6rpx;
  box-shadow: 0 2rpx 12rpx rgba(44, 24, 16, 0.05);
  font-family: var(--font-song);
}
.bubble.loading {
  min-width: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 32rpx;
}

/* typing 动画 */
.typing-dots {
  display: flex;
  gap: 8rpx;
}
.typing-dots .dot {
  width: 12rpx;
  height: 12rpx;
  background: var(--seal);
  border-radius: 50%;
  animation: typing-bounce 1.2s infinite ease-in-out;
}
.typing-dots .dot:nth-child(2) { animation-delay: 0.15s; }
.typing-dots .dot:nth-child(3) { animation-delay: 0.3s; }
@keyframes typing-bounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-10rpx); opacity: 1; }
}

/* ============ 快捷短语 — 印章/金风格 ============ */
.quick-prompts {
  padding: 12rpx 0 8rpx;
  border-top: 1rpx solid var(--line);
  background: var(--paper);
}
.prompts-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
}
.prompt-chip {
  display: inline-flex;
  align-items: center;
  background: var(--paper-2);
  border: 1rpx solid var(--line-strong);
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
  margin-right: 16rpx;
  font-family: var(--font-kai);
  font-size: 26rpx;
  color: var(--ink);
  letter-spacing: 1rpx;
}
.prompt-emoji { margin-right: 8rpx; }

/* ============ 输入框 ============ */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 28rpx;
  background: var(--paper-2);
  border-top: 2rpx solid var(--seal);
  gap: 16rpx;
}
.input-field {
  flex: 1;
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  font-family: var(--font-song);
  min-height: 72rpx;
  color: var(--ink);
}
.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--seal);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 2rpx solid var(--seal);
}
.send-btn.disabled { opacity: 0.4; }
.send-icon {
  color: #fff;
  font-size: 32rpx;
}

/* ============ 会话抽屉 — 米黄纸 + 印章 ============ */
.drawer-mask {
  position: fixed;
  inset: 0;
  background: rgba(26, 21, 16, 0.5);
  z-index: 99;
}
.session-drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 80%;
  max-width: 560rpx;
  background: var(--paper);
  z-index: 100;
  transform: translateX(100%);
  transition: transform 0.25s ease;
  display: flex;
  flex-direction: column;
  border-left: 4rpx solid var(--seal);
}
.session-drawer.show {
  transform: translateX(0);
}
.drawer-header {
  padding: 32rpx;
  border-bottom: 2rpx solid var(--seal);
  background: var(--paper-3);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}
.drawer-title {
  font-family: var(--font-kai);
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 4rpx;
}
.new-session-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: var(--seal);
  color: #fff;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-family: var(--font-kai);
  letter-spacing: 1rpx;
}
.plus-icon { font-size: 28rpx; }

.drawer-scroll {
  flex: 1;
  height: 0;
  padding: 16rpx;
}
.drawer-empty {
  text-align: center;
  color: var(--ink-soft);
  padding: 80rpx 0;
  font-size: 26rpx;
  font-family: var(--font-kai);
  letter-spacing: 2rpx;
}

.session-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  background: var(--paper-2);
  border: 1rpx solid var(--line);
  position: relative;
}
.session-item.current {
  background: var(--paper-3);
  border: 2rpx solid var(--seal);
}
.session-info {
  flex: 1;
  overflow: hidden;
}
.session-title {
  font-family: var(--font-song);
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.session-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
}
.meta-tag {
  font-family: var(--font-kai);
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  color: #fff;
  letter-spacing: 1rpx;
}
.meta-tag.type-general    { background: var(--ink-soft); }
.meta-tag.type-genealogy  { background: var(--seal); }
.meta-tag.type-ancient    { background: #4a6b3a; }
.meta-count {
  font-size: 22rpx;
  color: var(--ink-soft);
  opacity: 0.7;
}
.session-delete {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-soft);
  font-size: 28rpx;
}
