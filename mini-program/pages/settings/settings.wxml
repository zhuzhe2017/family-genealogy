<view class="page-container">
  <!-- 通用设置 -->
  <view class="settings-group">
    <text class="settings-title">通用</text>
    <view class="settings-item">
      <view class="settings-icon">🔔</view>
      <text class="settings-text">消息通知</text>
      <switch class="switch-control" checked="{{notification}}" bindchange="toggleNotification"/>
    </view>
    <view class="settings-item" bindtap="clearCache">
      <view class="settings-icon">🗑️</view>
      <text class="settings-text">清理缓存</text>
      <text class="settings-value">12.5MB</text>
      <text class="settings-arrow">›</text>
    </view>
  </view>

  <!-- 隐私设置 -->
  <view class="settings-group">
    <text class="settings-title">隐私</text>
    <view class="settings-item" bindtap="setPrivacy">
      <view class="settings-icon">🔒</view>
      <text class="settings-text">隐私设置</text>
      <text class="settings-arrow">›</text>
    </view>
    <view class="settings-item" bindtap="setPassword">
      <view class="settings-icon">🔑</view>
      <text class="settings-text">修改密码</text>
      <text class="settings-arrow">›</text>
    </view>
  </view>

  <!-- 关于 -->
  <view class="settings-group">
    <text class="settings-title">关于</text>
    <view class="settings-item" bindtap="showAbout">
      <view class="settings-icon">ℹ️</view>
      <text class="settings-text">关于数字家谱</text>
      <text class="settings-value">v1.0.0</text>
      <text class="settings-arrow">›</text>
    </view>
  </view>
</view>
