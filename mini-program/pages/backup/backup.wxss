.page-container {
  padding: 24rpx;
  background: #F5F5F5;
  min-height: 100vh;
  box-sizing: border-box;
}

.backup-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  text-align: center;
}

.backup-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(139, 26, 26, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  color: #8B1A1A;
  font-size: 60rpx;
}

.backup-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.backup-desc {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 32rpx;
}

.backup-btn {
  width: 100%;
  height: 88rpx;
  background: #8B1A1A;
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.backup-btn::after {
  border: none;
}

.restore-btn {
  width: 100%;
  height: 88rpx;
  background: #FFFFFF;
  color: #8B1A1A;
  border: 2rpx solid #8B1A1A;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  margin-top: 20rpx;
}

.restore-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
  display: block;
}

.restore-btn::after {
  border: none;
}

.record-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.record-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  display: block;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-info {
  flex: 1;
}

.record-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-status {
  font-size: 24rpx;
  color: #8B1A1A;
}

.record-status-fail {
  color: #E64340;
}

.offline-tip {
  background: #FFF7E6;
  color: #B27A0A;
  font-size: 24rpx;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.record-empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 48rpx 0;
}
