.splash-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 山水背景层 */
.splash-bg {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 60%;
  opacity: 0.15;
}

.mountain-layer {
  position: absolute;
  bottom: 0;
  width: 120%;
  height: 100%;
  background: #000;
  border-radius: 100% 100% 0 0;
}

.layer-1 {
  left: -10%;
  height: 80%;
  background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.3) 100%);
}

.layer-2 {
  left: -5%;
  height: 60%;
  background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.5) 100%);
}

.layer-3 {
  left: 0;
  height: 40%;
  background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.7) 100%);
}

/* 内容区 */
.splash-content {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 0 60rpx;
  box-sizing: border-box;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}

.logo-ring {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(201, 169, 110, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  position: relative;
}

.logo-ring::before {
  content: '';
  position: absolute;
  inset: 8rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(201, 169, 110, 0.3);
}

.logo-inner {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A 0%, #6B0F0F 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(139, 26, 26, 0.4);
}

.logo-text {
  font-size: 72rpx;
  color: #FFFFFF;
  font-weight: bold;
  font-family: 'KaiTi', 'STKaiti', serif;
}

.brand-name {
  font-size: 52rpx;
  color: #FFFFFF;
  font-weight: bold;
  letter-spacing: 8rpx;
  margin-bottom: 16rpx;
  font-family: 'KaiTi', 'STKaiti', serif;
}

.brand-slogan {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 4rpx;
}

/* 底部按钮 */
.splash-footer {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.start-btn {
  width: 80%;
  height: 96rpx;
  background: linear-gradient(135deg, #8B1A1A 0%, #B22222 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(139, 26, 26, 0.4);
  margin-bottom: 40rpx;
  transition: all 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.start-btn::after {
  border: none;
}

.start-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(139, 26, 26, 0.3);
}

.version-info {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* 水墨粒子 */
.ink-particles {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
}

.particle {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: rgba(201, 169, 110, 0.4);
  border-radius: 50%;
  animation: float 6s ease-in-out infinite;
}

.particle:nth-child(1) { left: 10%; top: 20%; }
.particle:nth-child(2) { left: 30%; top: 40%; animation-duration: 8s; }
.particle:nth-child(3) { left: 50%; top: 15%; animation-duration: 7s; }
.particle:nth-child(4) { left: 70%; top: 50%; animation-duration: 9s; }
.particle:nth-child(5) { left: 85%; top: 25%; animation-duration: 6s; }
.particle:nth-child(6) { left: 20%; top: 60%; animation-duration: 10s; }
.particle:nth-child(7) { left: 60%; top: 70%; animation-duration: 7s; }
.particle:nth-child(8) { left: 90%; top: 80%; animation-duration: 8s; }

@keyframes float {
  0%, 100% { transform: translateY(0) translateX(0); opacity: 0; }
  50% { transform: translateY(-100rpx) translateX(20rpx); opacity: 0.6; }
}
