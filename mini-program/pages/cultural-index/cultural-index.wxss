/* pages/cultural-index/cultural-index.wxss */
.container {
  min-height: 100vh;
  background: #f7f3ed;
  padding-bottom: 40rpx;
}

/* Tabs */
.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
}
.tab-item.active {
  color: #8B1A1A;
  font-weight: 600;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #8B1A1A;
  border-radius: 2rpx;
}

/* 搜索 */
.search-bar {
  padding: 20rpx 24rpx;
  background: #fff;
}
.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.clear-btn {
  padding: 0 12rpx;
  font-size: 32rpx;
}

/* 列表 */
.doc-list {
  padding: 16rpx;
}
.doc-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.cover-wrap {
  width: 160rpx;
  height: 220rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  position: relative;
  background: #e8e0d0;
}
.cover-img {
  width: 100%;
  height: 100%;
}
.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #d4c4a8, #e8dcc8);
}
.placeholder-icon {
  font-size: 60rpx;
}
.type-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  color: #fff;
  font-weight: 500;
}
.type-genealogy { background: #8B1A1A; }
.type-ancient { background: #2d6a4f; }
.type-handwritten { background: #b5651d; }

.doc-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}
.doc-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c1810;
  margin-bottom: 8rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.doc-meta {
  font-size: 24rpx;
  color: #8b7355;
  margin-bottom: 4rpx;
}
.doc-summary {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex: 1;
}
.doc-stats {
  margin-top: auto;
  padding-top: 8rpx;
}
.stat-item {
  font-size: 22rpx;
  color: #aaa;
}

/* 状态 */
.loading, .empty-tip, .no-more {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}
.no-more {
  padding: 40rpx 0 60rpx;
}
