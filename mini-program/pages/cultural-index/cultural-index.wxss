/* pages/cultural-index/cultural-index.wxss — 识典古籍古典风格（v1.1） */

.container {
  min-height: 100vh;
  background: var(--paper);          /* 米黄纸 */
  padding-bottom: 40rpx;
}

/* Tabs — 古典 header 风格 */
.tabs {
  display: flex;
  background: var(--paper-3);        /* 深米黄 */
  border-bottom: 2rpx solid var(--seal);   /* 印章朱底边线 */
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: var(--ink-soft);
  position: relative;
  font-family: var(--font-kai);
  letter-spacing: 2rpx;
}
.tab-item.active {
  color: var(--seal);                /* 印章朱 */
  font-weight: 700;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 6rpx;
  background: var(--seal);
  border-radius: 2rpx;
}

/* 搜索 */
.search-bar {
  padding: 20rpx 24rpx;
  background: var(--paper);
}
.search-input-wrap {
  display: flex;
  align-items: center;
  background: var(--paper-2);
  border: 1rpx solid var(--line);
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
  font-family: var(--font-song);
}
.clear-btn {
  padding: 0 12rpx;
  font-size: 32rpx;
  color: var(--ink-soft);
}

/* 列表 */
.doc-list {
  padding: 16rpx;
}
.doc-card {
  display: flex;
  background: var(--paper-2);
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 2rpx 12rpx rgba(44, 24, 16, 0.05);
  position: relative;
  overflow: hidden;
}
/* 卡片四角印章装饰 */
.doc-card::before {
  content: '';
  position: absolute;
  top: 8rpx; left: 8rpx;
  width: 24rpx; height: 24rpx;
  border-top: 2rpx solid var(--seal);
  border-left: 2rpx solid var(--seal);
  opacity: 0.35;
}
.doc-card::after {
  content: '';
  position: absolute;
  bottom: 8rpx; right: 8rpx;
  width: 24rpx; height: 24rpx;
  border-bottom: 2rpx solid var(--seal);
  border-right: 2rpx solid var(--seal);
  opacity: 0.35;
}

.cover-wrap {
  width: 160rpx;
  height: 220rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  position: relative;
  background: var(--paper-3);
  border: 1rpx solid var(--line-strong);
}
.cover-img {
  width: 100%;
  height: 100%;
}
.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--paper-3), var(--line));
}
.placeholder-icon {
  font-size: 60rpx;
  filter: sepia(0.5);
}

/* 类型徽章 — 印章风格 */
.type-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  color: #fff;
  font-weight: 500;
  font-family: var(--font-kai);
  letter-spacing: 2rpx;
}
.type-genealogy { background: var(--seal); }
.type-ancient { background: #4a6b3a; }
.type-handwritten { background: #8b6914; }

.doc-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}
.doc-title {
  font-family: var(--font-kai);
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.doc-meta {
  font-size: 24rpx;
  color: var(--ink-soft);
  margin-bottom: 4rpx;
  font-family: var(--font-song);
}
.doc-summary {
  font-family: var(--font-song);
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.8;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex: 1;
}
.doc-stats {
  margin-top: auto;
  padding-top: 8rpx;
}
.stat-item {
  font-size: 22rpx;
  color: var(--ink-soft);
  opacity: 0.7;
}

/* 状态提示 */
.loading, .empty-tip, .no-more {
  text-align: center;
  padding: 80rpx 0;
  color: var(--ink-soft);
  font-size: 28rpx;
  font-family: var(--font-kai);
  letter-spacing: 4rpx;
}
.no-more {
  padding: 40rpx 0 60rpx;
  color: var(--line-strong);
}
