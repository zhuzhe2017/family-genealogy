.page-container {
  background: #1a1a2e;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 祭祀场景 */
.worship-scene {
  position: relative;
  height: 500rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.scene-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #1a1a2e 0%, #2d1f1f 50%, #1a1a2e 100%);
}

/* 香烟动画 */
.incense-smoke {
  position: absolute;
  bottom: 100rpx;
  left: 50%;
  width: 4rpx;
  height: 100rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.3), transparent);
  border-radius: 50%;
  animation: smoke 3s ease-in-out infinite;
  filter: blur(4rpx);
}

.incense-smoke.smoke-2 {
  left: 45%;
  animation-delay: 1s;
  height: 80rpx;
}

@keyframes smoke {
  0%, 100% { opacity: 0; transform: translateY(0) scaleX(1); }
  50% { opacity: 0.6; transform: translateY(-60rpx) scaleX(3); }
}

/* 祭坛 */
.altar {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.altar-table {
  width: 400rpx;
  height: 120rpx;
  background: linear-gradient(180deg, #4a3728, #3d2e20);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  position: relative;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.4);
}

.altar-table::before {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 20rpx;
  right: 20rpx;
  height: 16rpx;
  background: linear-gradient(180deg, #5a4535, #4a3728);
  border-radius: 4rpx;
}

.incense-burner {
  display: flex;
  gap: 16rpx;
  align-items: flex-end;
}

.incense-stick {
  width: 6rpx;
  height: 60rpx;
  background: linear-gradient(180deg, #8B4513, #D2691E);
  border-radius: 3rpx;
  position: relative;
}

.incense-stick::after {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 16rpx;
  background: #FF6B35;
  border-radius: 50%;
  box-shadow: 0 0 20rpx #FF6B35;
  animation: glow 2s ease-in-out infinite;
}

@keyframes glow {
  0%, 100% { opacity: 0.6; box-shadow: 0 0 10rpx #FF6B35; }
  50% { opacity: 1; box-shadow: 0 0 30rpx #FF6B35; }
}

.offerings {
  display: flex;
  gap: 12rpx;
}

.offering-item {
  font-size: 32rpx;
}

/* 祖先画像 */
.ancestor-portrait {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
}

.portrait-frame {
  width: 160rpx;
  height: 200rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #D4A574, #C9A96E);
  border: 4rpx solid #8B6914;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.3);
}

.portrait-text {
  font-size: 72rpx;
  color: #FFFFFF;
  font-weight: bold;
  font-family: 'KaiTi', serif;
  text-shadow: 2rpx 2rpx 4rpx rgba(0,0,0,0.3);
}

.ancestor-name {
  font-size: 28rpx;
  color: #D4A574;
  font-family: 'KaiTi', serif;
}

/* 祈福操作 */
.worship-actions {
  padding: 32rpx;
}

.action-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.action-row:last-child {
  margin-bottom: 0;
}

.worship-btn {
  flex: 1;
  background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(212, 165, 116, 0.2);
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.3s;
}

.worship-btn:active {
  background: rgba(139, 26, 26, 0.2);
  border-color: rgba(139, 26, 26, 0.4);
}

.btn-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.btn-label {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.btn-count {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
}

/* 祈福记录 */
.worship-records {
  margin: 0 24rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(255,255,255,0.1);
}

.records-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.records-title {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.records-more {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}

.records-list {
  display: flex;
  flex-direction: column;
}

/* 空态/加载/错误提示 */
.records-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
  color: rgba(255,255,255,0.4);
  font-size: 24rpx;
}

.records-empty-btn {
  margin-top: 20rpx;
  padding: 12rpx 48rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(212, 165, 116, 0.4);
  color: #D4A574;
  font-size: 26rpx;
}

/* ============ 纪念日提醒 ============ */
.reminder-section {
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(212, 165, 116, 0.18);
}

.reminder-header {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.reminder-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #F5E6D0;
}

.reminder-sub {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: rgba(245, 230, 208, 0.5);
}

.reminder-list {
  display: flex;
  flex-direction: column;
}

.reminder-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.reminder-item:last-child {
  border-bottom: none;
}

.reminder-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #D4A574;
  color: #1a1a2e;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.reminder-avatar.lock {
  background: rgba(212, 165, 116, 0.15);
  font-size: 32rpx;
}

.reminder-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.reminder-name {
  font-size: 28rpx;
  color: #F5E6D0;
}

.reminder-desc {
  font-size: 22rpx;
  color: rgba(245, 230, 208, 0.55);
  margin-top: 4rpx;
}

.reminder-days {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.reminder-today {
  font-size: 26rpx;
  font-weight: bold;
  color: #E8B88A;
}

.reminder-days-text {
  font-size: 24rpx;
  color: rgba(245, 230, 208, 0.7);
}

.reminder-lock-btn {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(212, 165, 116, 0.5);
  color: #D4A574;
  font-size: 24rpx;
}

/* ============ 纪念堂 ============ */
.memorial-section {
  margin: 24rpx 24rpx 0;
  padding: 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(212, 165, 116, 0.18);
}

.memorial-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.memorial-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #F5E6D0;
}

.memorial-add {
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(212, 165, 116, 0.5);
  color: #D4A574;
  font-size: 24rpx;
}

.memorial-scroll {
  white-space: nowrap;
}

.memorial-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
  margin-right: 20rpx;
  padding: 20rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  position: relative;
  vertical-align: top;
}

.memorial-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #3a2a1a;
  border: 2rpx solid #D4A574;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #D4A574;
  font-size: 40rpx;
  font-weight: bold;
}

.memorial-avatar image {
  width: 100%;
  height: 100%;
}

.memorial-name {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: #F5E6D0;
  font-weight: bold;
}

.memorial-life {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: rgba(255,255,255,0.45);
}

.memorial-epitaph {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(212, 165, 116, 0.9);
  white-space: normal;
  text-align: center;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}

.memorial-del {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  background: rgba(0,0,0,0.25);
  border-radius: 50%;
}

.memorial-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  color: rgba(255,255,255,0.4);
  font-size: 24rpx;
}

.memorial-empty-btn {
  margin-top: 16rpx;
  padding: 10rpx 44rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(212, 165, 116, 0.4);
  color: #D4A574;
  font-size: 24rpx;
}

/* ============ 已故成员选择弹层 ============ */
.member-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.member-picker-panel {
  width: 100%;
  max-height: 65vh;
  background: #2a1d12;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.member-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(212, 165, 116, 0.2);
}

.member-picker-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #F5E6D0;
}

.member-picker-close {
  font-size: 26rpx;
  color: rgba(255,255,255,0.5);
}

.member-picker-list {
  max-height: 52vh;
}

.member-picker-item {
  display: flex;
  align-items: center;
  padding: 22rpx 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.member-picker-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #3a2a1a;
  border: 2rpx solid #D4A574;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #D4A574;
  font-size: 30rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.member-picker-avatar image {
  width: 100%;
  height: 100%;
}

.member-picker-info {
  display: flex;
  flex-direction: column;
}

.member-picker-name {
  font-size: 28rpx;
  color: #F5E6D0;
}

.member-picker-life {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.45);
}

.member-picker-tip {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
}

.record-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}

.record-item:last-child {
  border-bottom: none;
}

.record-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.record-avatar text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.record-user {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.record-time {
  font-size: 20rpx;
  color: rgba(255,255,255,0.4);
}

.record-content {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
