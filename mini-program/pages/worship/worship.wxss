.page-container {
  background: #1a1a2e;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 祭祀场景 */
.worship-scene {
  position: relative;
  height: 500rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.scene-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #1a1a2e 0%, #2d1f1f 50%, #1a1a2e 100%);
}

/* 香烟动画 */
.incense-smoke {
  position: absolute;
  bottom: 100rpx;
  left: 50%;
  width: 4rpx;
  height: 100rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.3), transparent);
  border-radius: 50%;
  animation: smoke 3s ease-in-out infinite;
  filter: blur(4rpx);
}

.incense-smoke.smoke-2 {
  left: 45%;
  animation-delay: 1s;
  height: 80rpx;
}

@keyframes smoke {
  0%, 100% { opacity: 0; transform: translateY(0) scaleX(1); }
  50% { opacity: 0.6; transform: translateY(-60rpx) scaleX(3); }
}

/* 祭坛 */
.altar {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.altar-table {
  width: 400rpx;
  height: 120rpx;
  background: linear-gradient(180deg, #4a3728, #3d2e20);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  position: relative;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.4);
}

.altar-table::before {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 20rpx;
  right: 20rpx;
  height: 16rpx;
  background: linear-gradient(180deg, #5a4535, #4a3728);
  border-radius: 4rpx;
}

.incense-burner {
  display: flex;
  gap: 16rpx;
  align-items: flex-end;
}

.incense-stick {
  width: 6rpx;
  height: 60rpx;
  background: linear-gradient(180deg, #8B4513, #D2691E);
  border-radius: 3rpx;
  position: relative;
}

.incense-stick::after {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 16rpx;
  background: #FF6B35;
  border-radius: 50%;
  box-shadow: 0 0 20rpx #FF6B35;
  animation: glow 2s ease-in-out infinite;
}

@keyframes glow {
  0%, 100% { opacity: 0.6; box-shadow: 0 0 10rpx #FF6B35; }
  50% { opacity: 1; box-shadow: 0 0 30rpx #FF6B35; }
}

.offerings {
  display: flex;
  gap: 12rpx;
}

.offering-item {
  font-size: 32rpx;
}

/* 祖先画像 */
.ancestor-portrait {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
}

.portrait-frame {
  width: 160rpx;
  height: 200rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #D4A574, #C9A96E);
  border: 4rpx solid #8B6914;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.3);
}

.portrait-text {
  font-size: 72rpx;
  color: #FFFFFF;
  font-weight: bold;
  font-family: 'KaiTi', serif;
  text-shadow: 2rpx 2rpx 4rpx rgba(0,0,0,0.3);
}

.ancestor-name {
  font-size: 28rpx;
  color: #D4A574;
  font-family: 'KaiTi', serif;
}

/* 祈福操作 */
.worship-actions {
  padding: 32rpx;
}

.action-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.action-row:last-child {
  margin-bottom: 0;
}

.worship-btn {
  flex: 1;
  background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(212, 165, 116, 0.2);
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.3s;
}

.worship-btn:active {
  background: rgba(139, 26, 26, 0.2);
  border-color: rgba(139, 26, 26, 0.4);
}

.btn-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.btn-label {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.btn-count {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
}

/* 祈福记录 */
.worship-records {
  margin: 0 24rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(255,255,255,0.1);
}

.records-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.records-title {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.records-more {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}

.records-list {
  display: flex;
  flex-direction: column;
}

.record-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.05);
}

.record-item:last-child {
  border-bottom: none;
}

.record-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.record-avatar text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.record-user {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.record-time {
  font-size: 20rpx;
  color: rgba(255,255,255,0.4);
}

.record-content {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
