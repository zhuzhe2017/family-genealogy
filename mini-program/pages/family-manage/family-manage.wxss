.page-container {
  padding: 24rpx;
  padding-bottom: 40rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

/* 家族信息卡片 */
.family-info-card {
  background: linear-gradient(135deg, #8B1A1A 0%, #6B0F0F 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(139, 26, 26, 0.2);
}

.family-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.family-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  border: 2rpx solid rgba(255,255,255,0.3);
}

.family-logo text {
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: bold;
  font-family: 'KaiTi', serif;
}

.family-detail {
  flex: 1;
}

.family-name {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.family-meta {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.family-stats {
  display: flex;
  justify-content: space-around;
  background: rgba(255,255,255,0.1);
  border-radius: 16rpx;
  padding: 20rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

/* 管理区域 */
.manage-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.manage-group {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.manage-title {
  font-size: 24rpx;
  color: #999;
  padding: 20rpx 24rpx;
  background: #FAFAFA;
}

.manage-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.manage-item:last-child {
  border-bottom: none;
}

.manage-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  width: 48rpx;
  text-align: center;
}

.manage-info {
  flex: 1;
}

.manage-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.manage-desc {
  font-size: 22rpx;
  color: #999;
}

.manage-arrow {
  font-size: 32rpx;
  color: #CCC;
  margin-left: 16rpx;
}
