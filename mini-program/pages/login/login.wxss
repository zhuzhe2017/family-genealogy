.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #8B1A1A 0%, #8B1A1A 34%, #F5F5F5 34.1%);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 64rpx 60rpx;
}

/* ---------- 品牌区 ---------- */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 80rpx;
}

.brand-logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  background: #FFF;
  color: #8B1A1A;
  font-size: 72rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.18);
  margin-bottom: 24rpx;
}

.brand-title {
  color: #FFF;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.brand-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 24rpx;
}

/* ---------- 表单卡片 ---------- */
.login-form {
  width: 100%;
  background: #FFF;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

.form-tip {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.input-row {
  display: flex;
  align-items: center;
  height: 96rpx;
  border-bottom: 1rpx solid #EEEEEE;
  margin-bottom: 24rpx;
}

.input-prefix {
  font-size: 28rpx;
  color: #333;
  width: 96rpx;
  flex-shrink: 0;
}

.input-main {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  height: 100%;
}

.code-btn {
  background: #FDF1F1;
  color: #8B1A1A;
  font-size: 24rpx;
  border-radius: 32rpx;
  padding: 0 24rpx;
  line-height: 56rpx;
  height: 56rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.code-btn::after {
  border: none;
}

.code-btn-disabled {
  background: #F2F2F2;
  color: #999;
}

/* ---------- 协议 ---------- */
.agreement {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin: 8rpx 0 32rpx;
  font-size: 22rpx;
}

.agree-box {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #CCCCCC;
  border-radius: 50%;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.agree-box-active {
  background: #8B1A1A;
  border-color: #8B1A1A;
}

.agree-check {
  color: #FFF;
  font-size: 22rpx;
}

.agree-text {
  color: #999;
}

.agree-link {
  color: #8B1A1A;
  margin: 0 4rpx;
}

/* ---------- 主按钮 ---------- */
.primary-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: #8B1A1A;
  color: #FFF;
  font-size: 32rpx;
  font-weight: 500;
  padding: 0;
}

.primary-btn::after {
  border: none;
}

.primary-btn-disabled {
  background: #C9A6A6;
}

/* ---------- 分隔线 ---------- */
.divider {
  display: flex;
  align-items: center;
  width: 100%;
  margin: 56rpx 0 40rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #DDDDDD;
}

.divider-text {
  color: #999;
  font-size: 24rpx;
  margin: 0 24rpx;
}

/* ---------- 微信登录 ---------- */
.wx-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: #FFF;
  color: #333;
  font-size: 30rpx;
  border: 1rpx solid #E5E5E5;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.wx-btn::after {
  border: none;
}

.wx-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  background: #22C55E;
  color: #FFF;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

/* ---------- 底部 ---------- */
.login-footer {
  margin-top: 48rpx;
  text-align: center;
}

.footer-tip {
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}
