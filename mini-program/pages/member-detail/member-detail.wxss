.page-container {
  padding-bottom: 140rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

/* 头部 */
.detail-header {
  position: relative;
  background: linear-gradient(135deg, #8B1A1A 0%, #6B0F0F 100%);
  padding: 60rpx 32rpx 80rpx;
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0.1;
}

.header-pattern {
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  border: 80rpx solid rgba(255,255,255,0.1);
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.member-avatar-large {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D4A574, #C9A96E);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 32rpx;
  border: 4rpx solid rgba(255,255,255,0.3);
  flex-shrink: 0;
}

.member-avatar-large.female {
  background: linear-gradient(135deg, #FF6B9D, #FFB6C1);
}

.member-avatar-large text {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: bold;
  font-family: 'KaiTi', serif;
}

.member-header-info {
  flex: 1;
}

.member-header-name {
  font-size: 44rpx;
  color: #FFFFFF;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
  font-family: 'KaiTi', serif;
}

.member-header-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.header-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.2);
  color: #FFFFFF;
}

.header-tag.tag-alive {
  background: rgba(76, 175, 80, 0.3);
}

/* 信息卡片 */
.info-card {
  margin: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  position: relative;
  padding-left: 20rpx;
}

.card-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: #8B1A1A;
  border-radius: 3rpx;
}

.info-rows {
  display: flex;
  flex-direction: column;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.info-row:last-child {
  border-bottom: none;
}

.row-label {
  font-size: 28rpx;
  color: #666;
}

.row-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 关系区块 */
.relation-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.relation-block {
  display: flex;
  flex-direction: column;
}

.relation-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.relation-person {
  display: flex;
  align-items: center;
  background: #F8F8F8;
  border-radius: 16rpx;
  padding: 20rpx;
}

.relation-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.relation-avatar.female {
  background: linear-gradient(135deg, #FF6B9D, #FFB6C1);
}

.relation-avatar text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
  font-family: 'KaiTi', serif;
}

.relation-info {
  flex: 1;
}

.relation-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.relation-desc {
  font-size: 22rpx;
  color: #999;
}

.relation-arrow {
  font-size: 32rpx;
  color: #CCC;
  margin-left: 16rpx;
}

/* 子女网格 */
.children-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.child-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  background: #F8F8F8;
  border-radius: 16rpx;
}

.child-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.child-avatar.female {
  background: linear-gradient(135deg, #FF6B9D, #FFB6C1);
}

.child-avatar text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
  font-family: 'KaiTi', serif;
}

.child-name {
  font-size: 24rpx;
  color: #333;
}

/* 简介 */
.bio-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* 照片网格 */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.photo-item {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
}

/* 底部操作 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.action-btn.secondary {
  background: #F5F5F5;
  color: #333;
}

.action-btn.primary {
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  color: #FFFFFF;
}
