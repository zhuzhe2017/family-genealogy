<wxs src="../../utils/filters.wxs" module="f" />
<view class="page-container">
  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">加载中...</view>
  <!-- 加载失败 -->
  <view class="error-state" wx:elif="{{loadFailed}}">
    <text>加载失败，请返回重试</text>
  </view>
  <!-- 正常内容 -->
  <block wx:else>
  <!-- 头部背景 -->
  <view class="detail-header">
    <view class="header-bg">
      <view class="header-pattern"></view>
    </view>
    <view class="header-content">
      <view class="member-avatar-large {{member.gender === 'female' ? 'female' : ''}}">
        <image wx:if="{{member.avatar}}" src="{{member.avatar}}" mode="aspectFill" class="member-avatar-img"/>
        <text wx:else>{{f.firstChar(member.name)}}</text>
      </view>
      <view class="member-header-info">
        <text class="member-header-name">{{member.name}}</text>
        <view class="member-header-tags">
          <text class="header-tag" wx:if="{{member.generationName}}">{{member.generationName}}字辈</text>
          <text class="header-tag">{{member.generation}}代</text>
          <text class="header-tag">{{member.gender === 'female' ? '女性' : '男性'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="info-card">
    <view class="card-title">基本信息</view>
    <view class="info-rows">
      <view class="info-row" wx:if="{{member.id}}">
        <text class="row-label">成员ID</text>
        <view class="row-value-with-action">
          <text class="row-value row-value-mono">{{member.id}}</text>
          <view class="copy-btn" bindtap="copyMemberId" data-id="{{member.id}}" role="button" aria-label="复制成员ID">
            <text class="copy-btn-text">{{copied ? '已复制' : '复制'}}</text>
          </view>
        </view>
      </view>
      <view class="info-row">
        <text class="row-label">姓名</text>
        <text class="row-value">{{member.name}}</text>
      </view>
      <view class="info-row" wx:if="{{member.generationName}}">
        <text class="row-label">字辈</text>
        <text class="row-value">{{member.generationName}}字辈</text>
      </view>
      <view class="info-row">
        <text class="row-label">性别</text>
        <text class="row-value">{{member.gender === 'female' ? '女' : '男'}}</text>
      </view>
      <view class="info-row">
        <text class="row-label">出生年月</text>
        <text class="row-value">{{member.birthDate || '未知'}}</text>
      </view>
      <view class="info-row" wx:if="{{member.deathDate}}">
        <text class="row-label">逝世日期</text>
        <text class="row-value">{{member.deathDate}}</text>
      </view>
      <view class="info-row">
        <text class="row-label">居住地</text>
        <text class="row-value">{{member.birthPlace || '未知'}}</text>
      </view>
    </view>
  </view>

  <!-- 配偶信息（支持多位配偶循环展示） -->
  <view class="info-card" wx:if="{{member.spouseList && member.spouseList.length}}">
    <view class="card-title">配偶信息</view>
    <view class="spouse-block" wx:for="{{member.spouseList}}" wx:for-item="sp" wx:for-index="si" wx:key="name">
      <view class="spouse-block-title">
        <text class="spouse-name">{{sp.name}}</text>
        <text class="spouse-count" wx:if="{{member.spouseList.length > 1}}">第{{si + 1}}位配偶</text>
      </view>
      <view class="info-rows">
        <view class="info-row" wx:if="{{sp.birthDate}}">
          <text class="row-label">出生日期</text>
          <text class="row-value">{{sp.birthDate}}</text>
        </view>
        <view class="info-row" wx:if="{{sp.deathDate}}">
          <text class="row-label">逝世日期</text>
          <text class="row-value">{{sp.deathDate}}</text>
        </view>
        <view class="info-row" wx:if="{{sp.deathPlace}}">
          <text class="row-label">安葬地点</text>
          <text class="row-value">{{sp.deathPlace}}</text>
        </view>
        <view class="info-row" wx:if="{{sp.longitude && sp.latitude}}">
          <text class="row-label">墓茔坐标</text>
          <text class="row-value">{{sp.longitude}}, {{sp.latitude}}</text>
        </view>
        <view class="info-row" wx:if="{{sp.bio}}">
          <text class="row-label">简介</text>
          <text class="row-value">{{sp.bio}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 家庭关系 -->
  <view class="info-card">
    <view class="card-title">家庭关系</view>
    <view class="relation-section">
      <!-- 配偶（多位配偶循环展示，点击展开/收起详情） -->
      <view class="relation-block" wx:if="{{member.spouseList && member.spouseList.length}}">
        <text class="relation-label">配偶</text>
        <view class="relation-person" wx:for="{{member.spouseList}}" wx:for-item="sp" wx:for-index="si" wx:key="name" data-index="{{si}}" bindtap="viewSpouse">
          <view class="relation-avatar {{member.gender === 'male' ? 'female' : ''}}">
            <text>{{f.firstChar(sp.name || '配')}}</text>
          </view>
          <view class="relation-info">
            <text class="relation-name">{{sp.name || '本族成员'}}</text>
            <text class="relation-desc">{{sp.birthDate ? '生于' + sp.birthDate : ''}}{{sp.deathDate ? ' · 逝于' + sp.deathDate : ''}}</text>
          </view>
          <text class="relation-arrow">{{sp.collapsed ? '›' : '⌄'}}</text>
        </view>
        <!-- 配偶详细信息（展开时显示） -->
        <view class="spouse-detail-panel" wx:for="{{member.spouseList}}" wx:for-item="sp" wx:for-index="si" wx:key="name" wx:if="{{!sp.collapsed}}">
          <view class="spouse-detail-row" wx:if="{{sp.birthDate}}">
            <text class="detail-label">出生日期</text>
            <text class="detail-value">{{sp.birthDate}}</text>
          </view>
          <view class="spouse-detail-row" wx:if="{{sp.deathDate}}">
            <text class="detail-label">逝世日期</text>
            <text class="detail-value">{{sp.deathDate}}</text>
          </view>
          <view class="spouse-detail-row" wx:if="{{sp.deathPlace}}">
            <text class="detail-label">安葬地点</text>
            <text class="detail-value">{{sp.deathPlace}}</text>
          </view>
          <view class="spouse-detail-row" wx:if="{{sp.longitude && sp.latitude}}">
            <text class="detail-label">墓茔坐标</text>
            <text class="detail-value">{{sp.longitude}}, {{sp.latitude}}</text>
          </view>
          <view class="spouse-detail-row" wx:if="{{sp.bio}}">
            <text class="detail-label">简介</text>
            <text class="detail-value">{{sp.bio}}</text>
          </view>
        </view>
      </view>

      <!-- 父母 -->
      <view class="relation-block" wx:if="{{member.father || member.mother}}">
        <text class="relation-label">父母</text>
        <view class="relation-person" wx:if="{{member.father}}" bindtap="viewParent" data-id="{{member.fatherId}}">
          <view class="relation-avatar">
            <text>{{f.firstChar(member.father)}}</text>
          </view>
          <view class="relation-info">
            <text class="relation-name">{{member.father}}</text>
            <text class="relation-desc">父亲</text>
          </view>
          <text class="relation-arrow">›</text>
        </view>
        <view class="relation-person" wx:if="{{member.mother}}" bindtap="viewParent" data-id="{{member.motherId}}">
          <view class="relation-avatar female">
            <text>{{f.firstChar(member.mother)}}</text>
          </view>
          <view class="relation-info">
            <text class="relation-name">{{member.mother}}</text>
            <text class="relation-desc">母亲</text>
          </view>
          <text class="relation-arrow">›</text>
        </view>
      </view>

      <!-- 子女 -->
      <view class="relation-block" wx:if="{{member.children && member.children.length > 0}}">
        <text class="relation-label">子女 ({{member.children.length}}人)</text>
        <view class="children-grid">
          <view class="child-item" wx:for="{{member.children}}" wx:key="id" bindtap="viewChild" data-id="{{item.id}}">
            <view class="child-avatar {{item.gender === 'female' ? 'female' : ''}}">
              <text>{{f.firstChar(item.name)}}</text>
            </view>
            <text class="child-name">{{item.name}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 个人简介 -->
  <view class="info-card" wx:if="{{member.bio}}">
    <view class="card-title">个人简介</view>
    <text class="bio-text">{{member.bio}}</text>
  </view>

  <!-- 相关照片 -->
  <view class="info-card" wx:if="{{member.photos && member.photos.length > 0}}">
    <view class="card-title">相关照片</view>
    <view class="photo-grid">
      <image class="photo-item" wx:for="{{member.photos}}" wx:key="*this" src="{{item}}" mode="aspectFill" bindtap="previewPhoto"/>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-actions safe-bottom">
    <view class="action-btn secondary" wx:if="{{member.canEdit}}" bindtap="editMember">
      <text>编辑</text>
    </view>
    <view class="action-btn primary" bindtap="shareMember">
      <text>分享</text>
    </view>
  </view>
  </block>
</view>
