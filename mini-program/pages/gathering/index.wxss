.page {
  min-height: 100vh;
  background: #F5F1EA;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.page-header {
  padding: 24rpx 32rpx 8rpx;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.page-sub {
  font-size: 24rpx;
  color: #999;
}

/* 状态筛选 */
.tab-bar {
  display: flex;
  padding: 16rpx 24rpx;
  gap: 12rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.tab-item {
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  background: #FFF;
  font-size: 26rpx;
  color: #666;
}

.tab-item.active {
  background: #8B1A1A;
  color: #FFF;
}

/* 列表 */
.list {
  padding: 8rpx 24rpx;
}

.card {
  background: #FFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.s0 { background: #ECEFF1; color: #607D8B; }
.s1 { background: #FFF3E0; color: #E65100; }
.s2 { background: #E3F2FD; color: #1565C0; }
.s3 { background: #EEEEEE; color: #757575; }
.s4 { background: #E8F5E9; color: #2E7D32; }

.card-row {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #555;
  margin-bottom: 8rpx;
}

.row-icon {
  margin-right: 10rpx;
}

.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.card-count {
  font-size: 24rpx;
  color: #8B1A1A;
}

.card-arrow {
  font-size: 32rpx;
  color: #BBB;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.load-more {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #8B1A1A;
}

/* 发布按钮（浮动 + 号） */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  width: 110rpx;
  height: 110rpx;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  color: #FFF;
  font-size: 60rpx;
  font-weight: 400;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(139, 26, 26, 0.35);
  z-index: 10;
}
