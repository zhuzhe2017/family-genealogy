.container {
  min-height: 100vh;
  background: #F5F5F5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.loading-box,
.error-box {
  text-align: center;
}

.loading-icon {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #eee;
  border-top-color: #8B1A1A;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: #999;
  font-size: 28rpx;
}

.error-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  border-radius: 50%;
  background: #FFEBEE;
  color: #C62828;
  font-size: 60rpx;
  margin: 0 auto 24rpx;
  font-weight: 600;
}

.error-title {
  display: block;
  font-size: 34rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.error-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.error-btn {
  display: inline-block;
  padding: 18rpx 48rpx;
  background: #8B1A1A;
  color: #fff;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.invite-card {
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.family-logo-box {
  margin-bottom: 24rpx;
}

.family-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f5f5f5;
  margin: 0 auto;
}

.default-logo {
  background: linear-gradient(135deg, #8B1A1A 0%, #A52A2A 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  font-weight: 600;
}

.family-name {
  font-size: 40rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.inviter-row {
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.inviter-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.inviter-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #D4A574, #C9A96E);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: bold;
}

.inviter-text {
  font-size: 26rpx;
  color: #666;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
  font-size: 28rpx;
}

.info-label {
  color: #999;
}

.info-value {
  color: #333;
  font-weight: 500;
}

.action-box {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  text-align: center;
}

.btn.reject {
  background: #F0F0F0;
  color: #666;
}

.btn.accept {
  background: #8B1A1A;
  color: #fff;
}

.btn.disabled {
  opacity: 0.6;
}
