.page-container {
  padding-bottom: 140rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

.state-block {
  text-align: center;
  padding: 200rpx 0;
  font-size: 28rpx;
  color: #999;
}

/* 文档封面 */
.doc-cover-section {
  padding: 48rpx;
  display: flex;
  justify-content: center;
  background: linear-gradient(180deg, #8B1A1A 0%, #6B0F0F 100%);
}

.doc-cover-large {
  width: 280rpx;
  height: 380rpx;
  background: linear-gradient(135deg, #9B2A2A, #7B1F1F);
  border-radius: 8rpx;
  position: relative;
  box-shadow: 0 16rpx 40rpx rgba(0,0,0,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-spine {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 24rpx;
  background: linear-gradient(90deg, rgba(0,0,0,0.2), transparent);
  border-radius: 8rpx 0 0 8rpx;
}

.cover-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
}

.cover-title {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 500;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 16rpx;
  font-family: 'KaiTi', serif;
}

.cover-volume {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

/* 信息卡片 */
.info-card {
  margin: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.doc-title {
  font-size: 36rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.doc-description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  display: block;
  margin-bottom: 24rpx;
}

.doc-meta-list {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #F8F8F8;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
}

.meta-label {
  font-size: 24rpx;
  color: #999;
}

.meta-value {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  position: relative;
  padding-left: 20rpx;
}

.card-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: #8B1A1A;
  border-radius: 3rpx;
}

/* 目录列表 */
.toc-list {
  display: flex;
  flex-direction: column;
}

.toc-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.toc-item:last-child {
  border-bottom: none;
}

.toc-number {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(139, 26, 26, 0.1);
  color: #8B1A1A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 500;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.toc-info {
  flex: 1;
}

.toc-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.toc-pages {
  font-size: 22rpx;
  color: #999;
}

/* 底部操作 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.action-btn.secondary {
  background: #F5F5F5;
  color: #333;
}

.action-btn.primary {
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  color: #FFFFFF;
}
