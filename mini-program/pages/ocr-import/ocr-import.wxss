/* pages/ocr-import/ocr-import.wxss */
page { background: #f4f1ec; min-height: 100%; }
.ocr-wrap {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* ============ 步骤条 ============ */
.step-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 40rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}
.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  opacity: 0.4;
}
.step.active { opacity: 1; }
.step-ic {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #ddd;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}
.step.active .step-ic { background: #8B1A1A; }
.step text { font-size: 22rpx; color: #888; }
.step.active text { color: #2c1810; font-weight: 500; }

.step-line {
  width: 60rpx;
  height: 4rpx;
  background: #ddd;
  margin: 0 12rpx;
  margin-bottom: 28rpx;
}
.step-line.done { background: #8B1A1A; }

/* ============ Step 1 上传 ============ */
.step-content { padding: 32rpx 28rpx; }
.upload-area {
  background: #fff;
  border-radius: 20rpx;
  height: 440rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ccc;
  overflow: hidden;
}
.upload-area:active { border-color: #8B1A1A; }
.preview-img { width: 100%; max-height: 100%; }
.upload-emoji { font-size: 80rpx; }
.upload-text { font-size: 32rpx; font-weight: 500; color: #2c1810; margin-top: 16rpx; }
.upload-hint { font-size: 24rpx; color: #aaa; margin-top: 8rpx; }

.tips-box {
  margin-top: 28rpx;
  background: rgba(139, 26, 26, 0.05);
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  border-left: 6rpx solid #8B1A1A;
}
.tips-title { font-size: 26rpx; font-weight: 600; color: #8B1A1A; margin-bottom: 12rpx; }
.tip-item { font-size: 24rpx; color: #666; line-height: 1.8; }

.primary-btn {
  margin-top: 40rpx;
  background: #8B1A1A;
  color: #fff;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.primary-btn.disabled { background: #ccc; }
.primary-btn:active:not(.disabled) { opacity: 0.85; }

.secondary-btn {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #888;
  padding: 20rpx 0;
}

/* ============ Step 2 OCR 结果 ============ */
.ocr-box {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.box-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.box-title { font-size: 28rpx; font-weight: 600; color: #2c1810; }
.box-provider { font-size: 22rpx; color: #aaa; }
.ocr-text {
  max-height: 400rpx;
  background: #faf7f0;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}
.box-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8B1A1A;
  line-height: 1.6;
}

/* ============ Step 3 成员表格 ============ */
.members-box {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.members-scroll { max-height: 600rpx; }
.add-btn { font-size: 26rpx; color: #8B1A1A; }

.member-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f5f1ea;
}
.row-index {
  width: 60rpx;
  font-size: 24rpx;
  color: #aaa;
  text-align: center;
}
.row-fields {
  flex: 1;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 2fr;
  gap: 10rpx;
}
.field-input {
  font-size: 26rpx;
  padding: 12rpx 14rpx;
  background: #faf7f0;
  border-radius: 8rpx;
}
.row-del {
  width: 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: #ccc;
}

/* ============ 预览卡片 ============ */
.summary-card {
  background: linear-gradient(135deg, #8B1A1A 0%, #a83c3c 100%);
  border-radius: 16rpx;
  padding: 28rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.sum-title { font-size: 26rpx; margin-bottom: 16rpx; opacity: 0.9; }
.sum-row { display: flex; gap: 12rpx; }
.sum-item {
  flex: 1;
  text-align: center;
  background: rgba(255,255,255,0.15);
  border-radius: 8rpx;
  padding: 16rpx 8rpx;
}
.sum-num { font-size: 40rpx; font-weight: 700; }
.sum-label { font-size: 22rpx; opacity: 0.8; margin-top: 4rpx; }
.sum-item.good { background: rgba(45,106,79,0.4); }
.sum-item.warn { background: rgba(224,122,95,0.4); }
.sum-item.bad  { background: rgba(106,76,147,0.4); }

.preview-list { margin-bottom: 24rpx; }
.preview-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  border-left: 6rpx solid #e07a5f;
}
.preview-item.dup { border-left-color: #8B1A1A; }
.p-head { display: flex; justify-content: space-between; align-items: center; }
.p-name { font-size: 28rpx; font-weight: 600; color: #2c1810; }
.p-badge.dup {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #8B1A1A;
  color: #fff;
}
.p-warnings { margin-top: 12rpx; display: flex; flex-wrap: wrap; gap: 8rpx; }
.warning-chip {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  background: #fff3e0;
  color: #e07a5f;
  border-radius: 12rpx;
}

.result-card {
  background: #2d6a4f;
  border-radius: 16rpx;
  padding: 28rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.res-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.res-row { font-size: 26rpx; padding: 6rpx 0; }
.res-row.warn { color: #fef3c7; }
.res-row.bad  { color: #fecaca; }
.res-errors { margin-top: 12rpx; }
.res-err-item { font-size: 22rpx; opacity: 0.85; padding: 4rpx 0; }
