.page-container {
  padding: 24rpx 24rpx 160rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

.form-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.card-sub {
  font-size: 22rpx;
  color: #999;
  font-weight: normal;
  margin-left: 8rpx;
}

.form-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}

.form-label {
  width: 100rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 72rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  background: #F8F8F8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.form-textarea {
  flex: 1;
  min-height: 120rpx;
  background: #F8F8F8;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 日期选择 */
.date-pickers {
  flex: 1;
  display: flex;
  gap: 12rpx;
}

.date-picker {
  flex: 1;
  min-width: 0;
}

.picker-box {
  height: 72rpx;
  line-height: 72rpx;
  background: #F8F8F8;
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #333;
  text-align: center;
}

.picker-box.placeholder {
  color: #999;
}

/* 类型选择 */
.type-options {
  flex: 1;
  display: flex;
  gap: 12rpx;
}

.type-option {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  background: #F5F5F5;
  border-radius: 32rpx;
  border: 2rpx solid transparent;
}

.type-option.active {
  color: #8B1A1A;
  background: #FDF0F0;
  border-color: #8B1A1A;
}

/* 关联成员 */
.member-search-box {
  display: flex;
  align-items: center;
  background: #F8F8F8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.member-search-icon {
  font-size: 28rpx;
  color: #999;
  margin-right: 12rpx;
}

.member-search-input {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #333;
}

.member-search-clear {
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  background: #CCC;
  color: #FFF;
  border-radius: 50%;
  font-size: 28rpx;
}

.selected-members {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.selected-member-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 16rpx;
  background: #FDF0F0;
  border: 2rpx solid #8B1A1A;
  border-radius: 36rpx;
}

.selected-member-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.selected-member-avatar.female {
  background: linear-gradient(135deg, #FF6B9D, #FFB6C1);
}

.selected-member-avatar text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.selected-member-name {
  font-size: 24rpx;
  color: #8B1A1A;
}

.selected-member-remove {
  font-size: 24rpx;
  color: #8B1A1A;
  padding: 0 4rpx;
}

.member-tip {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  padding: 24rpx 0;
}

.member-status {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.member-status-text {
  font-size: 26rpx;
  color: #999;
}

.member-result-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.member-result-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #F8F8F8;
  margin-bottom: 12rpx;
  border: 2rpx solid transparent;
}

.member-result-item.selected {
  background: #FDF0F0;
  border-color: #8B1A1A;
}

.member-result-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.member-result-avatar.female {
  background: linear-gradient(135deg, #FF6B9D, #FFB6C1);
}

.member-result-avatar text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.member-result-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.member-result-check {
  color: #8B1A1A;
  font-size: 28rpx;
  font-weight: bold;
  width: 40rpx;
  text-align: right;
}

.member-load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
}

.member-load-more text {
  font-size: 24rpx;
  color: #8B1A1A;
}

/* 照片九宫格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item,
.photo-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.5);
  color: #FFF;
  font-size: 32rpx;
  border-bottom-left-radius: 12rpx;
}

.photo-add {
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #CCC;
}

.photo-add-icon {
  font-size: 60rpx;
  color: #CCC;
}

/* 提交 */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.submit-btn {
  height: 88rpx;
  line-height: 88rpx;
  background: #8B1A1A;
  color: #FFFFFF;
  font-size: 30rpx;
  border-radius: 44rpx;
  margin: 0;
}

.submit-btn::after {
  border: none;
}
