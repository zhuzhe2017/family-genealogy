.page-container {
  padding: 24rpx;
  padding-bottom: 120rpx;
}

/* 筛选栏 */
.timeline-filter {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.filter-item {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #FFFFFF;
  border: 1rpx solid #F0F0F0;
  transition: all 0.3s;
}

.filter-item.active {
  background: #8B1A1A;
  color: #FFFFFF;
  border-color: #8B1A1A;
}

/* 时间线 */
.timeline {
  position: relative;
  padding-left: 40rpx;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: linear-gradient(180deg, #D4A574, #8B1A1A);
}

.timeline-year {
  margin-bottom: 40rpx;
}

.year-marker {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  position: relative;
}

.year-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #8B1A1A;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 0 0 2rpx #D4A574;
  position: absolute;
  left: -32rpx;
  top: 50%;
  transform: translateY(-50%);
}

.year-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #8B1A1A;
  margin-left: 8rpx;
}

.year-events {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.event-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  margin-left: 8rpx;
}

.event-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #F8F4F0;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-right: 20rpx;
  min-width: 80rpx;
  flex-shrink: 0;
}

.event-month {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.event-day {
  font-size: 32rpx;
  font-weight: bold;
  color: #8B1A1A;
}

.event-content {
  flex: 1;
  min-width: 0;
}

.event-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.event-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
  margin-right: 12rpx;
}

.event-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.event-tag.birth {
  background: #E8F5E9;
  color: #4CAF50;
}

.event-tag.marriage {
  background: #FFF3E0;
  color: #FF9800;
}

.event-tag.death {
  background: #F5F5F5;
  color: #999;
}

.event-tag.other {
  background: #E3F2FD;
  color: #2196F3;
}

.event-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  display: block;
  margin-bottom: 12rpx;
}

.event-members {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.member-tag {
  background: rgba(139, 26, 26, 0.08);
  color: #8B1A1A;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 浮动按钮 */
.fab-add {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 300;
  box-shadow: 0 8rpx 24rpx rgba(139, 26, 26, 0.3);
  z-index: 100;
}
