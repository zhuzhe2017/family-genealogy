<view class="page">
  <!-- 海报预览区 -->
  <view class="poster-wrap">
    <view class="poster-loading" wx:if="{{drawing}}">
      <text>海报生成中...</text>
    </view>
    <canvas type="2d" id="posterCanvas" class="poster-canvas" wx:if="{{!posterPath}}"></canvas>
    <image wx:if="{{posterPath}}" class="poster-preview" src="{{posterPath}}" mode="widthFix"></image>
  </view>

  <!-- 自定义样式 -->
  <view class="style-bar">
    <text class="style-label">海报风格</text>
    <view
      class="style-item {{style === item.key ? 'active' : ''}}"
      wx:for="{{styleOptions}}"
      wx:key="key"
      data-style="{{item.key}}"
      bindtap="switchStyle"
    >
      <view class="style-dot" style="background: linear-gradient(180deg, {{item.bgTop}}, {{item.bgBottom}});"></view>
      <text class="style-name">{{item.name}}</text>
    </view>
  </view>

  <!-- 操作区 -->
  <view class="action-bar">
    <button class="btn primary" open-type="share">分享给微信好友</button>
    <view class="btn" bindtap="savePoster">保存海报</view>
    <view class="btn" bindtap="copyCode">复制邀请码</view>
    <view class="btn" bindtap="copyLink">复制邀请链接</view>
  </view>
  <view class="share-tip">保存海报后可通过微信/朋友圈等渠道分享，好友扫码或输入邀请码即可加入家族</view>
</view>
