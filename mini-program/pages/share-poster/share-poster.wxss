page {
  background: #F5F1EA;
}

.page {
  padding: 24rpx 0 60rpx;
}

/* ===== 海报区 ===== */
.poster-wrap {
  position: relative;
  width: 670rpx;
  height: 1000rpx;
  margin: 20rpx auto;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.12);
  overflow: hidden;
}

.poster-canvas {
  width: 670rpx;
  height: 1000rpx;
  display: block;
}

.poster-preview {
  width: 670rpx;
  display: block;
}

.poster-loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
  color: #8B1A1A;
}

/* ===== 风格选择 ===== */
.style-bar {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 24rpx 40rpx;
}

.style-label {
  font-size: 26rpx;
  color: #666;
}

.style-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  opacity: 0.6;
}

.style-item.active {
  opacity: 1;
}

.style-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.style-item.active .style-dot {
  border-color: #8B1A1A;
}

.style-name {
  font-size: 22rpx;
  color: #333;
}

/* ===== 操作区 ===== */
.action-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 20rpx 40rpx 0;
}

.btn {
  flex: 1 1 45%;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
}

.btn::after {
  border: none;
}

.btn.primary {
  flex-basis: 100%;
  color: #fff;
  background: #8B1A1A;
}

.share-tip {
  padding: 24rpx 40rpx 0;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}
