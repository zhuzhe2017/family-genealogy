/* pages/migration-map/migration-map.wxss */
page { height: 100%; }
.map-wrap {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.map-body {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

/* ============ 顶部世代时间轴 ============ */
.top-bar {
  position: absolute;
  top: 120rpx;
  left: 20rpx;
  right: 380rpx;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(10px);
  border-radius: 16rpx;
  padding: 16rpx 20rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  z-index: 10;
}
.timeline-title {
  text-align: center;
  font-size: 22rpx;
  color: #8B1A1A;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.gen-scroll { white-space: nowrap; }
.gen-track {
  display: inline-flex;
  align-items: center;
  gap: 0;
  padding: 0 10rpx;
}
.gen-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 0 24rpx;
  position: relative;
}
.gen-node::after {
  content: '';
  position: absolute;
  right: -24rpx;
  top: 6rpx;
  width: 48rpx;
  height: 4rpx;
  background: #ddd;
  z-index: -1;
}
.gen-node:last-child::after { display: none; }
.gen-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ccc;
  transition: all 0.2s;
}
.gen-node.active .gen-dot {
  background: #8B1A1A;
  width: 24rpx;
  height: 24rpx;
  box-shadow: 0 0 0 6rpx rgba(139,26,26,0.2);
}
.gen-label {
  font-size: 20rpx;
  color: #888;
}
.gen-node.active .gen-label { color: #8B1A1A; font-weight: 600; }

/* ============ 右侧控制面板 ============ */
.side-bar {
  position: absolute;
  top: 120rpx;
  right: 20rpx;
  width: 340rpx;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(10px);
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  z-index: 10;
  max-height: calc(100vh - 200rpx);
  overflow-y: auto;
}

.panel-section { padding: 16rpx 0; border-bottom: 1rpx solid #f0ebe0; }
.panel-section:last-child { border-bottom: none; }
.section-title {
  font-size: 22rpx;
  color: #2c1810;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.anim-btn {
  background: #8B1A1A;
  color: #fff;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 10rpx;
  font-size: 26rpx;
}
.anim-btn.active { background: #e07a5f; }
.anim-progress {
  text-align: center;
  font-size: 22rpx;
  color: #8B1A1A;
  margin-top: 10rpx;
}

.toggle-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}
.toggle-label { font-size: 24rpx; color: #2c1810; }
.toggle-switch {
  width: 60rpx;
  height: 32rpx;
  background: #ddd;
  border-radius: 20rpx;
  position: relative;
  transition: background 0.2s;
}
.toggle-switch.on { background: #2d6a4f; }
.toggle-dot {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 24rpx;
  height: 24rpx;
  background: #fff;
  border-radius: 50%;
  transition: left 0.2s;
}
.toggle-switch.on .toggle-dot { left: 32rpx; }

.status-item {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
  font-size: 22rpx;
}
.status-label { color: #888; }
.status-value { color: #2c1810; font-weight: 500; }

/* ============ 成员详情卡片 ============ */
.member-sheet {
  position: absolute;
  bottom: 40rpx;
  left: 20rpx;
  right: 380rpx;
  z-index: 15;
}
.member-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
}
.member-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0ebe0;
}
.member-name { font-size: 32rpx; font-weight: 700; color: #2c1810; }
.close-ic { font-size: 28rpx; color: #999; }
.member-rows { display: flex; flex-direction: column; gap: 8rpx; }
.member-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
}
.row-label { color: #888; }
.row-value { color: #2c1810; }
.row-value.type-ancestor { color: #8B1A1A; font-weight: 600; }
.row-value.type-migration { color: #e07a5f; font-weight: 600; }

/* ============ 历史事件侧栏 ============ */
.history-panel {
  position: absolute;
  top: 220rpx;
  bottom: 0;
  right: 20rpx;
  width: 340rpx;
  background: rgba(255,255,255,0.95);
  z-index: 12;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.1);
}
.hp-head {
  padding: 16rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #eee;
}
.hp-title { font-size: 24rpx; font-weight: 600; color: #2c1810; }
.hp-close { font-size: 26rpx; color: #999; }
.hp-list { flex: 1; padding: 8rpx 0; }
.he-item { padding: 12rpx 20rpx; border-bottom: 1rpx solid #f5f1ea; }
.he-year { font-size: 22rpx; color: #8B1A1A; font-weight: 600; }
.he-title { font-size: 24rpx; font-weight: 600; color: #2c1810; margin: 4rpx 0; }
.he-dynasty { font-size: 20rpx; color: #888; }
.he-desc { font-size: 20rpx; color: #666; margin-top: 6rpx; line-height: 1.5; }
.hp-empty { padding: 40rpx; text-align: center; color: #aaa; font-size: 22rpx; }

/* ============ 空态 ============ */
.empty-state {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  z-index: 5;
}
.empty-emoji { font-size: 120rpx; }
.empty-title { font-size: 32rpx; font-weight: 600; color: #2c1810; margin-top: 16rpx; }
.empty-hint { font-size: 24rpx; color: #888; margin-top: 10rpx; }
