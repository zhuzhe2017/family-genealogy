<!--pages/migration-map/migration-map.wxml-->
<view class="map-wrap">

  <!-- 地图主体 -->
  <map
    id="migrationMap"
    class="map-body"
    latitude="{{mapCenter.latitude}}"
    longitude="{{mapCenter.longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    polyline="{{polyline}}"
    show-location="{{false}}"
    bindmarkertap="onMarkerTap"
  ></map>

  <!-- ============ 顶部世代时间轴 ============ -->
  <view class="gen-timeline top-bar">
    <scroll-view scroll-x class="gen-scroll">
      <view class="gen-track">
        <view
          wx:for="{{generationsList}}"
          wx:key="*this"
          class="gen-node {{currentGen === item ? 'active' : ''}}"
          data-gen="{{item}}"
          bindtap="onGenSelect"
        >
          <view class="gen-dot"></view>
          <text class="gen-label">第{{item}}代</text>
        </view>
      </view>
    </scroll-view>
    <view class="timeline-title">家族世系迁徙 · 时空地图</view>
  </view>

  <!-- ============ 右侧控制面板 ============ -->
  <view class="control-panel side-bar">
    <!-- 动画控制 -->
    <view class="panel-section">
      <view class="section-title">🎬 迁徙动画</view>
      <view class="anim-btn {{animating ? 'active' : ''}}" bindtap="playAnimation">
        <text wx:if="{{animating}}">⏸ 暂停</text>
        <text wx:else>▶ 播放迁徙路线</text>
      </view>
      <view wx:if="{{animating}}" class="anim-progress">
        第 {{animStep + 1}} / {{generationsList.length}} 阶段
      </view>
    </view>

    <!-- 图层控制 -->
    <view class="panel-section">
      <view class="section-title">🗺️ 图层</view>
      <view class="toggle-item" bindtap="toggleMigration">
        <text class="toggle-label">迁徙路线</text>
        <view class="toggle-switch {{showMigration ? 'on' : ''}}">
          <view class="toggle-dot"></view>
        </view>
      </view>
      <view class="toggle-item" bindtap="toggleHistoryPanel">
        <text class="toggle-label">历史事件</text>
        <view class="toggle-switch {{showingHistory ? 'on' : ''}}">
          <view class="toggle-dot"></view>
        </view>
      </view>
    </view>

    <!-- 当前状态 -->
    <view class="panel-section status">
      <view class="status-item">
        <text class="status-label">当前世代</text>
        <text class="status-value">{{currentGen !== null ? '第' + currentGen + '代' : '全部'}}</text>
      </view>
      <view class="status-item">
        <text class="status-label">标记点</text>
        <text class="status-value">{{markers.length}} 个</text>
      </view>
      <view class="status-item">
        <text class="status-label">迁徙段</text>
        <text class="status-value">{{polyline.length}} 段</text>
      </view>
    </view>
  </view>

  <!-- ============ 成员详情弹窗 ============ -->
  <view wx:if="{{selectedMember}}" class="member-sheet">
    <view class="member-card">
      <view class="member-header">
        <text class="member-name">{{selectedMember.memberName}}</text>
        <text class="close-ic" bindtap="closeMemberDetail">✕</text>
      </view>
      <view class="member-rows">
        <view class="member-row">
          <text class="row-label">类型</text>
          <text class="row-value type-{{selectedMember.type}}">{{selectedMember.type}}</text>
        </view>
        <view class="member-row" wx:if="{{selectedMember.generation}}">
          <text class="row-label">世代</text>
          <text class="row-value">第 {{selectedMember.generation}} 代</text>
        </view>
        <view class="member-row" wx:if="{{selectedMember.year}}">
          <text class="row-label">年份</text>
          <text class="row-value">{{selectedMember.year}}</text>
        </view>
        <view class="member-row">
          <text class="row-label">地点</text>
          <text class="row-value">{{selectedMember.name}}</text>
        </view>
        <view class="member-row">
          <text class="row-label">坐标</text>
          <text class="row-value">{{selectedMember.lat.toFixed(4)}}, {{selectedMember.lng.toFixed(4)}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ============ 历史事件侧栏 ============ -->
  <view wx:if="{{showingHistory}}" class="history-panel">
    <view class="hp-head">
      <text class="hp-title">📜 同期历史事件</text>
      <text class="hp-close" bindtap="toggleHistoryPanel">✕</text>
    </view>
    <scroll-view scroll-y class="hp-list">
      <block wx:for="{{historyEvents}}" wx:key="year">
        <view class="he-item">
          <view class="he-year">{{item.year < 0 ? '公元前' + (-item.year) + '年' : item.year + '年'}}</view>
          <view class="he-body">
            <view class="he-title">{{item.title}}</view>
            <view class="he-dynasty">{{item.dynasty}} · {{item.category}}</view>
            <view class="he-desc">{{item.description}}</view>
          </view>
        </view>
      </block>
      <view wx:if="{{historyEvents.length === 0}}" class="hp-empty">历史事件加载中...</view>
    </scroll-view>
  </view>

  <!-- ============ 空态 ============ -->
  <view wx:if="{{!loading && markers.length === 0}}" class="empty-state">
    <text class="empty-emoji">🗺️</text>
    <view class="empty-title">暂无坐标数据</view>
    <view class="empty-hint">请在成员管理中为成员填写出生地/安葬地坐标</view>
  </view>

</view>
