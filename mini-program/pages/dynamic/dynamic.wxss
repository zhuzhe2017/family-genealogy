.page-container {
  padding-bottom: 40rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

/* 发布栏 */
.publish-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.publish-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.publish-avatar text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.publish-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  background: #F5F5F5;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #999;
}

.publish-icons {
  display: flex;
  gap: 24rpx;
  margin-left: 16rpx;
}

.publish-icon {
  font-size: 40rpx;
}

/* 动态卡片 */
.dynamic-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dynamic-card {
  background: #FFFFFF;
  padding: 24rpx;
}

.dynamic-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.publisher-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.publisher-avatar.female {
  background: linear-gradient(135deg, #FF6B9D, #FFB6C1);
}

.publisher-avatar text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
  font-family: 'KaiTi', serif;
}

.publisher-info {
  flex: 1;
}

.publisher-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.publish-time {
  font-size: 22rpx;
  color: #999;
}

.more-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #999;
}

/* 动态内容 */
.dynamic-body {
  margin-bottom: 16rpx;
}

.dynamic-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
}

.dynamic-images {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.dynamic-images.single {
  grid-template-columns: 1fr;
}

.dynamic-images.single .dynamic-img {
  max-height: 400rpx;
}

.dynamic-img {
  width: 100%;
  height: 220rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
}

/* 动态操作 */
.dynamic-footer {
  display: flex;
  border-top: 1rpx solid #F5F5F5;
  padding-top: 16rpx;
}

.action-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 0;
}

/* 分享按钮(open-type=share)去默认样式,与相邻操作项一致 */
.share-btn {
  background: transparent;
  padding: 12rpx 0;
  margin: 0;
  line-height: 1;
  font-size: inherit;
  color: inherit;
  border-radius: 0;
  font-weight: normal;
}

.share-btn::after {
  border: none;
}

.action-icon {
  font-size: 32rpx;
}

.action-icon.liked {
  color: #FF4757;
}

.action-count {
  font-size: 24rpx;
  color: #666;
}

.action-count.liked {
  color: #FF4757;
}

/* 评论区 */
.comments-section {
  background: #F8F8F8;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
}

.comment-item {
  padding: 8rpx 0;
}

.comment-user {
  font-size: 24rpx;
  color: #8B1A1A;
  font-weight: 500;
}

.comment-text {
  font-size: 24rpx;
  color: #666;
}

.view-more-comments {
  padding: 8rpx 0;
  font-size: 22rpx;
  color: #999;
}

/* 状态占位:加载/登录引导/失败/空态 */
.state-box {
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.state-loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #E5E5E5;
  border-top-color: #8B1A1A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.state-icon {
  font-size: 72rpx;
}

.state-text {
  font-size: 26rpx;
  color: #999;
}

.state-btn {
  margin-top: 8rpx;
  padding: 0 48rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: #8B1A1A;
  color: #FFFFFF;
  font-size: 26rpx;
  border-radius: 32rpx;
}

.state-btn::after {
  border: none;
}

/* 开发模式模拟数据角标 */
.mock-banner {
  margin: 0 24rpx 16rpx;
  padding: 12rpx 24rpx;
  background: #FFF7E6;
  color: #B25E09;
  font-size: 22rpx;
  border-radius: 12rpx;
  text-align: center;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 评论输入框 */
.comment-input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.comment-input {
  flex: 1;
  height: 64rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #333;
}

.comment-send {
  flex-shrink: 0;
  padding: 14rpx 32rpx;
  background: #8B1A1A;
  color: #FFFFFF;
  font-size: 26rpx;
  border-radius: 32rpx;
  line-height: 1;
}
