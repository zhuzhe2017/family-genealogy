.page-container {
  padding-bottom: 40rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

/* 用户头部 */
.profile-header {
  position: relative;
  background: linear-gradient(135deg, #8B1A1A 0%, #6B0F0F 100%);
  padding: 60rpx 32rpx 80rpx;
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0.1;
}

.header-pattern {
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  border: 80rpx solid rgba(255,255,255,0.1);
}

.user-info {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.user-avatar {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D4A574, #C9A96E);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  border: 4rpx solid rgba(255,255,255,0.3);
  flex-shrink: 0;
  overflow: hidden;
}

.user-avatar text {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: bold;
  font-family: 'KaiTi', serif;
}

.user-avatar-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.user-detail {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.user-role {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  display: block;
}

.edit-profile {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.2);
  color: #FFFFFF;
  font-size: 24rpx;
}

/* 菜单区域 */
.menu-section {
  padding: 0 24rpx;
}

.menu-group {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  width: 48rpx;
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 会员中心角标 */
.vip-badge {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #8B1A1A;
  background: #FDEBEB;
  margin-right: 8rpx;
}

.vip-badge-gold {
  color: #8A6A1F;
  background: linear-gradient(135deg, #F7E8C8, #EFD9A7);
}

.menu-arrow {
  font-size: 32rpx;
  color: #CCC;
}

/* 退出登录 */
.logout-section {
  padding: 40rpx 24rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background: #FFFFFF;
  color: #8B1A1A;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: 1rpx solid #FFE0E0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.logout-btn::after {
  border: none;
}

/* 注销账号 */
.delete-section {
  padding: 0 24rpx 40rpx;
}

.delete-btn {
  width: 100%;
  height: 88rpx;
  background: #FFFFFF;
  color: #E64340;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: 1rpx solid #FFD9D6;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.delete-btn::after {
  border: none;
}

/* 编辑资料弹窗 */
.edit-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.edit-panel {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.edit-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 36rpx;
}

.edit-avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
}

/* 头像选择按钮:外层 view 固定圆形,预览图/占位文字为子元素,按钮为透明点击层 */
.edit-avatar-btn {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  box-sizing: border-box;
  border-radius: 50%;
  overflow: hidden;
  background: #F5F5F5;
  border: 2rpx dashed #DDD;
  flex-shrink: 0;
}

/* 透明点击层:铺满圆形触发 chooseAvatar,自身内容(含基础库自动填充)全部隐藏 */
.edit-avatar-btn-inner {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  background: transparent;
  opacity: 0;
  border-radius: 50%;
  overflow: hidden;
  z-index: 2;
}

.edit-avatar-btn-inner::after {
  border: none;
}

/* 选中头像:绝对定位填满圆形,不受 flex/原始宽高比影响,由外层 overflow:hidden 裁成正圆 */
.edit-avatar-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  z-index: 1;
}

/* 未选头像:字母占位,居中显示 */
.edit-avatar-letter {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8B1A1A;
  font-size: 48rpx;
  line-height: 1;
  z-index: 1;
}

.edit-avatar-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.edit-field {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.edit-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.edit-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.edit-gender-group {
  flex: 1;
  display: flex;
  gap: 20rpx;
}

.edit-gender {
  padding: 12rpx 40rpx;
  border-radius: 32rpx;
  font-size: 27rpx;
  color: #666;
  background: #F5F5F5;
  border: 1rpx solid #F0F0F0;
}

.edit-gender.active {
  background: #FDEBEB;
  color: #8B1A1A;
  border-color: #8B1A1A;
}

.edit-btns {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.edit-cancel,
.edit-save {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.edit-cancel {
  background: #F5F5F5;
  color: #666;
}

.edit-save {
  background: #8B1A1A;
  color: #FFFFFF;
}

.edit-cancel::after,
.edit-save::after {
  border: none;
}

/* 未登录提示横幅 */
.login-banner {
  margin: 0 24rpx 24rpx;
  background: #FFF7E6;
  border: 1rpx solid #FFE9C2;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.login-banner-text {
  font-size: 24rpx;
  color: #8A6D3B;
  flex: 1;
}

.login-banner-arrow {
  font-size: 32rpx;
  color: #8A6D3B;
  margin-left: 16rpx;
}

/* 我的家族支系卡片 */
.family-card {
  margin: 0 24rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.family-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.family-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.family-card-action {
  font-size: 24rpx;
  color: #8B1A1A;
  padding: 6rpx 20rpx;
  border: 1rpx solid #F0C8C8;
  border-radius: 999rpx;
}

.family-card-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.family-card-label {
  width: 150rpx;
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.family-card-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.family-card-share {
  flex: 1;
  display: flex;
  align-items: center;
}

.family-card-code {
  font-size: 28rpx;
  color: #8B1A1A;
  font-weight: 600;
  letter-spacing: 2rpx;
  font-family: 'Courier New', monospace;
  margin-right: 16rpx;
}

.family-card-copy {
  font-size: 22rpx;
  color: #8B1A1A;
  padding: 4rpx 16rpx;
  border: 1rpx solid #F0C8C8;
  border-radius: 999rpx;
}

.family-card-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 8rpx;
}

.family-card-empty text {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.family-card-join-btn {
  padding: 14rpx 48rpx;
  background: #8B1A1A;
  color: #FFFFFF;
  font-size: 26rpx;
  border-radius: 999rpx;
}
