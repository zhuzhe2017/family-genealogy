<wxs src="../../utils/filters.wxs" module="f" />
<view class="page-container">
  <!-- 用户信息头部 -->
  <view class="profile-header">
    <view class="header-bg">
      <view class="header-pattern"></view>
    </view>
    <view class="user-info">
      <view class="user-avatar">
        <image wx:if="{{userInfo.avatarFull}}" src="{{userInfo.avatarFull}}" class="user-avatar-img" mode="aspectFill" />
        <text wx:else>{{userInfo.nickName ? f.firstChar(userInfo.nickName) : ''}}</text>
      </view>
      <view class="user-detail">
        <text class="user-name">{{userInfo.nickName || '未登录'}}</text>
        <text class="user-role">{{userInfo.role === 'admin' ? '家族管理员' : '家族成员'}}</text>
      </view>
      <view class="edit-profile" bindtap="editProfile">
        <text>编辑资料</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-group">
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/family-manage/family-manage">
        <view class="menu-icon">🏠</view>
        <text class="menu-text">家谱管理</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/permission/permission">
        <view class="menu-icon">🔐</view>
        <text class="menu-text">权限管理</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/backup/backup">
        <view class="menu-icon">💾</view>
        <text class="menu-text">数据备份</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/settings/settings">
        <view class="menu-icon">⚙️</view>
        <text class="menu-text">设置</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/privacy/privacy">
        <view class="menu-icon">📄</view>
        <text class="menu-text">用户协议与隐私政策</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="showAbout">
        <view class="menu-icon">ℹ️</view>
        <text class="menu-text">关于我们</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="contactUs">
        <view class="menu-icon">📞</view>
        <text class="menu-text">联系客服</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>

  <!-- 注销账号 -->
  <view class="delete-section">
    <button class="delete-btn" bindtap="deleteAccount">注销账号</button>
  </view>

  <!-- 编辑资料弹窗 -->
  <view class="edit-mask" wx:if="{{editVisible}}" bindtap="closeEdit">
    <view class="edit-panel" catchtap="noop">
      <view class="edit-title">编辑资料</view>

      <!-- 头像:微信头像昵称填写能力 -->
      <view class="edit-avatar-wrap">
        <button class="edit-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{editForm.avatarTempPath}}" src="{{editForm.avatarTempPath}}" class="edit-avatar-img" mode="aspectFill" />
          <text wx:else>{{editForm.nickName ? f.firstChar(editForm.nickName) : '选'}}</text>
        </button>
        <text class="edit-avatar-tip">点击选择头像</text>
      </view>

      <!-- 昵称 -->
      <view class="edit-field">
        <text class="edit-label">昵称</text>
        <input class="edit-input" type="nickname" value="{{editForm.nickName}}" bindinput="onNickInput" placeholder="请输入昵称" maxlength="30" />
      </view>

      <!-- 性别 -->
      <view class="edit-field">
        <text class="edit-label">性别</text>
        <view class="edit-gender-group">
          <view class="edit-gender {{editForm.gender === 1 ? 'active' : ''}}" bindtap="onGenderChange" data-gender="1">男</view>
          <view class="edit-gender {{editForm.gender === 2 ? 'active' : ''}}" bindtap="onGenderChange" data-gender="2">女</view>
          <view class="edit-gender {{editForm.gender === 0 ? 'active' : ''}}" bindtap="onGenderChange" data-gender="0">保密</view>
        </view>
      </view>

      <view class="edit-btns">
        <button class="edit-cancel" bindtap="closeEdit">取消</button>
        <button class="edit-save" bindtap="saveProfile">保存</button>
      </view>
    </view>
  </view>
</view>