<wxs src="../../utils/filters.wxs" module="f" />
<view class="page-container">
  <!-- 用户信息头部 -->
  <view class="profile-header">
    <view class="header-bg">
      <view class="header-pattern"></view>
    </view>
    <view class="user-info">
      <view class="user-avatar">
        <image wx:if="{{userInfo.avatarFull}}" src="{{userInfo.avatarFull}}" class="user-avatar-img" mode="aspectFill" />
        <text wx:else>{{userInfo.nickName ? f.firstChar(userInfo.nickName) : ''}}</text>
      </view>
      <view class="user-detail">
        <text class="user-name">{{userInfo.nickName || '未登录'}}</text>
        <text class="user-role">{{userInfo.role === 'admin' ? '家族管理员' : '家族成员'}}</text>
      </view>
      <view class="edit-profile" bindtap="loginEntry" wx:if="{{!isOnline}}">
        <text>登录/注册</text>
      </view>
      <view class="edit-profile" bindtap="editProfile" wx:else>
        <text>编辑资料</text>
      </view>
    </view>
  </view>

  <!-- 未登录提示 -->
  <view class="login-banner" wx:if="{{!isOnline}}" bindtap="loginEntry">
    <text class="login-banner-text">登录后可同步家族数据，支持手机号 / 微信登录</text>
    <text class="login-banner-arrow">›</text>
  </view>

  <!-- 我的家族支系（登录后展示关联信息与分享码） -->
  <view class="family-card" wx:if="{{isOnline}}">
    <view class="family-card-header">
      <text class="family-card-title">我的家族支系</text>
      <view class="family-card-action" bindtap="joinFamilyEntry">加入/切换</view>
    </view>
    <view class="family-card-body" wx:if="{{familyInfo.bound}}">
      <view class="family-card-row">
        <text class="family-card-label">所属支系</text>
        <text class="family-card-value">{{familyInfo.familyName}}</text>
      </view>
      <view class="family-card-row" wx:if="{{familyInfo.memberName}}">
        <text class="family-card-label">绑定成员</text>
        <text class="family-card-value">{{familyInfo.memberName}}</text>
      </view>
      <view class="family-card-row" wx:if="{{familyInfo.shareCode}}">
        <text class="family-card-label">分享码</text>
        <view class="family-card-share">
          <text class="family-card-code">{{familyInfo.shareCode}}</text>
          <text class="family-card-copy" bindtap="copyShareCode">复制</text>
        </view>
      </view>
    </view>
    <view class="family-card-empty" wx:else>
      <text>尚未关联家族支系，输入分享码或家族ID即可加入</text>
      <view class="family-card-join-btn" bindtap="joinFamilyEntry">立即加入</view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-group">
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/member-center/member-center">
        <view class="menu-icon">👑</view>
        <view class="menu-text">
          <text>会员中心</text>
        </view>
        <text class="vip-badge {{vipStatus.isVip ? 'vip-badge-gold' : ''}}">{{vipStatus.text}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/tools-manage/tools-manage">
        <view class="menu-icon">🧰</view>
        <text class="menu-text">工具管理</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/invitation/invitation">
        <view class="menu-icon">📩</view>
        <text class="menu-text">家族邀请</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/permission/permission">
        <view class="menu-icon">🔐</view>
        <text class="menu-text">权限管理</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/backup/backup">
        <view class="menu-icon">💾</view>
        <text class="menu-text">数据备份</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-item" bindtap="bindPhoneEntry">
        <view class="menu-icon">📱</view>
        <text class="menu-text">绑定手机号</text>
        <text class="vip-badge {{userInfo.phoneMasked ? 'vip-badge-gold' : ''}}">{{userInfo.phoneMasked || '未绑定'}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/settings/settings">
        <view class="menu-icon">⚙️</view>
        <text class="menu-text">设置</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="navigateTo" data-url="/pages/privacy/privacy">
        <view class="menu-icon">📄</view>
        <text class="menu-text">用户协议与隐私政策</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="showAbout">
        <view class="menu-icon">ℹ️</view>
        <text class="menu-text">关于我们</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="contactUs">
        <view class="menu-icon">📞</view>
        <text class="menu-text">联系客服</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>

  <!-- 注销账号 -->
  <view class="delete-section">
    <button class="delete-btn" bindtap="deleteAccount">注销账号</button>
  </view>

  <!-- 编辑资料弹窗 -->
  <view class="edit-mask" wx:if="{{editVisible}}" bindtap="closeEdit">
    <view class="edit-panel" catchtap="noop">
      <view class="edit-title">编辑资料</view>

      <!-- 头像:微信头像昵称填写能力。预览图放在按钮外,按钮仅作透明点击层,
           避免 chooseAvatar 基础库在按钮内部自动填充头像导致变形 -->
      <view class="edit-avatar-wrap">
        <view class="edit-avatar-btn">
          <image wx:if="{{editForm.avatarTempPath}}" src="{{editForm.avatarTempPath}}" class="edit-avatar-img" mode="aspectFill" />
          <text wx:else class="edit-avatar-letter">{{editForm.nickName ? f.firstChar(editForm.nickName) : '选'}}</text>
          <button class="edit-avatar-btn-inner" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"></button>
        </view>
        <text class="edit-avatar-tip">点击选择头像</text>
      </view>

      <!-- 昵称 -->
      <view class="edit-field">
        <text class="edit-label">昵称</text>
        <input class="edit-input" type="nickname" value="{{editForm.nickName}}" bindinput="onNickInput" placeholder="请输入昵称" maxlength="30" />
      </view>

      <!-- 性别 -->
      <view class="edit-field">
        <text class="edit-label">性别</text>
        <view class="edit-gender-group">
          <view class="edit-gender {{editForm.gender === 1 ? 'active' : ''}}" bindtap="onGenderChange" data-gender="1">男</view>
          <view class="edit-gender {{editForm.gender === 2 ? 'active' : ''}}" bindtap="onGenderChange" data-gender="2">女</view>
          <view class="edit-gender {{editForm.gender === 0 ? 'active' : ''}}" bindtap="onGenderChange" data-gender="0">保密</view>
        </view>
      </view>

      <view class="edit-btns">
        <button class="edit-cancel" bindtap="closeEdit">取消</button>
        <button class="edit-save" bindtap="saveProfile">保存</button>
      </view>
    </view>
  </view>
</view>