/* pages/reader/reader.wxss */
page { background: #1a1410; }

.reader-wrap {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #1a1410;
}

/* ============ 工具栏 ============ */
.toolbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #2a1f16;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  flex-shrink: 0;
}
.toolbar-left, .toolbar-right {
  width: 140rpx;
}
.toolbar-left {
  display: flex;
  align-items: center;
  color: #d4c4a8;
  font-size: 26rpx;
}
.toolbar-icon {
  font-size: 36rpx;
  margin-right: 8rpx;
}
.toolbar-right {
  text-align: right;
}
.page-indicator {
  color: #d4c4a8;
  font-size: 24rpx;
}

.view-tabs {
  flex: 1;
  display: flex;
  justify-content: center;
}
.view-tab {
  padding: 12rpx 28rpx;
  margin: 0 8rpx;
  font-size: 26rpx;
  color: #8b7355;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.05);
}
.view-tab.active {
  color: #fff;
  background: #8B1A1A;
}

/* ============ 加载/错误 ============ */
.loading-mask {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b7355;
  font-size: 28rpx;
}
.loading-mask.small {
  position: absolute;
  inset: 0;
  z-index: 5;
}
.error-mask {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.error-text {
  color: #d4c4a8;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}
.retry-btn {
  padding: 16rpx 48rpx;
  background: #8B1A1A;
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
}

/* ============ 原页浏览 ============ */
.pages-view {
  flex: 1;
  position: relative;
  overflow: hidden;
}
.pages-swiper {
  height: 100%;
}
.movable-area {
  width: 100%;
  height: 100%;
}
.movable-img {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.page-img {
  width: 100%;
  height: auto;
}

/* 翻页按钮 */
.page-nav {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 80rpx;
}
.nav-btn {
  width: 80rpx;
  height: 80rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}
.nav-btn.disabled {
  opacity: 0.3;
}

/* ============ 正文/译文 ============ */
.text-view {
  flex: 1;
  display: flex;
  background: #f7f3ed;
}
.text-scroll {
  flex: 1;
  height: 100%;
}
.text-content {
  padding: 48rpx 40rpx 80rpx;
  min-height: 100%;
}
.chapter-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2c1810;
  text-align: center;
  margin-bottom: 36rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #d4c4a8;
}
.chapter-text {
  font-size: 32rpx;
  line-height: 2;
  color: #333;
  text-align: justify;
  font-family: "Noto Serif SC", "Songti SC", "STSong", serif;
}
.trans-body .chapter-text {
  font-family: -apple-system, "PingFang SC", sans-serif;
  font-size: 30rpx;
  color: #444;
}

/* 空状态 */
.empty-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
  color: #8b7355;
}
.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 28rpx;
}

/* ============ 章节抽屉 ============ */
.drawer-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 10;
}
.chapter-drawer {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  width: 70%;
  max-width: 560rpx;
  background: #fff;
  z-index: 11;
  transform: translateX(-100%);
  transition: transform 0.25s ease;
  display: flex;
  flex-direction: column;
}
.chapter-drawer.show {
  transform: translateX(0);
}
.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0;
}
.drawer-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c1810;
}
.drawer-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}
.drawer-scroll {
  flex: 1;
  height: 0;
}
.chapter-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.chapter-item.active {
  background: rgba(139, 26, 26, 0.06);
  color: #8B1A1A;
}
.chapter-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ccc;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.chapter-item.active .chapter-dot {
  background: #8B1A1A;
}
.chapter-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.chapter-item.active .chapter-name {
  color: #8B1A1A;
  font-weight: 500;
}
.chapter-page {
  font-size: 22rpx;
  color: #aaa;
}
