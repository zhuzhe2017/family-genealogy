.page-container {
  padding-bottom: 120rpx;
}

/* 分类标签 */
.category-tabs {
  background: #FFFFFF;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.tabs-wrapper {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx;
  white-space: nowrap;
}

.tab-item {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #F5F5F5;
  transition: all 0.3s;
}

.tab-item.active {
  background: #8B1A1A;
  color: #FFFFFF;
}

/* 资料列表 */
.docs-list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.doc-loading,
.doc-error,
.doc-empty {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #999;
}

.doc-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.doc-cover {
  width: 160rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #8B1A1A, #6B0F0F);
  margin-right: 24rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.doc-cover::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: rgba(212, 165, 116, 0.5);
}

.doc-cover-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
}

.doc-cover-title {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
  text-align: center;
  line-height: 1.4;
  margin-bottom: 8rpx;
  font-family: 'KaiTi', serif;
}

.doc-cover-volume {
  font-size: 20rpx;
  color: rgba(255,255,255,0.7);
}

.doc-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.doc-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.doc-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.doc-meta {
  display: flex;
  gap: 16rpx;
}

.doc-date, .doc-pages {
  font-size: 22rpx;
  color: #999;
  background: #F5F5F5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 浮动按钮 */
.fab-add {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 300;
  box-shadow: 0 8rpx 24rpx rgba(139, 26, 26, 0.3);
  z-index: 100;
}
