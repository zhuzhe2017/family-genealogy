<wxs src="../../utils/filters.wxs" module="f" />
<view class="nav-page">
  <block wx:if="{{status === 'ready'}}">
    <!-- 顶部工具条：成员查询 + 底图切换 + 重新定位 -->
    <view class="nav-toolbar">
      <view class="search-box">
        <text class="search-icon">🔍</text>
        <input
          class="search-input"
          type="text"
          value="{{keyword}}"
          placeholder="输入成员姓名查询"
          placeholder-class="search-placeholder"
          confirm-type="search"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
        />
        <view class="search-clear" wx:if="{{keyword}}" bindtap="clearKeyword">
          <text class="search-clear-icon">✕</text>
        </view>
      </view>
      <view class="tool-btn {{satellite ? 'active' : ''}}" bindtap="toggleSatellite">
        <text class="tool-btn-icon">🛰</text>
        <text class="tool-btn-text">{{satellite ? '卫星' : '标准'}}</text>
      </view>
      <view class="tool-btn {{locating ? 'disabled' : ''}}" bindtap="relocate">
        <text class="tool-btn-icon">📍</text>
        <text class="tool-btn-text">定位</text>
      </view>
    </view>

    <!-- 定位未开启提示 -->
    <view class="locate-banner" wx:if="{{locationDenied}}">
      <text class="locate-banner-text">定位未开启，无法规划从当前位置出发的路线</text>
      <text class="locate-banner-btn" bindtap="handleLocationDenied">去开启</text>
    </view>

    <!-- 主体：地图 + 侧边成员列表（宽屏左右分栏，窄屏上下分栏） -->
    <view class="nav-body {{isWide ? 'wide' : 'narrow'}}">
      <!-- 内置地图：展示全部带坐标的成员标记点，支持标准/卫星底图切换 -->
      <map
        id="memberMap"
        class="nav-map"
        latitude="{{centerLatitude}}"
        longitude="{{centerLongitude}}"
        scale="{{scale}}"
        markers="{{markers}}"
        polyline="{{polyline}}"
        include-points="{{includePoints}}"
        show-location="{{true}}"
        enable-zoom="{{true}}"
        enable-scroll="{{true}}"
        enable-satellite="{{satellite}}"
        bindmarkertap="onMarkerTap"
        bindregionchange="onRegionChange"
      ></map>

      <!-- 侧边栏：成员列表 / 导航指引 -->
      <view class="nav-side">
        <scroll-view class="side-scroll" scroll-y lower-threshold="120" bindscrolltolower="onListReachBottom">
          <view class="side-inner">
            <!-- 已选中成员：展示导航指引 -->
            <block wx:if="{{selectedMember}}">
              <view class="panel-head">
                <view class="panel-avatar {{selectedMember.isAlive ? 'alive' : 'deceased'}}">
                  <text class="panel-avatar-text">{{f.firstChar(selectedMember.name)}}</text>
                </view>
                <view class="panel-info">
                  <text class="panel-name">{{selectedMember.name}}</text>
                  <text class="panel-sub">{{selectedMember.statusText}} · 第{{selectedMember.generation}}代{{selectedMember.generationName ? '「' + selectedMember.generationName + '」' : ''}}</text>
                  <text class="panel-place" wx:if="{{selectedMember.placeLabel}}">{{selectedMember.placeLabel}}</text>
                </view>
                <view class="panel-close" bindtap="clearRoute">
                  <text class="panel-close-icon">✕</text>
                </view>
              </view>

              <!-- 规划中 -->
              <view class="route-state" wx:if="{{routeLoading}}">
                <text class="route-state-text">正在规划导航路线…</text>
              </view>

              <!-- 规划失败：多为定位不可用 -->
              <view class="route-state" wx:elif="{{routeFailed}}">
                <text class="route-state-text">{{locationDenied ? '定位未开启，无法确定导航起点' : '未能获取你的位置，规划失败'}}</text>
                <view class="route-state-actions">
                  <text class="route-link" bindtap="retryRoute">重试</text>
                  <text class="route-link" bindtap="openLocationSetting">去设置</text>
                </view>
              </view>

              <!-- 规划结果 -->
              <block wx:elif="{{routeInfo}}">
                <view class="route-summary">
                  <text class="route-distance">{{routeInfo.distanceText}}</text>
                  <text class="route-duration" wx:if="{{routeInfo.durationText}}">约 {{routeInfo.durationText}}</text>
                  <text class="route-badge" wx:if="{{routeFallback}}">直线参考</text>
                </view>
                <text class="route-tip" wx:if="{{routeFallback}}">路线服务暂不可用，当前显示直线距离，可点击下方按钮跳转地图App导航</text>
                <scroll-view class="route-steps" scroll-y wx:if="{{routeSteps.length > 0}}">
                  <view class="route-step" wx:for="{{routeSteps}}" wx:key="index">
                    <text class="step-index">{{item.index}}</text>
                    <text class="step-text">{{item.instruction}}</text>
                    <text class="step-distance" wx:if="{{item.distance}}">{{item.distance}}</text>
                  </view>
                </scroll-view>
                <view class="panel-actions">
                  <view class="btn btn-primary" bindtap="openExternalMap">
                    <text class="btn-text">打开地图App导航</text>
                  </view>
                </view>
              </block>
            </block>

            <!-- 查询命中唯一成员：直接展示该成员详情（无需列表） -->
            <block wx:elif="{{detailMember}}">
              <view class="panel-head">
                <view class="panel-avatar {{detailMember.isAlive ? 'alive' : 'deceased'}}">
                  <text class="panel-avatar-text">{{f.firstChar(detailMember.name)}}</text>
                </view>
                <view class="panel-info">
                  <text class="panel-name">{{detailMember.name}}</text>
                  <text class="panel-sub">{{detailMember.statusText}} · 第{{detailMember.generation}}代{{detailMember.generationName ? '「' + detailMember.generationName + '」' : ''}}</text>
                </view>
                <view class="panel-close" bindtap="clearKeyword">
                  <text class="panel-close-icon">✕</text>
                </view>
              </view>

              <view class="detail-grid">
                <view class="detail-row">
                  <text class="detail-label">性别</text>
                  <text class="detail-value">{{detailMember.genderText}}</text>
                </view>
                <view class="detail-row">
                  <text class="detail-label">世代</text>
                  <text class="detail-value">第{{detailMember.generation}}代{{detailMember.generationName ? '「' + detailMember.generationName + '」' : ''}}</text>
                </view>
                <view class="detail-row" wx:if="{{detailMember.birthDate}}">
                  <text class="detail-label">出生日期</text>
                  <text class="detail-value">{{detailMember.birthDate}}</text>
                </view>
                <view class="detail-row" wx:if="{{detailMember.birthPlace}}">
                  <text class="detail-label">出生地</text>
                  <text class="detail-value">{{detailMember.birthPlace}}</text>
                </view>
                <view class="detail-row" wx:if="{{detailMember.deathDate}}">
                  <text class="detail-label">逝世日期</text>
                  <text class="detail-value">{{detailMember.deathDate}}</text>
                </view>
                <view class="detail-row" wx:if="{{detailMember.deathPlace}}">
                  <text class="detail-label">安葬地点</text>
                  <text class="detail-value">{{detailMember.deathPlace}}</text>
                </view>
                <view class="detail-row" wx:if="{{detailMember.bio}}">
                  <text class="detail-label">生平简介</text>
                  <text class="detail-value">{{detailMember.bio}}</text>
                </view>
              </view>

              <!-- 无有效定位坐标：明确提示无法在图上定位或导航 -->
              <view class="coord-tip" wx:if="{{!detailMember.hasCoord}}">
                <text class="coord-tip-text">该成员未录入位置坐标，无法在地图上定位或规划导航路线</text>
              </view>

              <view class="panel-actions">
                <view class="btn {{detailMember.hasCoord ? 'btn-primary' : 'btn-disabled'}}" bindtap="onDetailNavigate">
                  <text class="btn-text">{{detailMember.hasCoord ? '规划导航路线' : '暂无位置坐标'}}</text>
                </view>
              </view>
            </block>

            <!-- 未选中成员：成员列表（查询时同步为命中结果） -->
            <block wx:else>
              <view class="side-head">
                <text class="side-title">{{searchActive ? '查询结果' : '成员列表'}}</text>
                <text class="side-count">{{listSummary}}</text>
              </view>

              <!-- 命中结果中存在无定位坐标的成员：给出汇总提示 -->
              <view class="side-tip" wx:if="{{noCoordCount > 0}}">
                <text class="side-tip-text">{{noCoordCount}} 位匹配成员未录入位置坐标，无法在地图上定位或规划路线</text>
              </view>

              <view class="member-list" wx:if="{{!searching}}">
                <view
                  class="member-item {{item.id === selectedId ? 'active' : ''}}"
                  wx:for="{{listMembers}}"
                  wx:key="id"
                  data-id="{{item.id}}"
                  bindtap="onMemberTap"
                >
                  <view class="member-avatar {{item.isAlive ? 'alive' : 'deceased'}}">
                    <text class="member-avatar-text">{{f.firstChar(item.name)}}</text>
                  </view>
                  <view class="member-main">
                    <view class="member-title-row">
                      <text class="member-name">{{item.name}}</text>
                      <text class="member-flag" wx:if="{{!item.hasCoord}}">无定位坐标</text>
                    </view>
                    <text class="member-sub">{{item.statusText}} · 第{{item.generation}}代{{item.generationName ? '「' + item.generationName + '」' : ''}}</text>
                    <text class="member-place" wx:if="{{item.placeLabel}}">{{item.placeLabel}}</text>
                  </view>
                </view>

                <view class="list-empty" wx:if="{{listMembers.length === 0}}">
                  <text class="list-empty-text">{{searchActive ? '未找到匹配的成员' : '暂无可展示的成员'}}</text>
                </view>
                <view class="list-more" wx:if="{{listHasMore}}">
                  <text class="list-more-text">上滑加载更多…</text>
                </view>
              </view>
              <view class="list-loading" wx:else>
                <text class="list-loading-text">查询中…</text>
              </view>
            </block>
          </view>
        </scroll-view>
      </view>
    </view>
  </block>

  <!-- 非正常态占位 -->
  <view class="nav-state" wx:elif="{{status === 'loading'}}">
    <text class="nav-state-text">地图加载中…</text>
  </view>
  <view class="nav-state" wx:elif="{{status === 'needLogin'}}">
    <text class="nav-state-icon">📍</text>
    <text class="nav-state-title">登录后查看成员位置</text>
    <text class="nav-state-desc">登录并进入家族后，可在地图上查看成员位置并规划导航路线</text>
    <view class="nav-state-btn" bindtap="doLogin">
      <text class="nav-state-btn-text">立即登录</text>
    </view>
  </view>
  <view class="nav-state" wx:elif="{{status === 'noFamily'}}">
    <text class="nav-state-icon">🏠</text>
    <text class="nav-state-title">请先选择家族</text>
    <text class="nav-state-desc">选择家族后可查看该家族成员的位置分布并规划导航</text>
  </view>
  <view class="nav-state" wx:elif="{{status === 'failed'}}">
    <text class="nav-state-icon">⚠️</text>
    <text class="nav-state-title">位置数据加载失败</text>
    <text class="nav-state-desc">请检查网络连接后重试</text>
    <view class="nav-state-btn" bindtap="loadMembers">
      <text class="nav-state-btn-text">重新加载</text>
    </view>
  </view>
  <view class="nav-state" wx:else>
    <text class="nav-state-icon">🗺️</text>
    <text class="nav-state-title">暂无可导航的成员位置</text>
    <text class="nav-state-desc">{{emptyHint || '家族成员均未录入位置坐标，可在成员详情中补充安葬地点'}}</text>
  </view>
</view>
