/* 位置导航页：地图 + 侧边栏（宽屏左右分栏 / 窄屏上下分栏） */
.nav-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #F5F5F5;
}

/* ---------- 顶部工具条 ---------- */
.nav-toolbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  position: relative;
  z-index: 2;
}

.search-box {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 68rpx;
  padding: 0 20rpx;
  border-radius: 34rpx;
  background: #F5F5F5;
}

.search-icon {
  font-size: 24rpx;
  margin-right: 10rpx;
}

.search-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 68rpx;
  font-size: 26rpx;
  color: #333333;
}

.search-placeholder {
  font-size: 26rpx;
  color: #AAAAAA;
}

.search-clear {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.search-clear-icon {
  font-size: 24rpx;
  color: #999999;
}

.tool-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 68rpx;
  padding: 0 20rpx;
  margin-left: 16rpx;
  border-radius: 34rpx;
  background: #F5F5F5;
}

.tool-btn.active {
  background: #FBEFEF;
}

.tool-btn.disabled {
  opacity: 0.5;
}

.tool-btn-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.tool-btn-text {
  font-size: 24rpx;
  color: #555555;
}

.tool-btn.active .tool-btn-text {
  color: #8B1A1A;
  font-weight: 600;
}

/* ---------- 定位未开启提示条 ---------- */
.locate-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx;
  background: #FFF7E6;
}

.locate-banner-text {
  flex: 1;
  font-size: 24rpx;
  color: #B26A00;
}

.locate-banner-btn {
  font-size: 24rpx;
  color: #8B1A1A;
  font-weight: 600;
  margin-left: 20rpx;
}

/* ---------- 主体：地图 + 侧边栏 ---------- */
.nav-body {
  flex: 1 1 auto;
  display: flex;
  min-height: 0;
  overflow: hidden;
}

/* 宽屏（PC / 平板）：地图在左，侧边栏在右 */
.nav-body.wide {
  flex-direction: row;
}

/* 窄屏（手机）：地图在上，侧边栏在下 */
.nav-body.narrow {
  flex-direction: column;
}

.nav-map {
  flex: 1 1 auto;
  width: 100%;
  min-height: 0;
  background: #E8EDF2;
}

.nav-body.wide .nav-map {
  min-width: 0;
}

.nav-side {
  flex-shrink: 0;
  background: #FFFFFF;
}

.nav-body.wide .nav-side {
  width: 46%;
  max-width: 900rpx;
  min-width: 560rpx;
  border-left: 1rpx solid #EFEFEF;
}

.nav-body.narrow .nav-side {
  height: 46vh;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.06);
}

.side-scroll {
  height: 100%;
  flex: 1 1 auto;
  min-height: 0;
}

.side-inner {
  padding: 24rpx 28rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* ---------- 侧边栏标题 ---------- */
.side-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F2F2F2;
}

.side-title {
  font-size: 28rpx;
  color: #222222;
  font-weight: 600;
}

.side-count {
  font-size: 22rpx;
  color: #999999;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* ---------- 成员列表 ---------- */
.member-list {
  padding-top: 8rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 18rpx 12rpx;
  border-radius: 16rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.member-item.active {
  background: #FDF4E8;
}

.member-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.member-avatar.alive {
  background: #E8F5E9;
}

.member-avatar.deceased {
  background: #ECEFF1;
}

.member-avatar-text {
  font-size: 26rpx;
  color: #333333;
  font-weight: 600;
}

.member-main {
  flex: 1;
  margin-left: 18rpx;
  min-width: 0;
}

.member-name {
  display: block;
  font-size: 28rpx;
  color: #222222;
  font-weight: 600;
}

.member-sub {
  display: block;
  font-size: 22rpx;
  color: #888888;
  margin-top: 4rpx;
}

.member-place {
  display: block;
  font-size: 22rpx;
  color: #666666;
  margin-top: 4rpx;
  line-height: 1.4;
}

.list-empty {
  padding: 60rpx 0;
  text-align: center;
}

.list-empty-text {
  font-size: 26rpx;
  color: #999999;
}

.list-more {
  padding: 24rpx 0;
  text-align: center;
}

.list-more-text {
  font-size: 24rpx;
  color: #AAAAAA;
}

/* ---------- 导航指引：成员信息 ---------- */
.panel-head {
  display: flex;
  align-items: flex-start;
}

.panel-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.panel-avatar.alive {
  background: #E8F5E9;
}

.panel-avatar.deceased {
  background: #ECEFF1;
}

.panel-avatar-text {
  font-size: 30rpx;
  color: #333333;
  font-weight: 600;
}

.panel-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.panel-name {
  display: block;
  font-size: 30rpx;
  color: #222222;
  font-weight: 600;
}

.panel-sub {
  display: block;
  font-size: 24rpx;
  color: #888888;
  margin-top: 6rpx;
}

.panel-place {
  display: block;
  font-size: 24rpx;
  color: #666666;
  margin-top: 6rpx;
  line-height: 1.4;
}

.panel-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.panel-close-icon {
  font-size: 28rpx;
  color: #999999;
}

/* ---------- 路线状态 ---------- */
.route-state {
  padding: 32rpx 0 16rpx;
  text-align: center;
}

.route-state-text {
  font-size: 26rpx;
  color: #999999;
}

.route-state-actions {
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
}

.route-link {
  font-size: 26rpx;
  color: #8B1A1A;
  margin: 0 32rpx;
}

/* ---------- 路线结果 ---------- */
.route-summary {
  display: flex;
  align-items: baseline;
  margin-top: 20rpx;
}

.route-distance {
  font-size: 40rpx;
  color: #222222;
  font-weight: 600;
}

.route-duration {
  font-size: 26rpx;
  color: #666666;
  margin-left: 16rpx;
}

.route-badge {
  font-size: 22rpx;
  color: #B26A00;
  background: #FFF7E6;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
}

.route-tip {
  display: block;
  font-size: 22rpx;
  color: #B26A00;
  line-height: 1.5;
  margin-top: 12rpx;
}

.route-steps {
  max-height: 320rpx;
  margin-top: 16rpx;
}

.route-step {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F2F2F2;
}

.step-index {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #F0F0F0;
  color: #666666;
  font-size: 20rpx;
  text-align: center;
  line-height: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.step-text {
  flex: 1;
  font-size: 24rpx;
  color: #333333;
  line-height: 1.4;
}

.step-distance {
  font-size: 22rpx;
  color: #999999;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.panel-actions {
  padding-top: 24rpx;
}

.btn {
  height: 84rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: linear-gradient(135deg, #8B1A1A 0%, #6B0F0F 100%);
}

.btn-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* ---------- 无定位坐标提示 ---------- */
.coord-tip {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  background: #FFF7E6;
  border-radius: 12rpx;
}

.coord-tip-text {
  font-size: 24rpx;
  color: #B26A00;
  line-height: 1.5;
}

/* 检索结果汇总提示（命中结果中存在无坐标成员） */
.side-tip {
  margin: 16rpx 0 4rpx;
  padding: 14rpx 18rpx;
  background: #FFF7E6;
  border-radius: 12rpx;
}

.side-tip-text {
  font-size: 22rpx;
  color: #B26A00;
  line-height: 1.5;
}

/* 无有效坐标按钮：置灰不可点 */
.btn-disabled {
  background: #E0E0E0;
}

.btn-disabled .btn-text {
  color: #9E9E9E;
}

/* ---------- 查询中态 ---------- */
.list-loading {
  padding: 60rpx 0;
  text-align: center;
}

.list-loading-text {
  font-size: 26rpx;
  color: #999999;
}

/* ---------- 成员名称行（名称 + 无坐标标签） ---------- */
.member-title-row {
  display: flex;
  align-items: center;
}

.member-flag {
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  color: #B26A00;
  background: #FFF7E6;
  border-radius: 8rpx;
  flex-shrink: 0;
}

/* ---------- 单命中成员详情 ---------- */
.detail-grid {
  margin-top: 24rpx;
  border-top: 1rpx solid #F2F2F2;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F7F7F7;
}

.detail-label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #999999;
}

.detail-value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #333333;
  line-height: 1.5;
  word-break: break-all;
}

/* ---------- 未选中空态 ---------- */
.panel-empty {
  padding: 12rpx 0 8rpx;
}

.panel-empty-title {
  display: block;
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
}

.panel-empty-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
  margin-top: 10rpx;
}

/* ---------- 整页占位态 ---------- */
.nav-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 60rpx;
  text-align: center;
}

.nav-state-icon {
  font-size: 96rpx;
  line-height: 1.2;
}

.nav-state-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 600;
  margin-top: 24rpx;
}

.nav-state-desc {
  font-size: 26rpx;
  color: #999999;
  line-height: 1.6;
  margin-top: 16rpx;
}

.nav-state-text {
  font-size: 28rpx;
  color: #999999;
}

.nav-state-btn {
  margin-top: 40rpx;
  height: 80rpx;
  padding: 0 56rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #8B1A1A 0%, #6B0F0F 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-state-btn-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}
