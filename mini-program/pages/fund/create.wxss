.page {
  min-height: 100vh;
  background: #F6F7FB;
  padding-bottom: 40rpx;
}

.form-card {
  margin: 24rpx;
  background: #FFF;
  border-radius: 20rpx;
  padding: 8rpx 28rpx;
}

.form-item {
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}
.form-item:last-child {
  border-bottom: none;
}
.form-label {
  font-size: 27rpx;
  color: #333;
  margin-bottom: 16rpx;
}
.required {
  color: #E64340;
  margin-left: 4rpx;
}
.input {
  font-size: 28rpx;
  height: 48rpx;
}
.textarea {
  width: 100%;
  height: 140rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.switch-row .form-label {
  margin-bottom: 0;
}

.adv-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: 600;
}
.adv-toggle-text {
  font-size: 26rpx;
  color: #999;
  font-weight: 400;
}

.tip {
  margin: 0 40rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.footer {
  margin: 40rpx 24rpx;
}
.footer button {
  width: 100%;
  margin: 0;
  height: 96rpx;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  color: #FFF;
}
