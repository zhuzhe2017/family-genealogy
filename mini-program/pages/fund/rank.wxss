.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #8B1A1A 0%, #F5F1EA 300rpx);
  padding: 24rpx;
  box-sizing: border-box;
}

.loading,
.empty {
  text-align: center;
  color: #999;
  padding: 100rpx 0;
  font-size: 28rpx;
}

/* 前三名 */
.podium {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 24rpx;
  padding: 40rpx 0 32rpx;
  margin-bottom: 24rpx;
}

.podium-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.podium-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #C9A227, #8B6E1A);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FFF;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.podium-avatar text {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFF;
}

.podium-item.first .podium-avatar {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #FFD700, #C9A227);
}

.podium-name {
  font-size: 26rpx;
  color: #FFF;
  margin-top: 12rpx;
  font-weight: 600;
}

.podium-amount {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

.podium-badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #FFF;
}

.badge-1 {
  background: #FFD700;
}

.badge-2 {
  background: #C0C0C0;
}

.badge-3 {
  background: #CD7F32;
}

/* 我的排名 */
.my-rank {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.my-rank text {
  font-size: 26rpx;
  color: #FFF;
}

/* 完整榜单 */
.rank-section {
  background: #FFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.rank-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F5F5F5;
  color: #666;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rank-num.top1 {
  background: #FFD700;
  color: #FFF;
}

.rank-num.top2 {
  background: #C0C0C0;
  color: #FFF;
}

.rank-num.top3 {
  background: #CD7F32;
  color: #FFF;
}

.rank-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #6B0F0F);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rank-avatar text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFF;
}

.rank-info {
  flex: 1;
}

.rank-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.rank-count {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.rank-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #8B1A1A;
  flex-shrink: 0;
}
