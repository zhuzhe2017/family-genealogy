.page {
  min-height: 100vh;
  background: #F6F7FB;
  padding-bottom: 60rpx;
}

.state {
  padding: 200rpx 0;
  text-align: center;
}
.state-text {
  font-size: 28rpx;
  color: #999;
}

.form-card {
  margin: 24rpx;
  background: #FFF;
  border-radius: 20rpx;
  padding: 8rpx 28rpx 24rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  padding: 24rpx 0 8rpx;
}
.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}
.form-item:last-child {
  border-bottom: none;
}
.form-label {
  font-size: 27rpx;
  color: #333;
  margin-bottom: 14rpx;
}
.required {
  color: #E64340;
  margin-left: 4rpx;
}
.input {
  font-size: 28rpx;
  height: 48rpx;
}
.textarea {
  width: 100%;
  height: 130rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.switch-row .form-label {
  margin-bottom: 0;
}

.tip {
  margin: 0 40rpx 20rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.footer {
  margin: 30rpx 24rpx;
}
.footer button {
  width: 100%;
  margin: 0;
  height: 96rpx;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  color: #FFF;
}

.danger-zone {
  margin: 30rpx 24rpx;
  background: #FFF;
  border-radius: 20rpx;
  padding: 28rpx;
}
.danger-title {
  font-size: 28rpx;
  color: #E64340;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.danger-zone button {
  width: 100%;
  margin: 0;
  height: 92rpx;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 46rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF1F0;
  color: #E64340;
}
