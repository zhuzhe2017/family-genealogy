<view class="page-container">
  <!-- 家族头部 -->
  <view class="family-header" wx:if="{{online && familyName}}">
    <view class="family-avatar">{{familyName[0]}}</view>
    <view class="family-info">
      <text class="family-name">{{familyName}}</text>
      <text class="family-sub">共 {{total}} 位家族成员</text>
    </view>
  </view>

  <!-- 未登录/体验模式 -->
  <view class="empty-state" wx:if="{{!online}}">
    <text class="empty-text">请先登录后查看家族成员权限</text>
  </view>

  <!-- 未加入家族 -->
  <view class="empty-state" wx:elif="{{online && members.length === 0}}">
    <text class="empty-text">您还未加入任何家族\n加入后可在此管理成员角色</text>
  </view>

  <!-- 成员角色列表 -->
  <view class="member-card" wx:else>
    <view class="card-head">
      <text class="card-title">成员角色</text>
      <text class="card-tip" wx:if="{{canManage}}">仅族长可调整</text>
      <text class="card-tip" wx:else>只读</text>
    </view>
    <view class="card-filter-tip">仅展示当前用户与家族管理员，普通成员不在此列表显示</view>
    <view class="member-item" wx:for="{{members}}" wx:key="userId">
      <image wx:if="{{item.avatarFull}}" class="member-avatar-img" src="{{item.avatarFull}}" mode="aspectFill" />
      <view wx:else class="member-avatar">{{item.nickname[0]}}</view>
      <view class="member-info">
        <text class="member-name">{{item.nickname}}</text>
        <text class="member-role">{{item.roleLabel}}</text>
      </view>
      <view
        wx:if="{{canManage && item.role !== 'leader'}}"
        class="role-btn {{item.role === 'admin' ? 'role-btn-remove' : 'role-btn-add'}}"
        bindtap="toggleRole"
        data-user-id="{{item.userId}}"
        data-role="{{item.role}}"
      >
        {{item.role === 'admin' ? '取消管理员' : '设为管理员'}}
      </view>
      <view wx:else class="role-tag {{item.role === 'leader' ? 'role-leader' : (item.role === 'admin' ? 'role-admin' : '')}}">{{item.roleLabel}}</view>
    </view>
  </view>

  <!-- 权限说明 -->
  <view class="permission-desc">
    <text class="desc-title">权限说明</text>
    <text class="desc-item">族长：家族创建者本人，可管理成员角色，拥有家族最高权限</text>
    <text class="desc-item">管理员：协助族长管理家族事务，与家族基金等模块的管理员身份一致</text>
    <text class="desc-item">普通成员：可查看家族信息、发布动态、参与家族基金等</text>
  </view>
</view>
