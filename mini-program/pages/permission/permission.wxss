.page-container {
  padding: 24rpx;
  background: #F5F5F5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 家族头部 */
.family-header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #8B1A1A, #6B0F0F);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(139, 26, 26, 0.2);
}

.family-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.family-info {
  flex: 1;
}

.family-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  display: block;
  margin-bottom: 6rpx;
}

.family-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 成员卡片 */
.member-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.card-tip {
  font-size: 24rpx;
  color: #999;
}

.card-filter-tip {
  font-size: 22rpx;
  color: #B08D57;
  background: #FBF6EC;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 8rpx;
  line-height: 1.5;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #F0F0F0;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #6B0F0F);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.member-info {
  flex: 1;
  overflow: hidden;
}

.member-name {
  font-size: 30rpx;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.member-role {
  font-size: 24rpx;
  color: #999;
}

/* 角色按钮 */
.role-btn {
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}

.role-btn-add {
  background: rgba(139, 26, 26, 0.1);
  color: #8B1A1A;
}

.role-btn-remove {
  background: #FFF1F0;
  color: #E64340;
}

/* 角色标签 */
.role-tag {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: #F5F5F5;
  color: #666;
  flex-shrink: 0;
}

.role-leader {
  background: linear-gradient(135deg, #8B1A1A, #6B0F0F);
  color: #FFFFFF;
}

.role-admin {
  background: rgba(139, 26, 26, 0.1);
  color: #8B1A1A;
}

/* 权限说明 */
.permission-desc {
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.desc-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.desc-item {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  display: block;
}

/* 空态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 48rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  white-space: pre-line;
  line-height: 1.6;
}
