.page-container {
  padding: 24rpx;
  padding-bottom: 140rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

.form-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.form-section {
  padding: 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.form-section:last-child {
  border-bottom: none;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 32rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: #8B1A1A;
  border-radius: 3rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 16rpx;
}

.form-label.required::after {
  content: '*';
  color: #8B1A1A;
  margin-left: 8rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #F8F8F8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #F8F8F8;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

/* 性别选择 */
.gender-selector {
  display: flex;
  gap: 24rpx;
}

.gender-option {
  flex: 1;
  height: 100rpx;
  border-radius: 16rpx;
  background: #F8F8F8;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.gender-option.active {
  border-color: #8B1A1A;
  background: rgba(139, 26, 26, 0.05);
  color: #8B1A1A;
}

.gender-icon {
  font-size: 36rpx;
}

/* 选择器 */
.picker-value {
  height: 88rpx;
  line-height: 88rpx;
  background: #F8F8F8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
}

.relation-picker {
  height: 88rpx;
  line-height: 88rpx;
  background: #F8F8F8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  font-size: 32rpx;
  color: #CCC;
}

/* 头像上传 */
.avatar-uploader {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-upload-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #F8F8F8;
  border: 2rpx dashed #DDD;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-preview-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.avatar-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.avatar-action {
  font-size: 26rpx;
  color: #8B1A1A;
  padding: 8rpx 24rpx;
  border: 2rpx solid rgba(139, 26, 26, 0.3);
  border-radius: 28rpx;
}

.avatar-action-danger {
  color: #999;
  border-color: #DDD;
}

/* 照片上传 */
.photo-uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.upload-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #F8F8F8;
  border: 2rpx dashed #DDD;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 48rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 22rpx;
  color: #999;
}

.photo-preview {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo-preview image {
  width: 100%;
  height: 100%;
}

.photo-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

/* 底部按钮 */
.form-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.submit-btn::after {
  border: none;
}

/* 父母候选选择弹层 */
.picker-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}
.picker-panel {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  max-height: 70vh;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
}
.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.picker-close {
  font-size: 28rpx;
  color: #999;
  padding: 8rpx 16rpx;
}
.picker-search {
  padding: 20rpx 32rpx;
}
.picker-search-input {
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}
.picker-tip {
  margin: 0 32rpx 16rpx;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: #B8860B;
  background: #FDF6EC;
  border-radius: 8rpx;
  line-height: 1.5;
}
.picker-list {
  max-height: 50vh;
}
.picker-more {
  padding: 20rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}
.picker-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F7F7F7;
}
.picker-item:active {
  background: #F9F1F1;
}
.picker-item-main {
  display: flex;
  flex-direction: column;
}
.item-name {
  font-size: 30rpx;
  color: #333;
}
.item-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
.item-extra {
  font-size: 24rpx;
  color: #8B1A1A;
}
.picker-empty {
  padding: 60rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

/* 多配偶录入 */
.spouse-card {
  background: #FAFAFA;
  border: 1rpx solid #F0F0F0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

.spouse-card:first-of-type {
  margin-top: 8rpx;
}

/* 折叠态：虚线边框 + 浅色背景，与展开态形成视觉区分 */
.spouse-card.collapsed {
  background: #F5F5F5;
  border-style: dashed;
  border-color: #E0C9C9;
}

.spouse-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.spouse-card.collapsed .spouse-card-header {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.spouse-card-header:active {
  opacity: 0.7;
}

.spouse-card-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.spouse-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #8B1A1A;
  flex-shrink: 0;
}

.spouse-card-summary {
  font-size: 24rpx;
  color: #999;
  margin-left: 16rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
}

.spouse-card-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.spouse-collapse-btn {
  font-size: 24rpx;
  color: #8B1A1A;
  padding: 6rpx 20rpx;
  border: 1rpx solid rgba(139, 26, 26, 0.4);
  border-radius: 24rpx;
  margin-right: 16rpx;
}

.spouse-card.collapsed .spouse-collapse-btn {
  color: #8B1A1A;
  border-color: rgba(139, 26, 26, 0.4);
  background: rgba(139, 26, 26, 0.06);
  font-weight: 500;
}

.spouse-card-delete {
  font-size: 26rpx;
  color: #999;
  padding: 8rpx 20rpx;
  border: 1rpx solid #DDD;
  border-radius: 24rpx;
}

.spouse-row {
  margin-bottom: 24rpx;
}

.spouse-row:last-child {
  margin-bottom: 0;
}

.spouse-row-inline {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.spouse-row-inline .form-label {
  margin-bottom: 0;
}

.spouse-add-btn {
  margin-top: 24rpx;
  height: 88rpx;
  border: 2rpx dashed #C9A2A2;
  border-radius: 16rpx;
  color: #8B1A1A;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.spouse-add-btn:active {
  background: rgba(139, 26, 26, 0.04);
}

.spouse-add-icon {
  font-size: 32rpx;
  font-weight: 600;
}
