<view class="page-container">
  <view class="form-card">
    <view class="form-section">
      <view class="section-title">基本信息</view>

      <view class="form-group">
        <text class="form-label required">姓名</text>
        <input class="form-input" placeholder="请输入姓名" value="{{form.name}}" bindinput="inputChange" data-field="name" maxlength="50"/>
      </view>

      <view class="form-group">
        <text class="form-label">头像</text>
        <view class="avatar-uploader">
          <view class="avatar-upload-btn" bindtap="chooseAvatar">
            <image wx:if="{{form.avatar}}" src="{{form.avatar}}" mode="aspectFill" class="avatar-preview-img"/>
            <view wx:else class="avatar-placeholder">
              <text class="upload-icon">+</text>
              <text class="upload-text">上传头像</text>
            </view>
          </view>
          <view class="avatar-actions" wx:if="{{form.avatar}}">
            <text class="avatar-action" bindtap="chooseAvatar">更换</text>
            <text class="avatar-action avatar-action-danger" catchtap="removeAvatar">删除</text>
          </view>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label required">性别</text>
        <view class="gender-selector">
          <view class="gender-option {{form.gender === 'male' ? 'active' : ''}}" bindtap="selectGender" data-gender="male">
            <text class="gender-icon">👨</text>
            <text>男</text>
          </view>
          <view class="gender-option {{form.gender === 'female' ? 'active' : ''}}" bindtap="selectGender" data-gender="female">
            <text class="gender-icon">👩</text>
            <text>女</text>
          </view>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">代数/辈分</text>
        <input class="form-input" type="number" placeholder="如：2（第2代）" value="{{form.generation}}" bindinput="generationInput"/>
        <text class="form-tip">正整数，第2代及以上需选择父亲</text>
      </view>

      <view class="form-group">
        <text class="form-label">出生日期</text>
        <picker mode="date" value="{{form.birthDate}}" bindchange="dateChange" data-field="birthDate">
          <view class="picker-value">{{form.birthDate || '请选择出生日期'}}</view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">居住地</text>
        <input class="form-input" placeholder="请输入居住地" value="{{form.birthPlace}}" bindinput="inputChange" data-field="birthPlace" maxlength="200"/>
      </view>

      <view class="form-group">
        <text class="form-label">字辈</text>
        <input class="form-input" placeholder="请输入字辈，如：德" value="{{form.generationName}}" bindinput="inputChange" data-field="generationName" maxlength="10"/>
        <text class="form-tip">1-10个中文汉字，可为空</text>
      </view>

      <view class="form-group">
        <text class="form-label">是否在世</text>
        <switch checked="{{form.isAlive}}" bindchange="toggleAlive" color="#8B1A1A"/>
      </view>

      <view class="form-group" wx:if="{{!form.isAlive}}">
        <text class="form-label">逝世日期</text>
        <picker mode="date" value="{{form.deathDate}}" bindchange="dateChange" data-field="deathDate">
          <view class="picker-value">{{form.deathDate || '请选择逝世日期'}}</view>
        </picker>
      </view>

      <view class="form-group" wx:if="{{!form.isAlive}}">
        <text class="form-label">安葬地点</text>
        <input class="form-input" placeholder="请输入安葬地点" value="{{form.deathPlace}}" bindinput="inputChange" data-field="deathPlace" maxlength="200"/>
      </view>

      <view class="form-group" wx:if="{{!form.isAlive}}">
        <text class="form-label">墓茔经度</text>
        <input class="form-input" type="digit" placeholder="如：116.407526" value="{{form.longitude}}" bindinput="inputChange" data-field="longitude"/>
      </view>

      <view class="form-group" wx:if="{{!form.isAlive}}">
        <text class="form-label">墓茔纬度</text>
        <input class="form-input" type="digit" placeholder="如：39.90403" value="{{form.latitude}}" bindinput="inputChange" data-field="latitude"/>
      </view>
    </view>

    <view class="form-section">
      <view class="section-title">家庭关系</view>

      <view class="form-group" wx:if="{{form.generation >= 2}}">
        <text class="form-label">父亲</text>
        <view class="relation-picker" bindtap="selectParent" data-type="father">
          <text>{{form.fatherName || '请选择父亲'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </view>

      <view class="form-group" wx:if="{{form.generation >= 2 && form.fatherId}}">
        <text class="form-label">母亲</text>
        <view class="relation-picker" bindtap="selectParent" data-type="mother">
          <text>{{form.motherName || '请选择母亲'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">配偶信息</text>
        <text class="form-tip">支持添加多位配偶；仅去世的配偶可填写墓茔信息</text>

        <view class="spouse-card {{item.collapsed ? 'collapsed' : ''}}" wx:for="{{form.spouseList}}" wx:key="index">
          <view class="spouse-card-header" bindtap="toggleSpouseCollapse" data-index="{{index}}">
            <view class="spouse-card-left">
              <text class="spouse-card-title">配偶 {{index + 1}}</text>
              <text class="spouse-card-summary" wx:if="{{item.collapsed}}">{{item.name ? item.name + '（已收起）' : '未填写姓名（已收起）'}}</text>
            </view>
            <view class="spouse-card-actions">
              <text class="spouse-collapse-btn">{{item.collapsed ? '展开' : '收起'}}</text>
              <text class="spouse-card-delete" catchtap="removeSpouse" data-index="{{index}}">删除</text>
            </view>
          </view>

          <view class="spouse-card-body" wx:if="{{!item.collapsed}}">
            <view class="spouse-row">
              <text class="form-label">姓名</text>
              <input class="form-input" placeholder="请输入配偶姓名" value="{{item.name}}" bindinput="spouseInputChange" data-index="{{index}}" data-field="name" maxlength="50"/>
            </view>

            <view class="spouse-row">
              <text class="form-label">出生日期</text>
              <picker mode="date" value="{{item.birthDate}}" bindchange="spouseDateChange" data-index="{{index}}" data-field="birthDate">
                <view class="picker-value">{{item.birthDate || '请选择出生日期'}}</view>
              </picker>
            </view>

            <view class="spouse-row spouse-row-inline">
              <text class="form-label">是否在世</text>
              <switch checked="{{item.isAlive === 1}}" bindchange="spouseToggleAlive" data-index="{{index}}" color="#8B1A1A"/>
            </view>

            <view class="spouse-row" wx:if="{{item.isAlive === 0}}">
              <text class="form-label">逝世日期</text>
              <picker mode="date" value="{{item.deathDate}}" bindchange="spouseDateChange" data-index="{{index}}" data-field="deathDate">
                <view class="picker-value">{{item.deathDate || '请选择逝世日期'}}</view>
              </picker>
            </view>

            <view class="spouse-row" wx:if="{{item.isAlive === 0}}">
              <text class="form-label">安葬地点</text>
              <input class="form-input" placeholder="请输入安葬地点" value="{{item.deathPlace}}" bindinput="spouseInputChange" data-index="{{index}}" data-field="deathPlace" maxlength="200"/>
            </view>

            <view class="spouse-row" wx:if="{{item.isAlive === 0}}">
              <text class="form-label">墓茔经度</text>
              <input class="form-input" type="digit" placeholder="如：116.407526" value="{{item.longitude}}" bindinput="spouseInputChange" data-index="{{index}}" data-field="longitude"/>
            </view>

            <view class="spouse-row" wx:if="{{item.isAlive === 0}}">
              <text class="form-label">墓茔纬度</text>
              <input class="form-input" type="digit" placeholder="如：39.90403" value="{{item.latitude}}" bindinput="spouseInputChange" data-index="{{index}}" data-field="latitude"/>
            </view>

            <view class="spouse-row">
              <text class="form-label">简介</text>
              <textarea class="form-textarea" placeholder="请输入配偶简介" value="{{item.bio}}" bindinput="spouseInputChange" data-index="{{index}}" data-field="bio"/>
            </view>
          </view>
        </view>

        <view class="spouse-add-btn" bindtap="addSpouse">
          <text class="spouse-add-icon">+</text>
          <text>添加配偶</text>
        </view>
      </view>
    </view>

    <view class="form-section">
      <view class="section-title">其他信息</view>

      <view class="form-group">
        <text class="form-label">个人简介</text>
        <textarea class="form-textarea" placeholder="请输入个人简介" value="{{form.bio}}" bindinput="inputChange" data-field="bio"/>
      </view>

      <view class="form-group">
        <text class="form-label">上传照片</text>
        <view class="photo-uploader">
          <view class="photo-preview" wx:for="{{form.photos}}" wx:key="*this">
            <image src="{{item}}" mode="aspectFill"/>
            <view class="photo-delete" bindtap="deletePhoto" data-index="{{index}}">×</view>
          </view>
          <view class="upload-btn" wx:if="{{form.photos.length < 9}}" bindtap="choosePhoto">
            <text class="upload-icon">+</text>
            <text class="upload-text">添加照片</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="form-footer safe-bottom">
    <button class="submit-btn" bindtap="submitForm">{{isEdit ? '保存修改' : '添加成员'}}</button>
  </view>

  <!-- 父亲/母亲候选选择弹层 -->
  <view class="picker-mask" wx:if="{{showParentPicker}}" bindtap="closeParentPicker"></view>
  <view class="picker-panel" wx:if="{{showParentPicker}}">
    <view class="picker-header">
      <text class="picker-title">{{parentPickerType === 'father' ? '选择父亲' : '选择母亲'}}</text>
      <text class="picker-close" bindtap="closeParentPicker">关闭</text>
    </view>
    <view class="picker-search" wx:if="{{parentPickerType === 'father'}}">
      <input class="picker-search-input" placeholder="输入姓名或母亲姓名搜索" value="{{parentKeyword}}" bindinput="parentKeywordInput"/>
    </view>
    <view class="picker-tip" wx:if="{{parentDuplicateTip}}">{{parentDuplicateTip}}</view>
    <scroll-view scroll-y class="picker-list" bindscrolltolower="onParentScrollLower" lower-threshold="80">
      <view class="picker-item" wx:for="{{parentCandidates}}" wx:key="index" bindtap="pickParent" data-index="{{index}}">
        <view class="picker-item-main">
          <text class="item-name">{{item.name}}</text>
          <text class="item-sub" wx:if="{{item.sub}}">{{item.sub}}</text>
        </view>
        <text class="item-extra" wx:if="{{item.extra}}">{{item.extra}}</text>
      </view>
      <view class="picker-more" wx:if="{{parentLoading}}">加载中…</view>
      <view class="picker-more" wx:if="{{!parentLoading && !parentHasMore && parentCandidates.length}}">已加载全部</view>
      <view class="picker-empty" wx:if="{{!parentCandidates.length && !parentLoading}}">
        <text>{{parentPickerType === 'father' ? '未找到候选父亲，请检查代数或输入关键字搜索' : '该父亲暂无配偶记录，可在下方手动填写配偶信息'}}</text>
      </view>
    </scroll-view>
  </view>
</view>