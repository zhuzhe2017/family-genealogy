<wxs src="../../utils/filters.wxs" module="f" />
<view class="page-container">
  <!-- 自定义导航栏（左上角返回直接回首页） -->
  <view class="nav-bar" style="padding-top:{{statusBarHeight}}px;height:{{navBarTotal}}px;">
    <view class="nav-back" bindtap="goHome">
      <text class="nav-back-arrow">‹</text>
    </view>
    <text class="nav-title">家族成员</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 搜索和筛选 -->
  <view class="search-filter-bar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索成员姓名（至少2个字）" placeholder-class="placeholder"
             value="{{keyword}}" bindinput="onSearch" confirm-type="search" bindconfirm="doSearch"/>
      <text class="search-clear" wx:if="{{keyword}}" bindtap="clearSearch">✕</text>
    </view>
    <!-- 搜索键：输入 >=2 字符时显示，位于筛选键左侧 -->
    <view class="search-btn {{showSearchBtn ? 'show' : ''}}" bindtap="doSearch">
      <text>搜索</text>
    </view>
    <view class="filter-btn" bindtap="showFilter">
      <text>筛选</text>
      <text class="filter-dot" wx:if="{{filter.gender || filter.sort}}"></text>
    </view>
  </view>

  <!-- 字辈筛选标签:从首页字辈跳入时展示,点击可清除筛选回全部成员 -->
  <view class="gen-filter-tag" wx:if="{{generation > 0}}" bindtap="clearGenerationFilter">
    <text class="gen-filter-tag-text">{{navTitle || (generationName ? generationName + '字辈' : '第' + generation + '代')}}</text>
    <text class="gen-filter-tag-clear">✕ 清除筛选</text>
  </view>

  <!-- 统计信息 -->
  <view class="stats-bar">
    <view class="stat-pill">
      <text class="stat-num">{{totalMembers}}</text>
      <text class="stat-label">总人数</text>
    </view>
    <view class="stat-pill">
      <text class="stat-num">{{maleCount}}</text>
      <text class="stat-label">男性</text>
    </view>
    <view class="stat-pill">
      <text class="stat-num">{{femaleCount}}</text>
      <text class="stat-label">女性</text>
    </view>
  </view>

  <!-- 成员列表 -->
  <view class="member-list">
    <view class="member-group" wx:for="{{groupedMembers}}" wx:for-item="group" wx:key="generation">
      <view class="group-header">
        <text class="group-title">第{{group.generation}}代</text>
        <text class="group-count">{{group.members.length}}人</text>
      </view>
      <view class="group-members">
        <view class="member-card" wx:for="{{group.members}}" wx:for-item="member" wx:key="id" bindtap="viewMember" data-id="{{member.id}}">
          <view class="member-avatar {{member.gender === 'female' ? 'female' : ''}}">
            <text>{{f.firstChar(member.name)}}</text>
          </view>
          <view class="member-info">
            <view class="member-name-row">
              <text class="member-name">{{member.name}}</text>
              <text class="member-generation" wx:if="{{member.generationName}}">{{member.generationName}}字辈</text>
              <text class="member-gender">{{member.gender === 'female' ? '女' : '男'}}</text>
            </view>
            <text class="member-birth">{{member.birthYear || '未知'}}年生</text>
            <text class="member-spouse" wx:if="{{member.spouseNames}}">配偶：{{member.spouseNames}}</text>
          </view>
          <view class="member-actions">
            <text class="action-icon">›</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载/分页/错误/空态状态区 -->
  <view class="list-status" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>
  <view class="list-status" wx:if="{{loadingMore}}">
    <view class="loading-spinner small"></view>
    <text>加载中...</text>
  </view>
  <view class="list-status" wx:if="{{noMore}}">
    <text>— 已加载全部 {{totalMembers}} 位成员 —</text>
  </view>
  <view class="list-status error" wx:if="{{loadError}}">
    <text>加载失败，请检查网络</text>
    <view class="retry-btn" bindtap="retryLoad">点击重试</view>
  </view>
  <view class="list-empty" wx:if="{{!loading && !loadError && groupedMembers.length === 0}}">
    <text class="empty-icon">🔍</text>
    <text>未找到相关成员</text>
  </view>

  <!-- 添加按钮 -->
  <view class="fab-add" bindtap="addMember">
    <text>+</text>
  </view>
</view>