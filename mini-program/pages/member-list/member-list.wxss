.page-container {
  padding: 0 24rpx 120rpx;
  padding-top: 0;
  background: #F5F5F5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 字辈筛选标签:从首页字辈跳入时展示 */
.gen-filter-tag {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FDF6EC;
  border: 1rpx solid #E8D5B5;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
}

.gen-filter-tag-text {
  font-size: 26rpx;
  color: #8B1A1A;
  font-weight: 500;
}

.gen-filter-tag-clear {
  font-size: 22rpx;
  color: #999999;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  transition: color 0.2s, background-color 0.2s;
}

.gen-filter-tag-clear:active {
  color: #8B1A1A;
  background: rgba(139, 26, 26, 0.08);
}

/* 自定义导航栏 */
.nav-bar {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #8B1A1A, #6B0F0F);
  box-sizing: border-box;
  margin: 0 -24rpx;
  margin-bottom: 24rpx;
  z-index: 100;
}

.nav-back {
  width: 88rpx;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-back-arrow {
  font-size: 48rpx;
  color: #FFFFFF;
  line-height: 1;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  white-space: nowrap;
}

.nav-placeholder {
  width: 88rpx;
  flex-shrink: 0;
}

/* 搜索筛选栏 */
.search-filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  color: #999;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.filter-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 0 32rpx;
  font-size: 26rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

/* 统计栏 */
.stats-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-pill {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #8B1A1A;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

/* 成员列表 */
.member-group {
  margin-bottom: 24rpx;
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 8rpx;
  margin-bottom: 12rpx;
}

.group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  position: relative;
  padding-left: 20rpx;
}

.group-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 24rpx;
  background: #8B1A1A;
  border-radius: 3rpx;
}

.group-count {
  font-size: 24rpx;
  color: #999;
}

.group-members {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.member-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.member-avatar.female {
  background: linear-gradient(135deg, #FF6B9D, #FFB6C1);
}

.member-avatar text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: bold;
  font-family: 'KaiTi', serif;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.member-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-right: 16rpx;
}

.member-generation {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: rgba(139, 26, 26, 0.1);
  color: #8B1A1A;
  margin-right: 12rpx;
}

.member-gender {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #F5F5F5;
  color: #999;
}

.member-birth {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 4rpx;
}

.member-spouse {
  font-size: 22rpx;
  color: #999;
}

.member-actions {
  margin-left: 16rpx;
}

.action-icon {
  font-size: 36rpx;
  color: #CCC;
}

/* 浮动按钮 */
.fab-add {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 300;
  box-shadow: 0 8rpx 24rpx rgba(139, 26, 26, 0.3);
  z-index: 100;
}

/* 搜索清除按钮 */
.search-clear {
  font-size: 28rpx;
  color: #BBB;
  padding: 0 8rpx;
  flex-shrink: 0;
}

/* 搜索键：与筛选键视觉一致，条件显示时带过渡动画 */
.search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #8B1A1A;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(139, 26, 26, 0.2);
  opacity: 0;
  transform: scale(0.8);
  transition: opacity 0.2s ease, transform 0.2s ease;
  flex-shrink: 0;
}

.search-btn.show {
  opacity: 1;
  transform: scale(1);
}

/* 筛选激活小圆点 */
.filter-btn {
  position: relative;
}

.filter-dot {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #8B1A1A;
  border: 2rpx solid #FFFFFF;
}

/* 列表状态区（加载/分页/错误/空态） */
.list-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #999;
}

.list-status.error {
  color: #E6A23C;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(139, 26, 26, 0.15);
  border-top-color: #8B1A1A;
  border-radius: 50%;
  animation: list-spin 0.7s linear infinite;
  margin-bottom: 16rpx;
}

.loading-spinner.small {
  width: 36rpx;
  height: 36rpx;
  border-width: 3rpx;
  margin-bottom: 12rpx;
}

@keyframes list-spin {
  to {
    transform: rotate(360deg);
  }
}

.retry-btn {
  margin-top: 16rpx;
  padding: 12rpx 40rpx;
  border-radius: 32rpx;
  background: #8B1A1A;
  color: #FFFFFF;
  font-size: 26rpx;
}

/* 空态 */
.list-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 26rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}
