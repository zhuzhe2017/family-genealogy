<view class="container">
  <view class="form">
    <!-- 文件选择区 -->
    <view class="section">
      <text class="label">文档文件（PDF）</text>
      <view class="file-picker" bindtap="chooseFile">
        <block wx:if="{{file}}">
          <view class="file-chip">
            <text class="file-icon">📄</text>
            <view class="file-meta">
              <text class="file-name">{{file.name}}</text>
              <text class="file-size">{{file.sizeText}}</text>
            </view>
            <text class="file-remove" catchtap="removeFile">×</text>
          </view>
        </block>
        <view class="picker-placeholder" wx:else>
          <text class="picker-icon">＋</text>
          <text class="picker-text">从微信聊天选择</text>
        </view>
      </view>
      <text class="hint">仅支持 PDF，单文件不超过 5MB。可先把文件发到「文件传输助手」再选</text>
    </view>

    <!-- 文档信息 -->
    <view class="section">
      <text class="label">文档名称 *</text>
      <input class="input" placeholder="如：朱氏族谱·卷之三" value="{{name}}" bindinput="onNameInput" maxlength="50" />
    </view>

    <view class="section">
      <text class="label">分卷 / 册号</text>
      <input class="input" placeholder="选填，如：卷三 / 上册" value="{{volume}}" bindinput="onVolumeInput" maxlength="20" />
    </view>

    <view class="section">
      <text class="label">所属分类</text>
      <view class="category-select" bindtap="chooseCategory">
        <text class="{{selectedCategory ? 'category-text' : 'category-placeholder'}}">{{selectedCategoryName || '请选择分类'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="section">
      <text class="label">简介</text>
      <textarea class="textarea" placeholder="选填，简要描述文档内容" value="{{description}}" bindinput="onDescriptionInput" maxlength="300"></textarea>
    </view>

    <view class="section">
      <text class="label">页数</text>
      <input class="input" type="number" placeholder="选填，如：156" value="{{pageCount}}" bindinput="onPageCountInput" />
    </view>
  </view>

  <!-- 底部固定发布栏 -->
  <view class="submit-bar safe-bottom">
    <button class="submit-btn {{canSubmit ? '' : 'disabled'}}" bindtap="submit" disabled="{{!canSubmit}}">{{submitting ? '上传中...' : '上传'}}</button>
  </view>
</view>
