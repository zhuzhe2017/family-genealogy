<wxs src="../../utils/filters.wxs" module="f" />
<view class="page-container">
  <!-- 顶部沉浸区:广告轮播 + 家族信息 -->
  <view class="home-hero">
    <!-- 广告轮播:位于导航栏下沿 -->
    <view class="banner-section" wx:if="{{banners.length > 0}}">
      <swiper
        class="banner-swiper"
        autoplay="{{banners.length > 1}}"
        interval="{{bannerInterval}}"
        duration="500"
        circular="{{banners.length > 1}}"
        indicator-dots="{{false}}"
        bindchange="onBannerChange"
      >
        <swiper-item wx:for="{{banners}}" wx:key="id" data-type="{{item.linkType}}" data-url="{{item.linkUrl}}" data-id="{{item.id}}" bindtap="onBannerTap">
          <image class="banner-image" src="{{item.imageUrl}}" mode="aspectFill" lazy-load data-id="{{item.id}}" binderror="onBannerError" />
          <view class="banner-title" wx:if="{{item.title}}">{{item.title}}</view>
        </swiper-item>
      </swiper>
      <!-- 自定义指示器：避免与标题堆叠，样式更可控 -->
      <view class="banner-indicators" wx:if="{{banners.length > 1}}">
        <view wx:for="{{banners}}" wx:key="id" class="banner-dot {{bannerCurrent === index ? 'active' : ''}}" />
      </view>
    </view>

    <!-- 顶部家族信息卡片 -->
    <view class="family-header">
      <view class="family-bg">
        <view class="family-pattern"></view>
      </view>
      <view class="family-info">
        <!-- 家族信息:纯展示,不跳转家谱树 -->
        <view class="family-selector">
          <view class="family-logo">
            <text class="family-logo-text">{{f.firstChar(currentFamily.name)}}</text>
          </view>
          <view class="family-name-section">
            <text class="family-name">{{currentFamily.name}}</text>
            <text class="family-origin">{{currentFamily.origin}}</text>
            <text class="family-origin" wx:if="{{currentFamily.hallName}}">堂号：{{currentFamily.hallName}}</text>
            <!-- 字辈区域:按代展示,同代多字辈只显首字带+角标,点击+横向展开;点击区域弹窗查看完整字辈诗 -->
            <view class="generation-section" wx:if="{{generationGroups.length > 0}}" bindtap="openGenerationModal">
              <text class="generation-label">字辈</text>
              <view class="generation-content">
                <view class="generation-clamp">
                  <block wx:for="{{generationGroups}}" wx:key="generation" wx:for-item="group">
                    <!-- 展开态:横向展示该代全部字辈(hidden 控制,避免 wx:if/else 组件复用问题) -->
                    <view class="generation-char-group expanded" hidden="{{!group.expanded}}">
                      <text wx:for="{{group.chars}}" wx:for-item="c" wx:key="*this" class="generation-char">{{c}}</text>
                    </view>
                    <!-- 收起态:首字 + 多字辈角标 -->
                    <view class="generation-char-group" hidden="{{group.expanded}}">
                      <text class="generation-char">{{group.firstChar}}</text>
                      <text
                        wx:if="{{group.hasMore}}"
                        class="generation-plus"
                        data-generation="{{group.generation}}"
                        catchtap="toggleGenerationExpand"
                      >+</text>
                    </view>
                  </block>
                </view>
                <text class="generation-more" wx:if="{{generationClamped}}">……</text>
              </view>
            </view>
          </view>
        </view>

        <view class="family-stats">
          <view class="stat-item">
            <text class="stat-number">{{currentFamily.memberCount}}</text>
            <text class="stat-label">家族成员</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item">
            <text class="stat-number">{{currentFamily.generationCount}}</text>
            <text class="stat-label">传承代数</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item">
            <text class="stat-number">{{currentFamily.founder}}</text>
            <text class="stat-label">始祖</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 开发模式模拟数据角标 -->
  <view class="mock-banner" wx:if="{{isMock}}">当前为模拟数据,连接后端后展示真实内容</view>

  <!-- 快捷功能入口 -->
  <view class="quick-actions">
    <view class="action-grid">
      <view class="action-item" wx:for="{{quickActions}}" wx:key="id" bindtap="navigateTo" data-url="{{item.url}}">
        <view class="action-icon" style="background: {{item.bgColor}}">
          <text class="action-icon-text">{{item.icon}}</text>
        </view>
        <text class="action-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 最近动态 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">家族动态</text>
      <text class="section-more" bindtap="navigateTo" data-url="/pages/dynamic/dynamic">查看更多 ></text>
    </view>

    <!-- 加载中 -->
    <view class="home-state" wx:if="{{loadingDynamics}}">
      <text class="home-state-text">加载中...</text>
    </view>

    <!-- 未登录:引导登录,不展示假数据 -->
    <view class="home-state" wx:elif="{{needLogin}}">
      <text class="home-state-text">登录后可查看家族动态</text>
      <text class="home-state-btn" bindtap="doLogin">立即登录</text>
    </view>

    <!-- 加载失败:清空列表并提示重试 -->
    <view class="home-state" wx:elif="{{dynamicsFailed}}">
      <text class="home-state-text">加载失败,请稍后重试</text>
      <text class="home-state-btn" bindtap="loadDynamics">重新加载</text>
    </view>

    <!-- 空态:已登录但暂无动态 -->
    <view class="home-state" wx:elif="{{dynamicsEmpty}}">
      <text class="home-state-text">还没有动态</text>
    </view>

    <!-- 动态列表 -->
    <view class="dynamic-list" wx:elif="{{recentDynamics.length > 0}}">
      <view class="dynamic-item" wx:for="{{recentDynamics}}" wx:key="id" data-id="{{item.id}}" bindtap="goDynamicDetail">
        <view class="dynamic-avatar">
          <text>{{f.firstChar(item.userName)}}</text>
        </view>
        <view class="dynamic-content">
          <view class="dynamic-header">
            <text class="dynamic-user">{{item.userName}}</text>
            <text class="dynamic-time">{{item.time}}</text>
          </view>
          <text class="dynamic-text">{{item.content}}</text>
          <!-- 平铺模式:不超过3张直接展示 -->
          <view class="dynamic-images" wx:if="{{item.images.length > 0 && item.images.length <= 3}}">
            <image class="dynamic-img" wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" src="{{img}}" mode="aspectFill" data-srcs="{{item.images}}" data-current="{{img}}" catchtap="previewDynamicImage"/>
          </view>
          <!-- 滑动模式:超过3张时左右滑动浏览全部,右上角页码指示 -->
          <view class="dynamic-swiper-wrap" wx:elif="{{item.images.length > 3}}">
            <swiper class="dynamic-swiper" current="{{item.imageCurrent}}" data-id="{{item.id}}" bindchange="onImageSwiperChange">
              <swiper-item wx:for="{{item.imagePages}}" wx:for-item="page" wx:key="key">
                <view class="dynamic-images swiper-slide">
                  <image class="dynamic-img" wx:for="{{page.images}}" wx:for-item="img" wx:key="*this" src="{{img}}" mode="aspectFill" data-srcs="{{item.images}}" data-current="{{img}}" catchtap="previewDynamicImage"/>
                </view>
              </swiper-item>
            </swiper>
            <view class="image-indicator">{{item.imageCurrent + 1}}/{{item.imagePages.length}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 最近活动 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">最近活动</text>
      <text class="section-more" bindtap="goTimeline">查看更多 ></text>
    </view>
    <view class="activity-list" wx:if="{{recentActivities.length > 0}}">
      <view class="activity-item" wx:for="{{recentActivities}}" wx:key="id" data-id="{{item.id}}" bindtap="goEventDetail">
        <view class="activity-date">
          <text class="activity-day">{{item.day}}</text>
          <text class="activity-month">{{item.month}}</text>
        </view>
        <view class="activity-info">
          <text class="activity-title">{{item.title}}</text>
          <text class="activity-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
    <!-- 无真实数据源时显示空态,不展示假数据 -->
    <view class="home-state" wx:else>
      <text class="home-state-text">暂无活动记录</text>
    </view>
  </view>

  <!-- 慈善榜单（数据源：家族基金成功存入流水聚合） -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">慈善榜单</text>
      <text class="section-more" bindtap="navigateTo" data-url="/pages/fund/records?familyId={{currentFamily.id}}">查看更多 ></text>
    </view>

    <!-- 加载中 -->
    <view class="home-state" wx:if="{{loadingCharity}}">
      <text class="home-state-text">加载中...</text>
    </view>

    <!-- 加载失败:可重试 -->
    <view class="home-state" wx:elif="{{charityFailed}}">
      <text class="home-state-text">加载失败,请稍后重试</text>
      <text class="home-state-btn" bindtap="loadCharityRank">重新加载</text>
    </view>

    <!-- 空态:已登录但暂无捐赠记录 -->
    <view class="home-state" wx:elif="{{charityEmpty}}">
      <text class="home-state-text">暂无慈善捐赠数据</text>
    </view>

    <!-- 榜单列表 -->
    <view class="charity-list" wx:elif="{{charityRank.length > 0}}">
      <view class="charity-item" wx:for="{{charityRank}}" wx:key="rank">
        <view class="charity-rank {{item.rank <= 3 ? 'rank-' + item.rank : 'rank-other'}}">{{item.rank}}</view>
        <view class="charity-avatar">
          <text>{{f.firstChar(item.name)}}</text>
        </view>
        <view class="charity-info">
          <text class="charity-name">{{item.name}}</text>
          <text class="charity-project">{{item.project}}{{item.time ? ' · ' + item.time : ''}}</text>
        </view>
        <text class="charity-amount">¥{{item.amount}}</text>
      </view>
    </view>
  </view>
</view>

<!-- 字辈诗完整弹窗 -->
<view class="generation-modal" wx:if="{{generationModalVisible}}">
  <view class="generation-mask {{generationModalShow ? 'show' : ''}}" bindtap="closeGenerationModal"></view>
  <view class="generation-dialog {{generationModalShow ? 'show' : ''}}">
    <view class="generation-dialog-header">
      <text class="generation-dialog-title">家族字辈诗</text>
      <view class="generation-dialog-close" bindtap="closeGenerationModal">
        <text class="generation-dialog-close-icon">✕</text>
      </view>
    </view>
    <!-- 用普通 view + overflow-y 滚动,规避 scroll-view 原生组件层级高于 header 导致的重叠 -->
    <view class="generation-dialog-body">
      <view class="generation-poem">
        <block wx:for="{{generationList}}" wx:key="generation" wx:for-item="group">
          <!-- 同代多字辈:包一层分组容器,底色串联体现同代归属 -->
          <view class="generation-poem-group" wx:if="{{group.isGroup}}">
            <view
              wx:for="{{group.chars}}"
              wx:for-item="c"
              wx:key="name"
              class="generation-poem-char"
              data-generation="{{group.generation}}"
              data-name="{{c.name}}"
              bindtap="goGenerationMembers"
            >
              <text class="generation-poem-char-text">{{c.name}}</text>
            </view>
          </view>
          <!-- 单字辈:独立格子 -->
          <view
            wx:if="{{!group.isGroup && group.chars.length}}"
            class="generation-poem-char"
            data-generation="{{group.generation}}"
            data-name="{{group.chars[0].name}}"
            bindtap="goGenerationMembers"
          >
            <text class="generation-poem-char-text">{{group.chars[0].name}}</text>
          </view>
        </block>
      </view>
      <text class="generation-dialog-tip">点击字辈可查看该字辈家族成员</text>
    </view>
  </view>
</view>
