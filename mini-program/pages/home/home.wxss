.page-container {
  padding-bottom: 40rpx;
}

/* 顶部沉浸区:红色渐变贯穿状态栏→轮播→家族卡,底部圆角收尾 */
.home-hero {
  position: relative;
  background: linear-gradient(135deg, #8B1A1A 0%, #6B0F0F 100%);
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
}

/* 广告轮播:位于状态栏下沿,卡片悬浮于红色背景上 */
.banner-section {
  margin: 16rpx 0 0;
  position: relative;
  z-index: 2;
}

.banner-swiper {
  width: 750rpx;
  height: 300rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

swiper-item {
  position: relative;
}

.banner-image {
  width: 100%;
  height: 100%;
  display: block;
  background: #f0f0f0;
}

.banner-image-error {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 24rpx;
}

.banner-title {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 40rpx 20rpx 32rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.5), transparent);
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 自定义指示器:位于轮播底部,避免与标题重叠 */
.banner-indicators {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
  z-index: 3;
}

.banner-dot {
  width: 14rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, 0.4);
  transition: all 0.3s;
}

.banner-dot.active {
  width: 22rpx;
  background: #FFFFFF;
}

/* 家族头部:背景与圆角由 .home-hero 提供,这里只控制内边距与内容层级 */
.family-header {
  position: relative;
  padding: 24rpx 32rpx 60rpx;
}

.family-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0.1;
}

.family-pattern {
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  border: 60rpx solid rgba(255,255,255,0.1);
}

.family-info {
  position: relative;
  z-index: 1;
}

.family-selector {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.family-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  border: 2rpx solid rgba(255,255,255,0.3);
}

.family-logo-text {
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: bold;
  font-family: 'KaiTi', serif;
}

.family-name-section {
  flex: 1;
}

.family-name {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 600;
  display: block;
}

.family-origin {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 4rpx;
  display: block;
}

.family-generation-names {
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 8rpx;
  display: block;
  font-family: 'KaiTi', serif;
}

.switch-icon {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-left: 16rpx;
}

/* 统计数据 */
.family-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255,255,255,0.1);
  border-radius: 20rpx;
  padding: 24rpx 0;
  backdrop-filter: blur(10rpx);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-number {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.2);
}

/* 快捷入口 */
.quick-actions {
  margin: -30rpx 24rpx 24rpx;
  position: relative;
  z-index: 2;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}

.action-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.action-icon-text {
  font-size: 40rpx;
}

.action-name {
  font-size: 24rpx;
  color: #333;
}

/* 区块卡片 */
.section-card {
  margin: 0 24rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: #8B1A1A;
  border-radius: 3rpx;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

/* 动态列表 */
.dynamic-list {
  display: flex;
  flex-direction: column;
}

.dynamic-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.dynamic-item:last-child {
  border-bottom: none;
}

.dynamic-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.dynamic-avatar text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.dynamic-content {
  flex: 1;
  min-width: 0;
}

.dynamic-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.dynamic-user {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.dynamic-time {
  font-size: 22rpx;
  color: #999;
}

.dynamic-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.dynamic-images {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.dynamic-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
}

/* 图片滑动模式(超过3张) */
.dynamic-swiper-wrap {
  position: relative;
  margin-top: 12rpx;
}

.dynamic-swiper {
  height: 180rpx;
}

/* 每屏 3 张,图片固定宽度,不满一屏时居中 */
.swiper-slide {
  justify-content: center;
}

/* 页码指示器:右上角半透明角标 */
.image-indicator {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 1.4;
  z-index: 1;
}

/* 活动列表 */
.activity-list {
  display: flex;
  flex-direction: column;
}

.activity-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.activity-item:last-child {
  border-bottom: none;
}

.activity-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #F8F4F0;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-right: 24rpx;
  min-width: 100rpx;
}

.activity-day {
  font-size: 36rpx;
  font-weight: bold;
  color: #8B1A1A;
}

.activity-month {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.activity-info {
  flex: 1;
  padding-top: 8rpx;
}

.activity-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.activity-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
}

/* 名人横向滚动 */
.famous-scroll {
  width: 100%;
  white-space: nowrap;
}

.famous-list {
  display: flex;
  gap: 24rpx;
  padding: 8rpx 4rpx;
}

.famous-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 140rpx;
}

.famous-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D4A574, #C9A96E);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  border: 3rpx solid #F0E6D8;
}

.famous-avatar text {
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: bold;
  font-family: 'KaiTi', serif;
}

.famous-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.famous-title {
  font-size: 22rpx;
  color: #999;
}

/* 状态占位:加载/登录引导/失败/空态 */
.home-state {
  padding: 48rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.home-state-text {
  font-size: 24rpx;
  color: #999;
}

.home-state-btn {
  padding: 10rpx 40rpx;
  background: #8B1A1A;
  color: #FFFFFF;
  font-size: 24rpx;
  border-radius: 32rpx;
  line-height: 1.6;
}

/* 开发模式模拟数据角标 */
.mock-banner {
  margin: 0 24rpx 24rpx;
  padding: 12rpx 24rpx;
  background: #FFF7E6;
  color: #B25E09;
  font-size: 22rpx;
  border-radius: 12rpx;
  text-align: center;
}
