.page-container {
  padding-bottom: 40rpx;
}

/* 顶部沉浸区:红色渐变贯穿状态栏→轮播→家族卡,底部圆角收尾 */
.home-hero {
  position: relative;
  background: linear-gradient(135deg, #8B1A1A 0%, #6B0F0F 100%);
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
}

/* 广告轮播:位于状态栏下沿,卡片悬浮于红色背景上 */
.banner-section {
  margin: 16rpx 0 0;
  position: relative;
  z-index: 2;
}

.banner-swiper {
  width: 750rpx;
  height: 300rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

swiper-item {
  position: relative;
}

.banner-image {
  width: 100%;
  height: 100%;
  display: block;
  background: #f0f0f0;
}

.banner-image-error {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 24rpx;
}

.banner-title {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 40rpx 20rpx 32rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.5), transparent);
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 自定义指示器:位于轮播底部,避免与标题重叠 */
.banner-indicators {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
  z-index: 3;
}

.banner-dot {
  width: 14rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, 0.4);
  transition: all 0.3s;
}

.banner-dot.active {
  width: 22rpx;
  background: #FFFFFF;
}

/* 家族头部:背景与圆角由 .home-hero 提供,这里只控制内边距与内容层级 */
.family-header {
  position: relative;
  padding: 24rpx 32rpx 60rpx;
}

.family-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0.1;
}

.family-pattern {
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  border: 60rpx solid rgba(255,255,255,0.1);
}

.family-info {
  position: relative;
  z-index: 1;
}

.family-selector {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.family-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  border: 2rpx solid rgba(255,255,255,0.3);
}

.family-logo-text {
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: bold;
  font-family: 'KaiTi', serif;
}

.family-name-section {
  flex: 1;
}

.family-name {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 600;
  display: block;
}

.family-origin {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 4rpx;
  display: block;
}

/* 兼容旧引用,字辈展示已由 .generation-section 系列接管 */
.family-generation-names {
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 8rpx;
  display: block;
  font-family: 'KaiTi', serif;
}

/* 字辈区域:最多四行,超出省略号截断 */
.generation-section {
  display: flex;
  align-items: flex-start;
  margin-top: 10rpx;
  padding: 10rpx 0;
  border-radius: 12rpx;
  transition: opacity 0.2s;
}

.generation-section:active {
  opacity: 0.75;
}

.generation-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-right: 12rpx;
  line-height: 1.9;
  flex-shrink: 0;
  padding-top: 2rpx;
}

.generation-content {
  flex: 1;
  min-width: 0;
}

.generation-clamp {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 4rpx;
  /* 最多两行:行高26rpx*1.9≈49.4rpx,2行+1个行间距8rpx ≈ 107rpx,留1rpx余量 */
  max-height: 108rpx;
  overflow: hidden;
}

.generation-char {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  font-family: 'KaiTi', serif;
  line-height: 1.9;
  padding: 0 6rpx;
  border-radius: 8rpx;
  transition: background-color 0.2s, transform 0.2s;
}

/* 每一代的容器:横向排列该代字辈,组间用 margin 分隔 */
.generation-char-group {
  display: flex;
  align-items: center;
}

.generation-char-group.expanded {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 10rpx;
  padding: 0 8rpx;
  margin: 2rpx 0;
}

/* 多字辈 "+" 角标:提示该代还有其它字辈,点击横向展开 */
.generation-plus {
  font-size: 20rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.28);
  width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: 50%;
  margin-left: 4rpx;
  flex-shrink: 0;
  transition: transform 0.2s, background-color 0.2s;
}

.generation-plus:active {
  transform: scale(1.25);
  background: rgba(255, 255, 255, 0.45);
}

.generation-char:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.92);
}

.generation-more {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  font-family: 'KaiTi', serif;
  line-height: 1.9;
  letter-spacing: 2rpx;
}

/* 字辈诗弹窗 */
.generation-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.generation-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  opacity: 0;
  transition: opacity 0.28s ease;
}

.generation-mask.show {
  opacity: 1;
}

.generation-dialog {
  position: relative;
  width: 660rpx;
  max-width: 92vw;
  /* 弹窗高度增大:最高占屏幕 86%,内容区更多可视空间 */
  max-height: 86vh;
  background: #FFFFFF;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  opacity: 0;
  transform: scale(0.86) translateY(30rpx);
  transition: opacity 0.28s ease, transform 0.28s cubic-bezier(0.34, 1.4, 0.64, 1);
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.18);
}

.generation-dialog.show {
  opacity: 1;
  transform: scale(1) translateY(0);
}

.generation-dialog-header {
  position: relative;
  z-index: 2;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #F5F0E8;
}

.generation-dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  position: relative;
  padding-left: 20rpx;
}

.generation-dialog-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: #8B1A1A;
  border-radius: 3rpx;
}

.generation-dialog-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s, transform 0.2s;
}

.generation-dialog-close:active {
  background: #E8E8E8;
  transform: scale(0.9);
}

.generation-dialog-close-icon {
  font-size: 26rpx;
  color: #666666;
}

.generation-dialog-body {
  /* 固定高度 + overflow-y,内容超出垂直滚动;用普通 view 规避原生 scroll-view 层级问题 */
  position: relative;
  z-index: 1;
  height: 680rpx;
  max-height: 68vh;
  box-sizing: border-box;
  padding: 36rpx 32rpx;
  background: #FFFFFF;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.generation-poem {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  /* 用 margin 替代 gap,兼容旧基础库,避免换行错位 */
  margin: -10rpx -6rpx;
}

/* 同代多字辈分组:底色 + 圆角串联,视觉上归属同一代 */
.generation-poem-group {
  display: flex;
  align-items: center;
  background: rgba(139, 26, 26, 0.06);
  border-radius: 44rpx;
  margin: 10rpx 6rpx;
  padding: 0 4rpx;
}

.generation-poem-group .generation-poem-char {
  margin: 4rpx 2rpx;
  width: 72rpx;
  height: 72rpx;
}

.generation-poem-group .generation-poem-char-text {
  font-size: 34rpx;
}

/* 字辈圆:view 容器才能正常应用 flex 居中和固定宽高 */
.generation-poem-char {
  width: 88rpx;
  height: 88rpx;
  margin: 10rpx 6rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FDF6EC, #F8ECD4);
  border: 2rpx solid #E8D5B5;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
}

.generation-poem-char-text {
  font-size: 40rpx;
  color: #8B1A1A;
  font-family: 'KaiTi', serif;
  font-weight: 600;
  line-height: 1;
}

.generation-poem-char:active {
  transform: scale(0.9);
  background: linear-gradient(135deg, #8B1A1A, #A93226);
  box-shadow: 0 4rpx 16rpx rgba(139, 26, 26, 0.3);
}

.generation-poem-char:active .generation-poem-char-text {
  color: #FFFFFF;
}

.generation-dialog-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #999999;
  margin-top: 32rpx;
}

.switch-icon {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-left: 16rpx;
}

/* 统计数据 */
.family-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255,255,255,0.1);
  border-radius: 20rpx;
  padding: 24rpx 0;
  backdrop-filter: blur(10rpx);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-number {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.2);
}

/* 快捷功能入口 */
.quick-actions {
  margin: -30rpx 24rpx 24rpx;
  position: relative;
  z-index: 2;
}

.action-scroll {
  white-space: nowrap;
}

.action-grid {
  display: inline-flex;
  flex-wrap: wrap;
  width: 200%;
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: calc(25% - 12rpx);
  padding: 12rpx 0;
}

.action-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.action-icon-text {
  font-size: 40rpx;
}

.action-name {
  font-size: 24rpx;
  color: #333;
}

/* 区块卡片 */
.section-card {
  margin: 0 24rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: #8B1A1A;
  border-radius: 3rpx;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

/* 动态列表 */
.dynamic-list {
  display: flex;
  flex-direction: column;
}

.dynamic-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.dynamic-item:last-child {
  border-bottom: none;
}

.dynamic-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #B22222);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.dynamic-avatar text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.dynamic-content {
  flex: 1;
  min-width: 0;
}

.dynamic-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.dynamic-user {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.dynamic-time {
  font-size: 22rpx;
  color: #999;
}

.dynamic-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.dynamic-images {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.dynamic-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
}

/* 图片滑动模式(超过3张) */
.dynamic-swiper-wrap {
  position: relative;
  margin-top: 12rpx;
}

.dynamic-swiper {
  height: 180rpx;
}

/* 每屏 3 张,图片固定宽度,不满一屏时居中 */
.swiper-slide {
  justify-content: center;
}

/* 页码指示器:右上角半透明角标 */
.image-indicator {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 1.4;
  z-index: 1;
}

/* 活动列表 */
.activity-list {
  display: flex;
  flex-direction: column;
}

.activity-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.activity-item:last-child {
  border-bottom: none;
}

.activity-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #F8F4F0;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-right: 24rpx;
  min-width: 100rpx;
}

.activity-day {
  font-size: 36rpx;
  font-weight: bold;
  color: #8B1A1A;
}

.activity-month {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.activity-info {
  flex: 1;
  padding-top: 8rpx;
}

.activity-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.activity-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
}

/* 慈善榜单 */
.charity-list {
  display: flex;
  flex-direction: column;
  padding: 8rpx 4rpx;
}

.charity-item {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #F5F0E8;
}

/* 名次徽标:前三名金/银/铜色,其余灰色 */
.charity-rank {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 20rpx;
  background: #F0EBE3;
  color: #8C8578;
  flex-shrink: 0;
}

.charity-rank.rank-1 {
  background: linear-gradient(135deg, #F5D76E, #E8B430);
  color: #8B1A1A;
}

.charity-rank.rank-2 {
  background: linear-gradient(135deg, #D8D8D8, #B8B8B8);
  color: #5A5A5A;
}

.charity-rank.rank-3 {
  background: linear-gradient(135deg, #E8A87C, #C97B4A);
  color: #6B3A1A;
}

.charity-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8B1A1A, #A93226);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.charity-avatar text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.charity-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.charity-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.charity-project {
  font-size: 22rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.charity-amount {
  font-size: 30rpx;
  color: #8B1A1A;
  font-weight: bold;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 状态占位:加载/登录引导/失败/空态 */
.home-state {
  padding: 48rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.home-state-text {
  font-size: 24rpx;
  color: #999;
}

.home-state-btn {
  padding: 10rpx 40rpx;
  background: #8B1A1A;
  color: #FFFFFF;
  font-size: 24rpx;
  border-radius: 32rpx;
  line-height: 1.6;
}

/* 开发模式模拟数据角标 */
.mock-banner {
  margin: 0 24rpx 24rpx;
  padding: 12rpx 24rpx;
  background: #FFF7E6;
  color: #B25E09;
  font-size: 22rpx;
  border-radius: 12rpx;
  text-align: center;
}
