/* pages/audio-player/audio-player.wxss — 识典古籍暗色沉浸式（v1.1） */

page { background: var(--bg-dark); height: 100%; }

.player-wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, var(--bg-dark) 0%, #2a1f16 40%, var(--bg-dark) 100%);
}

/* ============ 合成蒙版 ============ */
.synthesizing-mask {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx;
  gap: 32rpx;
}
.synthesizing-spinner {
  width: 120rpx;
  height: 120rpx;
  border: 6rpx solid rgba(244, 234, 213, 0.2);
  border-top-color: var(--gold);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.synthesizing-text {
  color: var(--ink-on-dark);
  font-family: var(--font-kai);
  font-size: 32rpx;
  letter-spacing: 4rpx;
}
.synthesizing-hint {
  color: rgba(244, 234, 213, 0.5);
  font-size: 24rpx;
  text-align: center;
  font-family: var(--font-song);
}

/* ============ 主面板 ============ */
.player-panel {
  flex: 1;
  padding: 80rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 60rpx;
}

/* 封面 */
.cover-wrap {
  display: flex;
  align-items: center;
  gap: 32rpx;
}
.cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #2a1f16, #3a2820);
  border: 2rpx solid var(--gold);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cover-icon { font-size: 96rpx; filter: sepia(0.3); }
.info { flex: 1; }
.title {
  font-family: var(--font-kai);
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink-on-dark);
  letter-spacing: 4rpx;
  line-height: 1.4;
}
.sub {
  font-family: var(--font-song);
  font-size: 24rpx;
  color: var(--gold);
  opacity: 0.8;
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}

/* 进度条 */
.progress-wrap {
  padding-top: 40rpx;
}
.progress {
  width: 100%;
  margin: 0;
}
.time-label {
  display: flex;
  justify-content: space-between;
  font-family: var(--font-song);
  font-size: 24rpx;
  color: rgba(244, 234, 213, 0.6);
  margin-top: 12rpx;
  padding: 0 8rpx;
}

/* 播放按钮 — 印章朱 */
.controls {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}
.play-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--seal);
  border: 4rpx solid var(--gold);
  box-shadow: 0 16rpx 48rpx rgba(139, 26, 26, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s;
}
.play-btn:active { transform: scale(0.95); }
.play-btn.playing { background: var(--primary-dark); }
.play-icon {
  color: #fff;
  font-size: 72rpx;
  margin-left: 6rpx;
}

/* 倍速/定时 — 米黄纸风格 */
.rate-row, .timer-row {
  background: var(--paper);
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 1rpx solid var(--line);
}
.rate-label, .timer-label {
  font-family: var(--font-kai);
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 600;
  letter-spacing: 2rpx;
  width: 120rpx;
}
.rate-chips, .timer-chips {
  display: flex;
  gap: 12rpx;
  flex: 1;
  flex-wrap: wrap;
}
.rate-chip, .timer-chip {
  font-family: var(--font-song);
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  background: var(--paper-2);
  color: var(--ink-soft);
  border: 1rpx solid var(--line);
}
.rate-chip.active, .timer-chip.active {
  background: var(--seal);
  color: #fff;
  border-color: var(--seal);
}
.timer-active {
  font-family: var(--font-kai);
  font-size: 24rpx;
  color: var(--seal);
  font-weight: 600;
}
