/* pages/audio-player/audio-player.wxss */
page { background: #f4f1ec; height: 100%; }

.player-wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #8B1A1A 0%, #a83c3c 40%, #f4f1ec 60%);
}

/* ============ 合成蒙版 ============ */
.synthesizing-mask {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx;
  gap: 32rpx;
}
.synthesizing-spinner {
  width: 120rpx;
  height: 120rpx;
  border: 6rpx solid rgba(255,255,255,0.2);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.synthesizing-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
}
.synthesizing-hint {
  color: rgba(255,255,255,0.6);
  font-size: 24rpx;
  text-align: center;
}

/* ============ 主面板 ============ */
.player-panel {
  flex: 1;
  padding: 80rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 60rpx;
}

/* 封面 */
.cover-wrap {
  display: flex;
  align-items: center;
  gap: 32rpx;
}
.cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.cover-icon { font-size: 96rpx; }
.info { flex: 1; }
.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
  line-height: 1.4;
}
.sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 12rpx;
}

/* 进度条 */
.progress-wrap {
  padding-top: 40rpx;
}
.progress {
  width: 100%;
  margin: 0;
}
.time-label {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #666;
  margin-top: 12rpx;
  padding: 0 8rpx;
}

/* 播放按钮 */
.controls {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}
.play-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #8B1A1A;
  box-shadow: 0 16rpx 48rpx rgba(139,26,26,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s;
}
.play-btn:active { transform: scale(0.95); }
.play-btn.playing { background: #6b1212; }
.play-icon {
  color: #fff;
  font-size: 72rpx;
  margin-left: 6rpx; /* ▶ 视觉居中补偿 */
}

/* 倍速 */
.rate-row, .timer-row {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.rate-label, .timer-label {
  font-size: 26rpx;
  color: #8b7355;
  font-weight: 500;
  width: 120rpx;
}
.rate-chips, .timer-chips {
  display: flex;
  gap: 12rpx;
  flex: 1;
  flex-wrap: wrap;
}
.rate-chip, .timer-chip {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  background: #f5f1ea;
  color: #666;
}
.rate-chip.active, .timer-chip.active {
  background: #8B1A1A;
  color: #fff;
}
.timer-active {
  font-size: 24rpx;
  color: #8B1A1A;
}
