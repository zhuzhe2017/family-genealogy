# ============================================================
# 后端环境变量示例
# 复制为 .env 后,请将所有占位值替换为强随机值,切勿提交 .env 到版本库
# ============================================================

# 数据库配置
# 生产环境请使用独立业务账号（最小权限），勿用 root
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=family_genealogy
DB_USERNAME=family_app
# 请使用强密码(>=16 位,包含大小写字母/数字/符号)
DB_PASSWORD=please_replace_with_strong_app_password
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=60000

# 服务端口
PORT=3000

# 运行环境
NODE_ENV=development

# JWT 配置
# 请使用 openssl rand -base64 48 或 node -e "console.log(require('crypto').randomBytes(48).toString('base64'))" 生成
# 切勿使用示例值或可猜测字符串,缺失该变量会启动失败
JWT_SECRET=please_replace_with_random_48_byte_base64_string
JWT_EXPIRES_IN=7d

# CORS 允许来源,逗号分隔;生产环境必须配置为前端实际域名,禁止使用 *
# 本地开发管理后台默认运行在 http://localhost:9527
CORS_ORIGINS=http://localhost:9527

# 微信小程序配置(用于 /api/user/wx-login 接口)
# 开发环境留空即可,系统会使用 code 生成模拟 openid
# 生产环境请在微信公众平台获取 AppID 和 AppSecret
WX_APPID=
WX_SECRET=

# 短信服务配置(手机号验证码登录)
# SMS_PROVIDER=mock(默认,开发模式:控制台打印验证码,接口返回 devCode 便于联调)
# SMS_PROVIDER=aliyun / tencent 时需实现对应 SmsProvider 并填入密钥
SMS_PROVIDER=mock

# 微信支付配置(商户平台 https://pay.weixin.qq.com 获取)
# 未配置时订阅接口自动进入"模拟支付"模式,便于本地联调(数据真实落库)
WX_MCH_ID=
# 商户证书序列号(apiclient_cert.pem 中可查看)
WX_MCH_SERIAL_NO=
# 商户 API 私钥(apiclient_key.pem 的完整 PEM 内容,换行请使用 \n)
WX_MCH_PRIVATE_KEY=
# API v3 密钥(32 位字符串)
WX_PAY_API_V3_KEY=
# 支付回调地址(生产必须为公网 HTTPS,如 https://your-domain.com/api/subscription/pay/notify)
WX_PAY_NOTIFY_URL=

# 云存储配置加密密钥(用于 AES-256-GCM 加密 SecretKey 等敏感信息)
# 请使用 node -e "console.log(require('crypto').randomBytes(48).toString('base64'))" 生成强随机密钥
# 缺失或长度不足会导致保存云存储配置失败;生产环境请务必备份该密钥,丢失后无法解密已有配置
CLOUD_STORAGE_ENCRYPT_SECRET=please_replace_with_random_cloud_storage_encrypt_secret
