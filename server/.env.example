# ============================================================
# 后端环境变量示例
# 复制为 .env 后,请将所有占位值替换为强随机值,切勿提交 .env 到版本库
# ============================================================

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=family_genealogy
DB_USERNAME=root
# 请使用强密码(>=16 位,包含大小写字母/数字/符号)
DB_PASSWORD=please_replace_with_strong_password
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=60000

# 服务端口
PORT=3000

# 运行环境
NODE_ENV=development

# JWT 配置
# 请使用 openssl rand -base64 48 或 node -e "console.log(require('crypto').randomBytes(48).toString('base64'))" 生成
# 切勿使用示例值或可猜测字符串,缺失该变量会启动失败
JWT_SECRET=please_replace_with_random_48_byte_base64_string
JWT_EXPIRES_IN=7d

# CORS 允许来源,逗号分隔;生产环境必须配置为前端实际域名,禁止使用 *
# 本地开发管理后台默认运行在 http://localhost:9527
CORS_ORIGINS=http://localhost:9527

# 微信小程序配置(用于 /api/user/wx-login 接口)
# 开发环境留空即可,系统会使用 code 生成模拟 openid
# 生产环境请在微信公众平台获取 AppID 和 AppSecret
WX_APPID=
WX_SECRET=
