    "@types/node": "^22.0.0",
    "@types/react": "~18.3.12",
    "babel-preset-expo": "^12.0.0",
    "eas-cli": "^24.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
