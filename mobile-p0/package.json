{
  "name": "mobile-p0-tree-spike",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "description": "P0 验证：家谱树 Skia 渲染性能 Spike + 算法移植 + Node 层 benchmark",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "perf": "npx tsx benchmark/run.ts",
    "perf:spectrum": "npx tsx benchmark/scale-spectrum.ts",
    "typecheck": "tsc --noEmit"
  },
  "expo": {
    "name": "家谱树 Skia Spike",
    "slug": "family-tree-skia-spike",
    "version": "0.1.0",
    "orientation": "default",
