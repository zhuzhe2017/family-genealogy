# ============================================================
# 生产环境环境变量模板
# 复制为 .env 并填入真实值（切勿提交到版本库）
# 生成强随机密钥：
#   openssl rand -base64 48
#   或 node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# ============================================================

# ---- MySQL ----
# DB_ROOT_PASSWORD：MySQL root 密码，仅供宿主机管理/备份使用，应用不直连
# DB_USERNAME / DB_PASSWORD：后端应用使用的独立业务账号（最小权限，见 grant-app-user.sql）
DB_ROOT_PASSWORD=please_replace_with_strong_root_password
DB_PASSWORD=please_replace_with_strong_app_password
DB_DATABASE=family_genealogy
DB_USERNAME=family_app
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=60000

# ---- JWT ----
JWT_SECRET=please_replace_with_random_48_byte_base64_string
JWT_EXPIRES_IN=7d

# ---- CORS：生产环境必须为实际前端域名，逗号分隔，禁止 * ----
# docker-compose 中 web-admin 暴露 9527、tenant-web 暴露 9528
CORS_ORIGINS=https://admin.your-domain.com,https://tenant.your-domain.com

# ---- 微信小程序 ----
WX_APPID=
WX_SECRET=

# ---- 短信 ----
# SMS_PROVIDER=mock（开发模式，验证码打印到控制台并回显）
# SMS_PROVIDER=aliyun（阿里云短信，需配置以下 4 项）
# SMS_PROVIDER=tencent（腾讯云短信，需配置以下 5 项）
SMS_PROVIDER=aliyun

# 阿里云短信配置（SMS_PROVIDER=aliyun 时必填）
# 模板变量：${code}
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=

# 腾讯云短信配置（SMS_PROVIDER=tencent 时必填）
# 模板变量：{1}
SMS_TENCENT_SECRET_ID=
SMS_TENCENT_SECRET_KEY=
SMS_TENCENT_SDK_APP_ID=
SMS_TENCENT_SIGN_NAME=
SMS_TENCENT_TEMPLATE_ID=

# ---- 微信支付（生产必须真实配置；未配置时接口走模拟支付模式）----
# WX_MCH_PRIVATE_KEY：商户 API 证书私钥（PEM 格式，可含换行用 \n 转义）
# WX_PAY_NOTIFY_URL：必须为 https:// 开头公网可达地址，否则支付成功但无法激活订阅
WX_MCH_ID=
WX_MCH_SERIAL_NO=
WX_MCH_PRIVATE_KEY=
WX_PAY_API_V3_KEY=
WX_PAY_NOTIFY_URL=https://your-domain.com/api/subscription/pay/notify

# ---- 云存储配置加密密钥（AES-256-GCM，丢失后无法解密已有配置，务必备份）----
CLOUD_STORAGE_ENCRYPT_SECRET=please_replace_with_random_cloud_storage_encrypt_secret

# ---- 数据库备份（scripts/backup-db.sh / docker-compose.prod.yml backup 服务）----
# DB_NAME=family_genealogy
# RETENTION_DAYS=30
